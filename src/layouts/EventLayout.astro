---
import Layout from './Layout.astro';
import { useTranslations, getLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	date: Date;
	location: string;
	type: 'charla' | 'taller' | 'conferencia' | 'visita' | 'otro';
	image?: string;
	lang?: Lang;
}

const { title, description, date, location, type, image, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const typeConfig: Record<string, { icon: string; label: string }> = {
	charla: { icon: 'record_voice_over', label: t('type.charla') },
	taller: { icon: 'build', label: t('type.taller') },
	conferencia: { icon: 'groups', label: t('type.conferencia') },
	visita: { icon: 'location_away', label: t('type.visita') },
	otro: { icon: 'event', label: t('type.otro') },
};

const currentType = typeConfig[type] || typeConfig.otro;
const dateLocale = lang === 'es' ? 'es-ES' : 'en-US';
---

<Layout title={title} description={description} lang={lang}>
	<div class="event-container">
		<header class="event-header animate-in">
			<a href={getLocalePath(lang, 'events')} class="back-link">
				<span class="material-icons">west</span> {t('event.back')}
			</a>
			
			<div class="header-main">
				<div class="type-pill">
					<span class="material-icons">{currentType.icon}</span>
					<span>{currentType.label}</span>
				</div>
				<h1>{title}</h1>
			</div>

			<div class="event-hero glass animate-in" style="animation-delay: 0.1s">
				{image && <img src={image} alt={title} class="event-banner" />}
				<div class="quick-info">
					<div class="info-card">
						<span class="material-icons">event</span>
						<div class="details">
							<span class="label">{t('event.date')}</span>
							<span class="value">{date.toLocaleDateString(dateLocale, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
						</div>
					</div>
					<div class="info-card">
						<span class="material-icons">schedule</span>
						<div class="details">
							<span class="label">{t('event.time')}</span>
							<span class="value">{date.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit' })}</span>
						</div>
					</div>
					<div class="info-card">
						<span class="material-icons">place</span>
						<div class="details">
							<span class="label">{t('event.location')}</span>
							<span class="value">{location}</span>
						</div>
					</div>
				</div>
				<div class="youtube-broadcast-bar">
					<a href="https://www.youtube.com/@cbs-unmsm7189" target="_blank" rel="noopener noreferrer" class="btn-youtube">
						<span class="material-icons yt-icon">play_circle</span>
						<span>{lang === 'es' ? 'Ver Canal en YouTube' : 'Watch YouTube Channel'}</span>
						<span class="material-icons">open_in_new</span>
					</a>
				</div>
			</div>
		</header>

		<article class="event-description glass animate-in" style="animation-delay: 0.2s">
			<div class="section-title">
				<span class="material-icons">info</span>
				<h2>{t('event.about')}</h2>
			</div>
			<div class="entry-content">
				<slot />
			</div>
		</article>
	</div>
</Layout>

<style>
	.event-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 6rem 1.5rem;
	}

	.back-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.5;
		margin-bottom: 3rem;
		color: var(--text-color);
	}

	.back-link:hover {
		opacity: 1;
		color: var(--accent-cyan);
		transform: translateX(-5px);
	}

	.type-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(var(--accent-purple-rgb), 0.15);
		color: var(--accent-purple);
		padding: 0.4rem 1rem;
		border-radius: 100px;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(var(--accent-purple-rgb), 0.2);
	}

	h1 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		line-height: 1.1;
		font-weight: 800;
		margin-bottom: 3rem;
	}

	.event-hero {
		border-radius: 32px;
		overflow: hidden;
		margin-bottom: 4rem;
	}

	.event-banner {
		width: 100%;
		height: 350px;
		object-fit: cover;
		opacity: 0.6;
	}

	.quick-info {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		padding: 3rem;
	}

	.youtube-broadcast-bar {
		padding: 0 3rem 2.5rem;
		display: flex;
		justify-content: center;
	}
	.btn-youtube {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 2rem;
		border-radius: 50px;
		background: #ff0000;
		color: white;
		font-size: 0.8rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		box-shadow: 0 4px 20px rgba(255, 0, 0, 0.4);
		transition: all 0.3s ease;
	}
	.btn-youtube:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 30px rgba(255, 0, 0, 0.6);
		background: #cc0000;
	}
	.yt-icon {
		font-size: 1.4rem;
	}

	.info-card {
		display: flex;
		align-items: center;
		gap: 1.2rem;
	}

	.info-card .material-icons {
		font-size: 2.2rem;
		color: var(--accent-cyan);
		filter: drop-shadow(0 0 10px var(--accent-glow));
	}

	.details {
		display: flex;
		flex-direction: column;
	}

	.label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.5;
		font-weight: 700;
	}

	.value {
		font-size: 1.1rem;
		font-weight: 700;
	}

	.event-description {
		padding: 4rem;
		border-radius: 32px;
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 2.5rem;
		color: var(--accent-yellow);
	}

	.section-title h2 {
		margin-bottom: 0;
		font-size: 1.5rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.entry-content {
		font-size: 1.15rem;
		line-height: 1.8;
		opacity: 0.95;
	}

	.entry-content :global(h3) {
		color: var(--accent-cyan);
		margin: 2.5rem 0 1rem;
	}

	.entry-content :global(ul) {
		list-style: none;
		padding: 0;
		margin-bottom: 2rem;
	}

	.entry-content :global(li) {
		position: relative;
		padding-left: 1.8rem;
		margin-bottom: 1rem;
	}

	.entry-content :global(li::before) {
		content: '•';
		position: absolute;
		left: 0.2rem;
		color: var(--accent-cyan);
		font-size: 1.5rem;
		line-height: 1;
	}

	@media (max-width: 900px) {
		.event-description {
			padding: 2.5rem;
		}
	}
</style>
