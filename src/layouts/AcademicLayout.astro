---
import Layout from './Layout.astro';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	author: string;
	tags: string[];
}

const { title, description, pubDate, author, tags } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
	<div class="academic-container">
		<header class="academic-header animate-in">
			<a href={`${base}/articles`} class="back-link">
				<span class="material-icons">west</span> Volver al archivo
			</a>
			<div class="header-content">
				<div class="meta-tags">
					{tags.map(tag => <span class="tag">#{tag}</span>)}
				</div>
				<h1>{title}</h1>
				<div class="header-details">
					<p class="author">Por <span class="pinyon">{author}</span></p>
					<div class="divider-dot"></div>
					<time>{pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
				</div>
			</div>
		</header>

		<div class="academic-grid">
			<aside class="academic-sidebar animate-in" style="animation-delay: 0.1s">
				<div class="sidebar-block glass">
					<h3>Resumen Ejecutivo</h3>
					<p class="abstract">{description}</p>
				</div>
				
				<div class="sidebar-block glass">
					<h3>Metadatos</h3>
					<ul class="meta-list">
						<li>
							<span class="label">Publicado</span>
							<span class="value">{pubDate.toLocaleDateString('es-ES')}</span>
						</li>
						<li>
							<span class="label">Entidad</span>
							<span class="value">CBS-UNMSM</span>
						</li>
						<li>
							<span class="label">DOI</span>
							<span class="value">CBS.2026.ART.{(Math.random()*1000).toFixed(0)}</span>
						</li>
					</ul>
				</div>

				<div class="sidebar-block glass">
					<h3>Compartir</h3>
					<div class="share-links">
						<!-- Placeholder links -->
						<button class="share-btn"><span class="material-icons">link</span></button>
						<button class="share-btn"><span class="material-icons">share</span></button>
					</div>
				</div>
			</aside>

			<article class="academic-body glass animate-in" style="animation-delay: 0.2s">
				<slot />
				
				<footer class="article-footer">
					<div class="citation">
						<h4>Citar este artículo:</h4>
						<p>{author} ({pubDate.getFullYear()}). "{title}". <em>Hub de Divulgación CBS-UNMSM</em>.</p>
					</div>
				</footer>
			</article>
		</div>
	</div>
</Layout>

<style>
	.academic-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 6rem 2rem;
	}

	.academic-header {
		margin-bottom: 4rem;
	}

	.back-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.5;
		transition: all 0.3s;
		margin-bottom: 2.5rem;
		color: var(--text-color);
		text-decoration: none;
	}

	.back-link:hover {
		opacity: 1;
		transform: translateX(-5px);
		color: var(--accent-cyan);
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.05;
		font-weight: 800;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02e m;
	}

	.header-details {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-size: 1.1rem;
		opacity: 0.8;
	}

	.author .pinyon {
		font-family: 'Pinyon Script', cursive;
		font-size: 1.6rem;
		color: var(--accent-yellow);
		margin-left: 0.3rem;
	}

	.divider-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent-cyan);
	}

	.meta-tags {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.tag {
		font-size: 0.7rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent-cyan);
		background: rgba(var(--accent-cyan-rgb), 0.1);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
	}

	.academic-grid {
		display: grid;
		grid-template-columns: 350px 1fr;
		gap: 3rem;
		align-items: start;
	}

	.academic-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		position: sticky;
		top: 2rem;
	}

	.sidebar-block {
		padding: 2rem;
		border-radius: 20px;
	}

	.sidebar-block h3 {
		font-size: 0.75rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		margin-bottom: 1.2rem;
		color: var(--accent-cyan);
		opacity: 0.8;
	}

	.abstract {
		font-size: 0.95rem;
		line-height: 1.6;
		font-style: italic;
		color: var(--text-color);
		opacity: 0.9;
	}

	.meta-list {
		list-style: none;
		padding: 0;
	}

	.meta-list li {
		display: flex;
		justify-content: space-between;
		padding: 0.8rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		font-size: 0.85rem;
	}

	.meta-list li:last-child {
		border-bottom: none;
	}

	.label {
		opacity: 0.5;
		font-weight: 600;
	}

	.value {
		font-weight: 700;
	}

	.share-links {
		display: flex;
		gap: 1rem;
	}

	.share-btn {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--text-color);
		padding: 0.6rem;
		border-radius: 10px;
		cursor: pointer;
		transition: all 0.3s;
	}

	.share-btn:hover {
		background: rgba(var(--accent-cyan-rgb), 0.1);
		border-color: var(--accent-cyan);
		color: var(--accent-cyan);
	}

	.academic-body {
		padding: 4rem;
		border-radius: 24px;
		font-size: 1.2rem;
		line-height: 1.8;
		color: var(--text-color);
		max-width: 850px;
	}

	.academic-body :global(h2) {
		font-size: 2rem;
		margin: 3rem 0 1.5rem;
		color: var(--accent-yellow);
	}

	.academic-body :global(h3) {
		font-size: 1.5rem;
		margin: 2rem 0 1rem;
		color: var(--accent-cyan);
	}

	.academic-body :global(p) {
		margin-bottom: 1.8rem;
		opacity: 0.9;
	}

	.academic-body :global(strong) {
		color: var(--accent-cyan);
		font-weight: 700;
	}

	.article-footer {
		margin-top: 5rem;
		padding-top: 3rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.citation h4 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
		opacity: 0.5;
	}

	.citation p {
		font-size: 0.95rem;
		font-style: italic;
		opacity: 0.7;
		padding: 1.5rem;
		background: rgba(0, 0, 0, 0.2);
		border-radius: 12px;
	}

	@media (max-width: 1024px) {
		.academic-grid {
			grid-template-columns: 1fr;
		}
		.academic-sidebar {
			order: 2;
			position: static;
		}
		.academic-body {
			order: 1;
			padding: 2.5rem;
		}
	}

	@media (max-width: 768px) {
		.academic-container {
			padding: 4rem 1.5rem;
		}
		h1 {
			font-size: 2.5rem;
		}
		.header-details {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
		.divider-dot {
			display: none;
		}
	}
</style>
