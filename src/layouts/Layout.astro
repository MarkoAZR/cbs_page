---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import LanguageSwitcher from '../components/common/LanguageSwitcher.astro';
import BottomNav from '../components/common/BottomNav.astro';
import { useTranslations, getAlternateLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lang?: Lang;
}

const { title, description = "Grupo de Divulgación Científica - Avances y Eventos", lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const esPath = getAlternateLocalePath(Astro.url, 'es');
const enPath = getAlternateLocalePath(Astro.url, 'en');
const cleanBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteBase = import.meta.env.SITE + cleanBase;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={`${cleanBase}/cbs_logo.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | CBS-UNMSM</title>
		<meta name="description" content={description} />
		
		<!-- OpenGraph -->
		<meta property="og:title" content={`${title} | CBS-UNMSM`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={`${siteBase}/cbs_logo.png`} />
		<meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | CBS-UNMSM`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteBase}/cbs_logo.png`} />

		<!-- Hreflang for SEO -->
		<link rel="alternate" hreflang="es" href={`${import.meta.env.SITE}${esPath}`} />
		<link rel="alternate" hreflang="en" href={`${import.meta.env.SITE}${enPath}`} />
		<link rel="alternate" hreflang="x-default" href={`${import.meta.env.SITE}${esPath}`} />

		<!-- Schema.org Structured Data -->
		<script type="application/ld+json" is:inline>
		{
		  "@context": "https://schema.org",
		  "@type": "EducationalOrganization",
		  "name": "CBS-UNMSM",
		  "alternateName": "Comunidad de Biología Sintética UNMSM",
		  "url": "https://cbsunmsm.site",
		  "logo": "https://cbsunmsm.site/cbs_logo.png",
		  "sameAs": [
		    "https://www.youtube.com/@cbs-unmsm7189",
		    "https://luma.com/cbs-unmsm",
		    "https://chat.whatsapp.com/CEd3BXnUV879xKuM0MuoXE"
		  ],
		  "parentOrganization": {
		    "@type": "CollegeOrUniversity",
		    "name": "Universidad Nacional Mayor de San Marcos"
		  }
		}
		</script>

		<!-- Script de Bloqueo: Tema Inteligente -->
		<script is:inline>
			(function() {
				const applyTheme = () => {
					const getTheme = () => {
						const stored = localStorage.getItem('theme');
						if (stored) return stored;
						const hour = new Date().getHours();
						if (hour >= 19 || hour < 4) return 'dark';
						return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					};

					const theme = getTheme();
					if (theme === 'dark') {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
					localStorage.setItem('theme', theme);
				};

				applyTheme();
				document.addEventListener('astro:after-swap', applyTheme);
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&display=swap" rel="stylesheet" />
		<ClientRouter />
	</head>
	<body>
		<div class="top-actions">
			<LanguageSwitcher lang={lang} />
			<ThemeToggle />
		</div>
		<main>
			<slot />
		</main>
		<BottomNav lang={lang} />
		<footer class="main-footer">
			<div class="container footer-content">
				<div class="footer-left">
					<div class="footer-socials">
						<a href="#" class="social-icon" aria-label="Facebook">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z"/></svg>
						</a>
						<a href="#" class="social-icon" aria-label="Instagram">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2c2.717 0 3.056.01 4.122.058 1.066.048 1.79.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.637.417 1.361.465 2.427.048 1.066.058 1.305.058 4.122s-.01 3.056-.058 4.122c-.048 1.066-.217 1.79-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.637.247-1.361.417-2.427.465-1.066.048-1.305.058-4.122.058s-3.056-.01-4.122-.058c-1.066-.048-1.79-.217-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.637-.417-1.361-.465-2.427C2.01 15.056 2 14.717 2 12s.01-3.056.058-4.122c.048-1.066.218-1.79.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.523c.637-.247 1.361-.417 2.427-.465C8.944 2.01 9.283 2 12 2zm0 5a5 5 0 100 10 5 5 0 000-10zm6.5-.25a1.25 1.25 0 00-2.5 0 1.25 1.25 0 002.5 0zM12 9a3 3 0 110 6 3 3 0 010-6z"/></svg>
						</a>
						<a href="#" class="social-icon" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22.23 0H1.77C.8 0 0 .77 0 1.72v20.56C0 23.23.8 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0zM7.12 20.45H3.56V9h3.56v11.45zM5.34 7.43a2.06 2.06 0 110-4.11 2.06 2.06 0 010 4.11zm15.11 13.02h-3.56v-5.6c0-1.33-.03-3.05-1.85-3.05-1.85 0-2.14 1.45-2.14 2.95v5.7h-3.56V9h3.42v1.56h.05c.47-.9 1.63-1.84 3.36-1.84 3.59 0 4.26 2.36 4.26 5.44v6.29z"/></svg>
						</a>
						<a href="#" class="social-icon" aria-label="YouTube">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505a3.017 3.017 0 00-2.122 2.136C0 8.055 0 12 0 12s0 3.945.501 5.814a3.017 3.017 0 002.122 2.136c1.871.505 9.377.505 9.377.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.945 24 12 24 12s0-3.945-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
						</a>
					</div>
					<p class="footer-description">
						{t('footer.description')}
					</p>
					<p class="copyright">&copy; {new Date().getFullYear()} {t('footer.copyright')}</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	.top-actions {
		position: fixed;
		top: 2rem;
		right: 2rem;
		z-index: 1100;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	@media (max-width: 600px) {
		.top-actions {
			top: 1.5rem;
			right: 1.5rem;
			gap: 0.75rem;
		}
	}

	.main-footer {
		margin-top: 8rem;
		padding: 4rem 0 8rem;
		border-top: 1px solid var(--border-color);
		background: rgba(3, 3, 8, 0.5);
	}

	.footer-content {
		display: flex;
		justify-content: flex-start;
		align-items: center;
	}

	.footer-left {
		max-width: 500px;
	}

	.footer-socials {
		display: flex;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.social-icon {
		opacity: 0.5;
		transition: all 0.3s;
		color: var(--text-color);
	}

	.social-icon:hover {
		opacity: 1;
		color: var(--accent-cyan);
		transform: translateY(-3px);
	}

	.footer-description {
		font-size: 0.95rem;
		line-height: 1.6;
		opacity: 0.7;
		margin-bottom: 1rem;
	}

	.copyright {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.4;
	}

	@media (max-width: 700px) {
		.footer-content {
			justify-content: center;
			text-align: center;
		}
		.footer-socials {
			justify-content: center;
		}
	}
</style>
