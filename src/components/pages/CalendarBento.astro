---
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const calendarData = [
	{
		id: 'feb',
		label: lang === 'es' ? 'Febrero' : 'February',
		monthNum: '02',
		featured: true,
		highlight: lang === 'es' ? '1ER LUGAR & MEDALLA DE ORO' : '1ST PLACE & GOLD MEDAL',
		events: [
			{ title: 'Synbio Bootcamp & Hackathon', desc: lang === 'es' ? '1er lugar y medalla de oro con el diseño del biosensor Yaku Pbubbles.' : '1st place and gold medal designing the Yaku Pbubbles biosensor.', date: lang === 'es' ? '15 de Febrero' : 'February 15', icon: 'emoji_events' }
		]
	},
	{
		id: 'mar',
		label: lang === 'es' ? 'Marzo' : 'March',
		monthNum: '03',
		featured: true,
		highlight: lang === 'es' ? 'SIMPOSIO INTERNACIONAL' : 'INT. SYMPOSIUM',
		events: [
			{ title: lang === 'es' ? 'I Simposio Internacional Virtual' : '1st Virtual International Symposium', desc: lang === 'es' ? 'Estructurado en 4 bloques de presentaciones con ponentes de +7 países.' : 'Structured into 4 presentation blocks with speakers from 7+ countries.', date: lang === 'es' ? '5–7 de Marzo' : 'March 5–7', icon: 'public' }
		],
		cta: { label: lang === 'es' ? 'Ver Simposio' : 'View Symposium', url: 'https://markoazr.github.io/symposium-cbs/es/' }
	},
	{
		id: 'apr',
		label: lang === 'es' ? 'Abril' : 'April',
		monthNum: '04',
		featured: false,
		events: [
			{ title: 'NexoBio & Taller Benchling', desc: lang === 'es' ? 'Participación activa con taller in silico sobre la plataforma Benchling.' : 'Active participation hosting an in silico Benchling workshop.', date: lang === 'es' ? '25 de Abril' : 'April 25', icon: 'terminal' }
		]
	},
	{
		id: 'may',
		label: lang === 'es' ? 'Mayo' : 'May',
		monthNum: '05',
		featured: false,
		events: [
			{ title: lang === 'es' ? 'IV Jornada en Biología Tumoral' : '4th Tumor Biology Conference', desc: lang === 'es' ? 'Apoyo organizacional como grupo aliado de OMICS en cáncer.' : 'Organizational support alongside OMICS for cancer research.', date: lang === 'es' ? '19–23 de Mayo' : 'May 19–23', icon: 'biotech' }
		]
	},
	{
		id: 'jun',
		label: lang === 'es' ? 'Junio' : 'June',
		monthNum: '06',
		featured: false,
		events: [
			{ title: 'Puentes Científicos: Dr. Nadra', desc: lang === 'es' ? 'Inauguración del ciclo con ponencia sobre biosensores whole cell.' : 'Cycle inauguration with keynote speech on whole-cell biosensors.', date: lang === 'es' ? '26 de Junio' : 'June 26', icon: 'sensors' }
		]
	},
	{
		id: 'jul',
		label: lang === 'es' ? 'Julio' : 'July',
		monthNum: '07',
		featured: false,
		events: [
			{ title: lang === 'es' ? 'Puentes Científicos: Dra. Merino' : 'Scientific Bridges: Dr. Merino', desc: lang === 'es' ? 'Ponencia N°2 sobre bioinformática de interacciones planta-patógeno.' : 'Keynote #2 on plant-pathogen bioinformatics.', date: lang === 'es' ? '31 de Julio' : 'July 31', icon: 'sensors' },
			{ title: lang === 'es' ? 'Conferencia Magistral: Dr. Gutiérrez' : 'Keynote Lecture: Dr. Gutiérrez', desc: lang === 'es' ? 'Conferencia magistral presencial sobre IA en biología de sistemas.' : 'In-person keynote lecture on AI in systems biology.', date: lang === 'es' ? '31 de Julio' : 'July 31', icon: 'smart_toy' }
		]
	},
	{
		id: 'aug',
		label: lang === 'es' ? 'Agosto' : 'August',
		monthNum: '08',
		featured: true,
		highlight: lang === 'es' ? 'GIRA ESCOLAR & TALLER' : 'SCHOOL TOUR & WORKSHOP',
		events: [
			{ title: lang === 'es' ? 'Taller de Biopartes de ADN' : 'DNA BioParts Workshop', desc: lang === 'es' ? 'Taller de difusión de resultados con respaldo logístico de CBS.' : 'Results workshop backed by CBS community logistics.', date: lang === 'es' ? '7 de Agosto' : 'August 7', icon: 'science' },
			{ title: lang === 'es' ? 'Puentes Científicos: IA en SynBio' : 'Scientific Bridges: AI in SynBio', desc: lang === 'es' ? 'Ponencia N°3 del ciclo Puentes Científicos: Inteligencia Artificial en Biología Sintética por el Dr. Martín E. Gutiérrez Pescarmona.' : 'Keynote #3 of the Scientific Bridges cycle: AI in Synthetic Biology by Dr. Martín E. Gutiérrez Pescarmona.', date: lang === 'es' ? '31 de Agosto' : 'August 31', icon: 'smart_toy' },
			{ title: lang === 'es' ? 'Ruta del Biodiseño: Ciencia y Tecnología para Escolares' : 'BioDesign Tour: Science & Tech for High Schools', desc: lang === 'es' ? 'Gira escolar por el proyecto Bootcamp y Hackathon BioDesign 2026, con talleres demostrativos e inscripción preferencial a los colegios visitados.' : 'High school outreach tour for the BioDesign 2026 Bootcamp & Hackathon, with demo workshops and preferential enrollment for visited schools.', date: lang === 'es' ? 'Agosto 2026' : 'August 2026', icon: 'school' }
		]
	},
	{
		id: 'sep',
		label: lang === 'es' ? 'Septiembre' : 'September',
		monthNum: '09',
		featured: true,
		highlight: lang === 'es' ? 'SIMPOSIO & BIOBOOST' : 'SYMPOSIUM & BIOBOOST',
		events: [
			{ title: lang === 'es' ? 'I Simposio "Recuperando el valor del agua" — UNALM' : '1st "Recovering Water Value" Symposium — UNALM', desc: lang === 'es' ? 'Taller de diseño de biosensores in silico para biorremediación y presentación de nuestro proyecto YakuPbubbles en la UNALM.' : 'In silico biosensor design workshop for bioremediation and YakuPbubbles project presentation at UNALM.', date: lang === 'es' ? 'Septiembre 2026' : 'September 2026', icon: 'water_drop' },
			{ title: 'BioBoost 2026', desc: lang === 'es' ? 'Potenciando competencias académicas, profesionales y digitales, combinando trabajo de laboratorio y habilidades blandas.' : 'Boosting academic, professional, and digital skills, combining wet lab training and soft skills.', date: lang === 'es' ? 'Septiembre 2026' : 'September 2026', icon: 'bolt' },
			{ title: lang === 'es' ? 'BioDesign: Inauguración Oficial' : 'BioDesign: Official Opening', desc: lang === 'es' ? 'Inauguración oficial presencial y primeras sesiones del bootcamp virtual.' : 'Official in-person opening and virtual bootcamp kickoff.', date: lang === 'es' ? '26 de Septiembre' : 'September 26', icon: 'biotech' }
		]
	},
	{
		id: 'oct',
		label: lang === 'es' ? 'Octubre' : 'October',
		monthNum: '10',
		featured: true,
		highlight: lang === 'es' ? 'FECHAS CENTRALES' : 'MAIN DATES',
		biodesignPortal: true,
		events: [
			{ title: 'Proyecto BioDesign 2026: Hackathon & Clausura', desc: lang === 'es' ? 'Kick-off informativo (9 Oct), Hackathon guiado 48h (10–11 Oct), calificación parcial y gran Pitch Final presencial con premiación (23 Oct).' : 'Informative kick-off (Oct 9), 48h guided Hackathon sprint (Oct 10–11), partial grading, and grand in-person Final Pitch with awards (Oct 23).', date: lang === 'es' ? '9 – 23 de Octubre' : 'October 9 – 23', icon: 'military_tech' }
		],
		cta: { label: t('biodesign.calendar.cta'), url: getLocalePath(lang, 'events/biodesign') }
	},
	{
		id: 'nov',
		label: lang === 'es' ? 'Noviembre' : 'November',
		monthNum: '11',
		featured: false,
		events: [
			{ title: 'Puentes Científicos: Sesión Noviembre', desc: lang === 'es' ? 'Conferencias magistrales de biología sintética y biotecnología. Mayor información por confirmar.' : 'International synthetic biology and biotech keynotes. Further details to be confirmed.', date: lang === 'es' ? 'Noviembre 2026' : 'November 2026', icon: 'psychology' }
		]
	},
	{
		id: 'dec',
		label: lang === 'es' ? 'Diciembre' : 'December',
		monthNum: '12',
		featured: false,
		events: [
			{ title: 'Puentes Científicos: Sesión Final & Cierre Anual', desc: lang === 'es' ? 'Clausura del ciclo anual de conferencias y balance de proyectos CBS. Por confirmar.' : 'Annual keynote cycle closing and yearly CBS projects recap. To be confirmed.', date: lang === 'es' ? 'Diciembre 2026' : 'December 2026', icon: 'celebration' }
		]
	}
];
---

<section class="calendar-section animate-in" style="animation-delay: 0.15s">
	<div class="calendar-header">
		<span class="hero-badge glass">{t('calendar.pretitle')}</span>
		<h2>{t('calendar.title')} <span class="gradient-text">{t('calendar.highlight')}</span></h2>
		<p>{t('calendar.subtitle')}</p>
	</div>

	<div class="calendar-grid">
		{calendarData.map(block => {
			const CardTag = block.biodesignPortal ? 'a' : 'div';
			const portalProps = block.biodesignPortal && block.cta ? {
				href: block.cta.url,
				'aria-label': block.cta.label,
			} : {};
			return (
				<CardTag 
					class={`cal-card glass-minimal ${block.featured ? 'featured' : ''} ${block.biodesignPortal ? 'biodesign-portal' : ''}`}
					{...portalProps}
				>
					{block.biodesignPortal && (
						<div class="hologram-container" aria-hidden="true">
							<div class="hologram-ring hologram-ring-1"></div>
							<div class="hologram-ring hologram-ring-2"></div>
							<div class="hologram-core">
								<div class="hologram-scanner"></div>
								<img src={`${base}/Biodesign/logo_biodesign_mm.png`} alt="BioDesign" class="hologram-logo" width="56" height="56" />
							</div>
						</div>
					)}
					{block.highlight && <span class={`cal-highlight ${block.biodesignPortal ? 'biodesign-highlight' : ''}`}>{block.highlight}</span>}
					<div class="cal-card-header">
						<span class="cal-num">{block.monthNum}</span>
						<h3 class="cal-month">{block.label}</h3>
					</div>
					<div class="cal-events">
						{block.events.map(ev => (
							<div class={`cal-event ${block.biodesignPortal ? 'biodesign-event' : ''}`}>
								<div class="cal-event-top">
									<span class="material-icons cal-event-icon">{ev.icon}</span>
									<div>
										<div class="cal-event-title">{ev.title}</div>
										<div class="cal-event-date">{ev.date}</div>
									</div>
								</div>
								<p class="cal-event-desc">{ev.desc}</p>
							</div>
						))}
					</div>
					{block.cta && !block.biodesignPortal && (
						<a 
							href={block.cta.url} 
							target={block.cta.url.startsWith('http') ? "_blank" : undefined} 
							rel={block.cta.url.startsWith('http') ? "noopener noreferrer" : undefined} 
							class="cal-cta"
						>
							{block.cta.label} <span class="material-icons cal-cta-arrow">arrow_forward</span>
						</a>
					)}
					{block.biodesignPortal && block.cta && (
						<span class="cal-cta biodesign-cta">
							{block.cta.label} <span class="material-icons cal-cta-arrow">arrow_forward</span>
						</span>
					)}
				</CardTag>
			);
		})}
	</div>
</section>

<style>
	.calendar-section {
		max-width: 1200px;
		margin: 0 auto 6rem;
		padding: 0 2rem;
	}
	.calendar-header {
		text-align: center;
		margin-bottom: 4rem;
	}
	.hero-badge {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--accent-cyan);
		padding: 0.4rem 1.2rem;
		border-radius: 50px;
		display: inline-block;
		margin-bottom: 1.5rem;
	}
	.calendar-header h2 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		margin-bottom: 1rem;
	}
	.calendar-header p {
		font-size: 1.1rem;
		opacity: 0.7;
		max-width: 550px;
		margin: 0 auto;
	}

	/* Bento Grid */
	.calendar-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	/* Glass Minimal (scoped) */
	.glass-minimal {
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-radius: 20px;
		transition: all 0.3s;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
		border: 1px solid rgba(255,255,255,0.15);
	}
	:root.dark .glass-minimal {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255,255,255,0.06);
		box-shadow: inset 0 1px 1px rgba(255,255,255,0.06), 0 8px 24px rgba(0,0,0,0.15);
	}

	/* Card Base */
	.cal-card {
		padding: 2rem;
		display: flex;
		flex-direction: column;
	}
	.cal-card:hover {
		transform: translateY(-4px);
		border-color: rgba(var(--cbs-emerald-rgb), 0.4);
	}

	/* Featured */
	.cal-card.featured {
		grid-column: span 2;
		border-left: 4px solid var(--cbs-emerald);
		background: linear-gradient(135deg, rgba(var(--cbs-emerald-rgb), 0.08), rgba(var(--cbs-blue-corp-rgb), 0.06));
	}
	:root.dark .cal-card.featured {
		background: linear-gradient(135deg, rgba(var(--cbs-emerald-rgb), 0.1), rgba(var(--cbs-blue-corp-rgb), 0.05));
	}

	.cal-highlight {
		display: inline-block;
		font-size: 0.6rem;
		font-weight: 900;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		background: var(--cbs-emerald);
		color: white;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		margin-bottom: 1rem;
		width: fit-content;
	}

	.cal-card-header {
		margin-bottom: 1.5rem;
	}
	.cal-num {
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-color);
		opacity: 0.4;
		display: block;
		margin-bottom: 0.2rem;
	}
	.cal-month {
		font-size: 1.4rem;
		font-weight: 800;
		margin: 0;
		text-transform: uppercase;
		letter-spacing: -0.01em;
	}
	.cal-card.featured .cal-month {
		font-size: 1.8rem;
	}

	/* Biodesign Portal Card */
	.cal-card.biodesign-portal {
		position: relative;
		overflow: visible; /* allow hologram to overflow top */
		border-left: 4px solid #79f8d0;
		background: linear-gradient(135deg, rgba(121, 248, 208, 0.08), rgba(69, 38, 196, 0.08));
		border-color: rgba(121, 248, 208, 0.3);
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		padding-top: 3.5rem; /* space for floating hologram */
		cursor: pointer;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
	}
	:root.dark .cal-card.biodesign-portal {
		background: linear-gradient(135deg, rgba(121, 248, 208, 0.12), rgba(69, 38, 196, 0.15));
		border-color: rgba(121, 248, 208, 0.35);
	}
	.cal-card.biodesign-portal:hover {
		transform: translateY(-8px) scale(1.02);
		border-color: #79f8d0;
		box-shadow: 0 16px 40px rgba(121, 248, 208, 0.3), inset 0 0 20px rgba(121, 248, 208, 0.08);
	}

	.biodesign-highlight {
		background: linear-gradient(90deg, #79f8d0, #bbf35f) !important;
		color: #00382a !important;
		box-shadow: 0 2px 10px rgba(121, 248, 208, 0.4);
	}

	.cal-card.biodesign-portal .cal-month {
		background: linear-gradient(90deg, #79f8d0, #bbf35f);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.cal-card.biodesign-portal .cal-event-icon {
		color: #79f8d0;
	}

	.cal-card.biodesign-portal .cal-event-title {
		color: #79f8d0;
	}

	.biodesign-cta {
		background: linear-gradient(90deg, #79f8d0, #5adbb5) !important;
		color: #00382a !important;
		box-shadow: 0 4px 18px rgba(121, 248, 208, 0.4) !important;
	}
	.biodesign-cta:hover {
		box-shadow: 0 6px 25px rgba(121, 248, 208, 0.6) !important;
		transform: translateY(-3px) scale(1.02);
	}

	/* Hologram Effect — centered at top, floats above card */
	.hologram-container {
		position: absolute;
		top: -38px;
		left: 50%;
		transform: translateX(-50%);
		width: 88px;
		height: 88px;
		pointer-events: none;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 5;
	}

	.cal-card.biodesign-portal:hover .hologram-container {
		transform: translateX(-50%) scale(1.15);
		top: -44px;
	}

	.hologram-core {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		animation: hologram-float 4s ease-in-out infinite;
	}

	/* Scanner: beam of light passing through the logo */
	.hologram-scanner {
		position: absolute;
		left: -8px;
		right: -8px;
		height: 30%;
		background: linear-gradient(
			to bottom,
			transparent 0%,
			rgba(121, 248, 208, 0.25) 35%,
			rgba(121, 248, 208, 0.5) 50%,
			rgba(121, 248, 208, 0.25) 65%,
			transparent 100%
		);
		z-index: 4;
		pointer-events: none;
		animation: hologram-scan 2.5s ease-in-out infinite;
	}

	.hologram-ring {
		position: absolute;
		border-radius: 50%;
		border: 1px dashed rgba(121, 248, 208, 0.5);
		transition: all 0.4s ease;
	}

	.hologram-ring-1 {
		width: 68px;
		height: 68px;
		animation: hologram-rotate 10s linear infinite;
	}

	.hologram-ring-2 {
		width: 84px;
		height: 84px;
		border-color: rgba(200, 191, 255, 0.4);
		border-style: dotted;
		animation: hologram-rotate-rev 7s linear infinite;
	}

	.cal-card.biodesign-portal:hover .hologram-ring-1 {
		border-color: rgba(121, 248, 208, 0.9);
		width: 72px;
		height: 72px;
	}

	.cal-card.biodesign-portal:hover .hologram-ring-2 {
		border-color: rgba(187, 243, 95, 0.6);
	}

	.hologram-logo {
		width: 56px;
		height: 56px;
		object-fit: contain;
		filter:
			drop-shadow(0 0 8px rgba(121, 248, 208, 0.8))
			drop-shadow(0 0 18px rgba(121, 248, 208, 0.4));
		transition: all 0.4s ease;
		border-radius: 12px;
		background: rgba(19, 17, 32, 0.8);
		padding: 4px;
	}

	.cal-card.biodesign-portal:hover .hologram-logo {
		transform: scale(1.12) rotate(4deg);
		filter:
			drop-shadow(0 0 14px rgba(121, 248, 208, 1))
			drop-shadow(0 0 28px rgba(187, 243, 95, 0.7));
	}

	@keyframes hologram-rotate {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	@keyframes hologram-rotate-rev {
		from { transform: rotate(360deg); }
		to { transform: rotate(0deg); }
	}

	@keyframes hologram-scan {
		0% { transform: translateY(-36px); opacity: 0; }
		20% { opacity: 1; }
		80% { opacity: 1; }
		100% { transform: translateY(36px); opacity: 0; }
	}

	@keyframes hologram-float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-5px); }
	}

	/* Events inside card */
	.cal-events {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.cal-event {
		border-left: 2px solid rgba(var(--cbs-emerald-rgb), 0.3);
		padding-left: 1rem;
	}
	.cal-card.featured .cal-event {
		background: rgba(0,0,0,0.15);
		border-left: none;
		padding: 1rem;
		border-radius: 12px;
	}
	.cal-event-top {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		margin-bottom: 0.4rem;
	}
	.cal-event-icon {
		font-size: 1.1rem;
		color: var(--cbs-emerald);
		margin-top: 2px;
	}
	.cal-event-title {
		font-size: 0.85rem;
		font-weight: 800;
		color: var(--text-color);
		line-height: 1.3;
	}
	.cal-card.featured .cal-event-title {
		color: var(--cbs-emerald);
		font-size: 0.95rem;
	}
	.cal-event-date {
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.5;
		font-weight: 700;
		margin-top: 2px;
	}
	.cal-event-desc {
		font-size: 0.8rem;
		line-height: 1.5;
		opacity: 0.7;
		margin: 0;
	}

	/* CTA */
	.cal-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		padding: 0.7rem 1.4rem;
		border-radius: 50px;
		background: var(--cbs-emerald);
		color: white;
		font-size: 0.7rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		transition: all 0.3s;
		width: fit-content;
		box-shadow: 0 4px 15px rgba(var(--cbs-emerald-rgb), 0.3);
	}
	.cal-cta:hover {
		transform: translateY(-2px);
