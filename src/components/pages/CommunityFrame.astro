---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
	src?: string;
}

const lumaCalendarUrl = 'https://luma.com/cbs-unmsm';
const defaultEmbedUrl = 'https://luma.com/embed/calendar/cal-M0iwE4Hz97gDhE3/events';
const { lang = 'es', src = defaultEmbedUrl } = Astro.props;
const t = useTranslations(lang);
---

<section class="community-section animate-in" style="animation-delay: 0.25s">
	<!-- Section Header -->
	<div class="community-header">
		<span class="hero-badge glass">{t('community.pretitle')}</span>
		<h2>{t('community.title')} <span class="gradient-text">{t('community.highlight')}</span></h2>
		<p>{t('community.subtitle')}</p>
	</div>

	<!-- Desktop: Iframe -->
	<div class="frame-container" id="community-frame-container">
		<!-- Loading Skeleton -->
		<div class="frame-skeleton" id="community-skeleton">
			<div class="skeleton-nav"></div>
			<div class="skeleton-hero"></div>
			<div class="skeleton-cards">
				<div class="skeleton-card"></div>
				<div class="skeleton-card"></div>
				<div class="skeleton-card"></div>
			</div>
			<p class="skeleton-text">{t('community.loading')}</p>
		</div>

		<!-- Error Fallback -->
		<div class="frame-error" id="community-error" style="display:none">
			<span class="material-icons frame-error-icon">event_available</span>
			<p class="frame-error-msg">{t('community.error')}</p>
			<a href={lumaCalendarUrl} target="_blank" rel="noopener noreferrer" class="frame-error-link">
				{t('community.error.link')} <span class="material-icons">open_in_new</span>
			</a>
		</div>

		<!-- Iframe (hidden until loaded) -->
		<iframe
			id="community-iframe"
			src={src}
			title="Luma Calendar - CBS-UNMSM"
			sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
			allow="clipboard-read; clipboard-write"
			style="display:none"
		></iframe>
	</div>

	<!-- Mobile: Preview Card -->
	<div class="mobile-preview">
		<div class="mobile-card glass-minimal">
			<div class="mobile-card-glow"></div>
			<div class="mobile-card-icon-wrap">
				<span class="material-icons mobile-card-icon">event_available</span>
			</div>
			<h3>Luma CBS-UNMSM</h3>
			<p>{t('community.mobile.desc')}</p>
			<a href={lumaCalendarUrl} target="_blank" rel="noopener noreferrer" class="community-cta">
				{t('community.mobile.cta')} <span class="material-icons cta-arrow">arrow_forward</span>
			</a>
		</div>
	</div>

	<!-- Secondary CTA (Desktop) -->
	<div class="frame-footer">
		<a href={lumaCalendarUrl} target="_blank" rel="noopener noreferrer" class="community-cta-secondary">
			{t('community.cta')} <span class="material-icons cta-arrow-secondary">open_in_new</span>
		</a>
	</div>
</section>

<script is:inline>
	function initCommunityFrame() {
		var iframe = document.getElementById('community-iframe');
		var skeleton = document.getElementById('community-skeleton');
		var errorEl = document.getElementById('community-error');

		if (!iframe || !skeleton || !errorEl) return;

		// Reset states in case of View Transition re-nav
		skeleton.style.display = 'flex';
		errorEl.style.display = 'none';
		iframe.style.display = 'none';

		var loaded = false;

		function onLoad() {
			if (loaded) return;
			loaded = true;
			skeleton.style.display = 'none';
			errorEl.style.display = 'none';
			iframe.style.display = 'block';
		}

		function onError() {
			if (loaded) return;
			skeleton.style.display = 'none';
			errorEl.style.display = 'flex';
			iframe.style.display = 'none';
		}

		iframe.addEventListener('load', onLoad);
		iframe.addEventListener('error', onError);

		// Timeout fallback: if iframe hasn't loaded after 12s, show error
		setTimeout(function () {
			if (!loaded) {
				onError();
			}
		}, 12000);
	}

	// Run on initial page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCommunityFrame);
	} else {
		initCommunityFrame();
	}

	// Re-run after Astro View Transition swaps
	document.addEventListener('astro:after-swap', initCommunityFrame);
</script>

<style>
	.community-section {
		max-width: 1200px;
		margin: 0 auto 4rem;
		padding: 0 2rem;
	}

	/* Header */
	.community-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.hero-badge {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--accent-cyan);
		padding: 0.4rem 1.2rem;
		border-radius: 50px;
		display: inline-block;
		margin-bottom: 1.5rem;
	}
	.community-header h2 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		margin-bottom: 1rem;
	}
	.community-header p {
		font-size: 1.1rem;
		opacity: 0.7;
		max-width: 550px;
		margin: 0 auto;
	}

	/* Frame Container (Desktop) */
	.frame-container {
		position: relative;
		border-radius: 24px;
		overflow: hidden;
		min-height: 520px;

		/* Glass Minimal */
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);

		/* Emerald accent border */
		border: 2px solid rgba(var(--cbs-emerald-rgb), 0.25);
		transition: border-color 0.4s ease, box-shadow 0.4s ease;
	}
	:root.dark .frame-container {
		background: rgba(255, 255, 255, 0.03);
		border-color: rgba(var(--cbs-emerald-rgb), 0.15);
		box-shadow: inset 0 1px 1px rgba(255,255,255,0.06), 0 8px 32px rgba(0,0,0,0.2);
	}
	.frame-container:hover {
		border-color: rgba(var(--cbs-emerald-rgb), 0.5);
		box-shadow: 0 12px 48px rgba(var(--cbs-emerald-rgb), 0.1);
	}
	:root.dark .frame-container:hover {
		border-color: rgba(var(--cbs-emerald-rgb), 0.35);
		box-shadow: inset 0 1px 1px rgba(255,255,255,0.06), 0 12px 48px rgba(var(--cbs-emerald-rgb), 0.15);
	}

	/* Iframe */
	#community-iframe {
		width: 100%;
		height: 520px;
		border: none;
		border-radius: 22px;
	}

	/* Loading Skeleton */
	.frame-skeleton {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		gap: 1.5rem;
	}
	.skeleton-nav {
		height: 56px;
		border-radius: 12px;
		background: linear-gradient(90deg, rgba(var(--cbs-blue-corp-rgb), 0.08) 25%, rgba(var(--cbs-blue-corp-rgb), 0.15) 50%, rgba(var(--cbs-blue-corp-rgb), 0.08) 75%);
		background-size: 200% 100%;
		animation: shimmer 1.8s ease-in-out infinite;
	}
	.skeleton-hero {
		height: 220px;
		border-radius: 16px;
		background: linear-gradient(90deg, rgba(var(--cbs-emerald-rgb), 0.06) 25%, rgba(var(--cbs-emerald-rgb), 0.12) 50%, rgba(var(--cbs-emerald-rgb), 0.06) 75%);
		background-size: 200% 100%;
		animation: shimmer 1.8s ease-in-out infinite;
		animation-delay: 0.2s;
	}
	.skeleton-cards {
		display: flex;
		gap: 1rem;
		flex: 1;
	}
	.skeleton-card {
		flex: 1;
		border-radius: 20px;
		background: linear-gradient(90deg, rgba(var(--cbs-blue-corp-rgb), 0.05) 25%, rgba(var(--cbs-blue-corp-rgb), 0.1) 50%, rgba(var(--cbs-blue-corp-rgb), 0.05) 75%);
		background-size: 200% 100%;
		animation: shimmer 1.8s ease-in-out infinite;
		animation-delay: 0.4s;
	}
	.skeleton-text {
		text-align: center;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--text-color);
		opacity: 0.4;
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes shimmer {
		0% { background-position: 200% 0; }
		100% { background-position: -200% 0; }
	}
	@keyframes pulse {
		0%, 100% { opacity: 0.4; }
		50% { opacity: 0.15; }
	}

	/* Error State */
	.frame-error {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.frame-error-icon {
		font-size: 3rem;
		color: var(--accent-cyan);
		opacity: 0.5;
	}
	.frame-error-msg {
		font-size: 1rem;
		font-weight: 700;
		opacity: 0.6;
	}
	.frame-error-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.4rem;
		border-radius: 50px;
		background: var(--cbs-emerald);
		color: white;
		font-size: 0.75rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		transition: all 0.3s;
		box-shadow: 0 4px 15px rgba(var(--cbs-emerald-rgb), 0.3);
	}
	.frame-error-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(var(--cbs-emerald-rgb), 0.4);
	}
	.frame-error-link .material-icons {
		font-size: 1rem;
	}

	/* Mobile Preview Card */
	.mobile-preview {
		display: none;
	}
	.mobile-card {
		position: relative;
		padding: 2.5rem 2rem;
		border-radius: 24px;
		text-align: center;
		overflow: hidden;
	}
	.mobile-card-glow {
		position: absolute;
		top: -40%;
		left: 50%;
		transform: translateX(-50%);
		width: 300px;
		height: 300px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(var(--cbs-emerald-rgb), 0.15), transparent 70%);
		pointer-events: none;
	}
	.mobile-card-icon-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		border-radius: 20px;
		background: linear-gradient(135deg, rgba(var(--cbs-emerald-rgb), 0.15), rgba(var(--cbs-blue-corp-rgb), 0.1));
		margin-bottom: 1.5rem;
		border: 1px solid rgba(var(--cbs-emerald-rgb), 0.2);
	}
	.mobile-card-icon {
		font-size: 1.8rem;
		color: var(--cbs-emerald);
	}
	.mobile-card h3 {
		font-size: 1.6rem;
		font-weight: 800;
		margin-bottom: 0.75rem;
		color: var(--text-color);
	}
	.mobile-card p {
		font-size: 0.95rem;
		opacity: 0.7;
		line-height: 1.6;
		margin-bottom: 2rem;
		max-width: 400px;
		margin-left: auto;
		margin-right: auto;
	}

	/* CTAs */
	.community-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.9rem 1.8rem;
		border-radius: 50px;
		background: var(--cbs-emerald);
		color: white;
		font-size: 0.75rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		transition: all 0.3s;
		box-shadow: 0 4px 15px rgba(var(--cbs-emerald-rgb), 0.3);
	}
	.community-cta:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 25px rgba(var(--cbs-emerald-rgb), 0.4);
	}
	.cta-arrow {
		font-size: 1rem;
		transition: transform 0.3s;
	}
	.community-cta:hover .cta-arrow {
		transform: translateX(3px);
	}

	/* Footer CTA (Desktop) */
	.frame-footer {
		text-align: center;
		margin-top: 2rem;
	}
	.community-cta-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1.2rem;
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-color);
		opacity: 0.5;
		text-decoration: none;
		border-radius: 50px;
		border: 1px solid var(--border-color);
		transition: all 0.3s;
	}
	.community-cta-secondary:hover {
		opacity: 1;
		border-color: var(--cbs-emerald);
		color: var(--cbs-emerald);
		background: rgba(var(--cbs-emerald-rgb), 0.05);
	}
	.cta-arrow-secondary {
		font-size: 0.9rem;
	}

	/* Glass Minimal (scoped) */
	.glass-minimal {
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-radius: 24px;
		transition: all 0.3s;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
		border: 1px solid rgba(255,255,255,0.15);
	}
	:root.dark .glass-minimal {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255,255,255,0.06);
		box-shadow: inset 0 1px 1px rgba(255,255,255,0.06), 0 8px 24px rgba(0,0,0,0.15);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.frame-container {
			display: none;
		}
		.frame-footer {
			display: none;
		}
		.mobile-preview {
			display: block;
		}
	}
</style>
