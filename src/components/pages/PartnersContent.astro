---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const allLogos = [
	{ name: 'CERSEU', img: `${base}/allies/unmsm_logo.png` },
	{ name: 'FCB-UNMSM', img: `${base}/allies/fcb_logo.png` },
	{ name: 'CEM', img: `${base}/allies/Logo-CEM.avif` },
	{ name: 'Synbio LATAM', img: `${base}/allies/synbiolatam.jpg` },
	{ name: 'ASM UTEC', img: `${base}/allies/logo_asmutec.jpg` },
	{ name: lang === 'es' ? 'AI Kids Perú' : 'AI Kids Peru', img: `${base}/allies/ai_kids.png` },
	{ name: 'Lyn Biolearning', img: `${base}/allies/logo_lyn.png` },
	{ name: 'NEA', img: `${base}/allies/logo_nea.jpeg` },
	{ name: 'Biomin', img: `${base}/allies/logo_biomin.jpeg` },
];

const categories = [
	{
		id: 'academic',
		title: t('partners.cat.academic'),
		icon: 'account_balance',
		partners: [
			{
				name: 'CERSEU',
				fullName: lang === 'es' ? 'Centro de Extensión Universitaria y Proyección Social - FCB UNMSM' : 'Center for University Extension and Social Responsibility - FCB UNMSM',
				desc: lang === 'es' ? 'Entidad oficial de extensión universitaria de la Facultad de Ciencias Biológicas de la UNMSM.' : 'Official university extension entity of the Faculty of Biological Sciences at UNMSM.',
				img: `${base}/allies/unmsm_logo.png`,
				url: 'https://unmsm.edu.pe',
				tag: lang === 'es' ? 'Extensión Universitaria' : 'University Extension'
			},
			{
				name: 'FCB-UNMSM',
				fullName: lang === 'es' ? 'Facultad de Ciencias Biológicas - UNMSM' : 'Faculty of Biological Sciences - UNMSM',
				desc: lang === 'es' ? 'Facultad base que nos alberga institucionalmente y brinda soporte académico e infraestructura.' : 'Base faculty housing us institutionally and providing academic support and infrastructure.',
				img: `${base}/allies/fcb_logo.png`,
				url: 'https://biologia.unmsm.edu.pe',
				tag: lang === 'es' ? 'Facultad Base' : 'Base Faculty'
			}
		]
	},
	{
		id: 'networks',
		title: t('partners.cat.networks'),
		icon: 'public',
		partners: [
			{
				name: 'Synbio LATAM',
				fullName: 'Synbio LATAM Network',
				desc: lang === 'es' ? 'Red latinoamericana de biología sintética que conecta comunidades e investigadores de toda la región.' : 'Latin American synthetic biology network connecting communities and researchers across the region.',
				img: `${base}/allies/synbiolatam.jpg`,
				url: 'https://synbiolatam.org',
				tag: lang === 'es' ? 'Red Regional' : 'Regional Network'
			},
			{
				name: 'ASM UTEC',
				fullName: 'American Society for Microbiology - UTEC Student Chapter',
				desc: lang === 'es' ? 'Capítulo estudiantil aliado para la difusión de eventos, microbiología aplicada y talleres conjuntos.' : 'Allied student chapter for event dissemination, applied microbiology, and joint workshops.',
				img: `${base}/allies/logo_asmutec.jpg`,
				url: '#',
				tag: lang === 'es' ? 'Capítulo Académico' : 'Student Chapter'
			},
			{
				name: 'NEA',
				fullName: 'Núcleo de Estudios Avanzados',
				desc: lang === 'es' ? 'Organización estudiantil enfocada en la investigación interdisciplinaria y formación científica.' : 'Student organization focused on interdisciplinary research and scientific education.',
				img: `${base}/allies/logo_nea.jpeg`,
				url: '#',
				tag: lang === 'es' ? 'Organización Estudiantil' : 'Student Organization'
			},
			{
				name: 'Biomin',
				fullName: 'Biomin - Organización Estudiantil',
				desc: lang === 'es' ? 'Grupo estudiantil aliado dedicado al desarrollo de proyectos en biotecnología.' : 'Allied student group dedicated to biotechnological projects.',
				img: `${base}/allies/logo_biomin.jpeg`,
				url: '#',
				tag: lang === 'es' ? 'Organización Estudiantil' : 'Student Organization'
			}
		]
	},
	{
		id: 'edtech',
		title: t('partners.cat.edtech'),
		icon: 'biotech',
		partners: [
			{
				name: lang === 'es' ? 'AI Kids Perú' : 'AI Kids Peru',
				fullName: 'AI Kids Perú',
				desc: lang === 'es' ? 'Plataforma educativa aliada en inteligencia artificial, programación e innovación STEM.' : 'Allied educational platform in artificial intelligence, programming, and STEM innovation.',
				img: `${base}/allies/ai_kids.png`,
				url: '#',
				tag: 'EdTech & IA'
			},
			{
				name: 'CEM',
				fullName: 'Centro de Especialización Multidisciplinaria',
				desc: lang === 'es' ? 'Centro de especialización enfocado en capacitaciones y formación continua multidisciplinaria.' : 'Specialization center focused on continuous multidisciplinary training.',
				img: `${base}/allies/Logo-CEM.avif`,
				url: '#',
				tag: lang === 'es' ? 'Especialización EdTech' : 'EdTech Specialization'
			},
			{
				name: 'Lyn Biolearning',
				fullName: 'Lyn Biolearning Platform',
				desc: lang === 'es' ? 'Comunidad de aprendizaje especializado en biotecnología y biología computacional.' : 'Specialized learning community in biotechnology and computational biology.',
				img: `${base}/allies/logo_lyn.png`,
				url: '#',
				tag: 'Biolearning'
			}
		]
	}
];
---

<Layout title={lang === 'es' ? 'Aliados' : 'Partners'} lang={lang}>
	<div class="container page-content">
		<!-- Header -->
		<header class="page-header animate-in">
			<span class="hero-badge glass">{t('partners.pretitle')}</span>
			<h1>{t('partners.heading')} <span class="gradient-text">{t('partners.heading.highlight')}</span></h1>
			<p>{t('partners.subtitle')}</p>
		</header>

		<!-- Marquee Infinite Carousel -->
		<div class="marquee-banner animate-in" style="animation-delay: 0.15s" aria-label="Aliados Institucionales">
			<div class="marquee-track">
				{[...allLogos, ...allLogos].map((logo) => (
					<div class="marquee-card glass-minimal">
						<img src={logo.img} alt={logo.name} class="marquee-img" loading="eager" />
						<span class="marquee-label">{logo.name}</span>
					</div>
				))}
			</div>
		</div>

		<!-- Categories Sections -->
		{categories.map((cat, catIdx) => (
			<section class="partner-category-section animate-in" style={`animation-delay: ${0.2 + catIdx * 0.1}s`}>
				<div class="category-header">
					<span class="material-icons cat-icon">{cat.icon}</span>
					<h2>{cat.title}</h2>
				</div>

				<div class="partners-grid">
					{cat.partners.map((partner) => (
						<div class="partner-card glass-card">
							<div class="card-top">
								<div class="logo-box">
									<img src={partner.img} alt={partner.name} class="partner-logo-img" loading="lazy" />
								</div>
								<span class="category-pill">{partner.tag}</span>
							</div>
							
							<div class="card-body">
								<h3>{partner.name}</h3>
								<span class="partner-fullname">{partner.fullName}</span>
								<p>{partner.desc}</p>
							</div>

							<div class="card-footer">
								{partner.url !== '#' ? (
									<a href={partner.url} target="_blank" rel="noopener noreferrer" class="btn-visit">
										{t('partners.visit')} <span class="material-icons btn-arrow">open_in_new</span>
									</a>
								) : (
									<div class="ally-badge-pill">
										<span class="material-icons badge-check">verified</span>
										<span>{t('partners.ally_badge')}</span>
									</div>
								)}
							</div>
						</div>
					))}
				</div>
			</section>
		))}
	</div>
</Layout>

<style>
	.page-content {
		padding-bottom: 8rem;
	}

	.page-header {
		padding: 8rem 0 3.5rem;
		text-align: center;
	}

	.hero-badge {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--accent-cyan);
		padding: 0.4rem 1.2rem;
		border-radius: 50px;
		display: inline-block;
		margin-bottom: 1.5rem;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		line-height: 1;
		margin-bottom: 1.5rem;
		font-weight: 800;
	}

	.page-header p {
		font-size: 1.2rem;
		opacity: 0.75;
		max-width: 650px;
		margin: 0 auto;
		line-height: 1.65;
	}

	/* Marquee Banner */
	.marquee-banner {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		overflow: hidden;
		padding: 1.5rem 0;
		margin-bottom: 5rem;
		mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
	}
	.marquee-track {
		display: flex;
		gap: 1.5rem;
		width: max-content;
		animation: marquee-scroll 32s linear infinite;
	}
	.marquee-banner:hover .marquee-track {
		animation-play-state: paused;
	}
	@keyframes marquee-scroll {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
	.marquee-card {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.7rem 1.4rem;
		border-radius: 50px;
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.15);
		white-space: nowrap;
	}
	:root.dark .marquee-card {
		background: rgba(255, 255, 255, 0.03);
		border-color: rgba(255, 255, 255, 0.08);
	}
	.marquee-img {
		width: 28px;
		height: 28px;
		object-fit: contain;
	}
	.marquee-label {
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		color: var(--text-color);
	}

	/* Category Sections */
	.partner-category-section {
		margin-bottom: 5rem;
	}
	.category-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.cat-icon {
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background: rgba(var(--cbs-emerald-rgb), 0.12);
		color: var(--cbs-emerald);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.4rem;
		border: 1px solid rgba(var(--cbs-emerald-rgb), 0.25);
	}
	.category-header h2 {
		font-size: 1.7rem;
		font-weight: 800;
		margin: 0;
	}

	/* Partners Grid */
	.partners-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}

	.glass-card {
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-radius: 24px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		padding: 2.2rem;
		display: flex;
		flex-direction: column;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
	}
	:root.dark .glass-card {
		background: rgba(255, 255, 255, 0.03);
		border-color: rgba(255, 255, 255, 0.06);
		box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.06), 0 10px 30px rgba(0, 0, 0, 0.15);
	}
	.glass-card:hover {
		transform: translateY(-6px);
		border-color: rgba(var(--cbs-emerald-rgb), 0.4);
		box-shadow: 0 20px 48px rgba(var(--cbs-emerald-rgb), 0.12);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.8rem;
	}
	.logo-box {
		width: 72px;
		height: 72px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.95);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}
	:root.dark .logo-box {
		background: rgba(15, 28, 48, 0.95);
		border-color: rgba(var(--cbs-emerald-rgb), 0.3);
	}
	.partner-logo-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.category-pill {
		font-size: 0.65rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.35rem 0.85rem;
		border-radius: 50px;
		background: rgba(var(--cbs-emerald-rgb), 0.12);
		color: var(--cbs-emerald);
		border: 1px solid rgba(var(--cbs-emerald-rgb), 0.25);
	}

	.card-body {
		flex-grow: 1;
		margin-bottom: 2rem;
	}
	.card-body h3 {
		font-size: 1.5rem;
		font-weight: 800;
		margin: 0 0 0.2rem;
		color: var(--text-color);
	}
	.partner-fullname {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent-cyan);
		display: block;
		margin-bottom: 0.9rem;
	}
	.card-body p {
		font-size: 0.92rem;
		line-height: 1.6;
		opacity: 0.75;
		margin: 0;
	}

	.card-footer {
		margin-top: auto;
	}
	.btn-visit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.8rem 1.4rem;
		border-radius: 50px;
		background: var(--cbs-emerald);
		color: white;
		font-size: 0.75rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		transition: all 0.3s;
		box-shadow: 0 4px 15px rgba(var(--cbs-emerald-rgb), 0.3);
	}
	.btn-visit:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(var(--cbs-emerald-rgb), 0.4);
	}
	.btn-arrow {
		font-size: 1rem;
	}

	.ally-badge-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 100%;
		padding: 0.75rem 1.4rem;
		border-radius: 50px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.85;
	}
	.badge-check {
		font-size: 1rem;
		color: var(--cbs-emerald);
	}

	@media (max-width: 768px) {
		.partners-grid {
			grid-template-columns: 1fr;
		}
		.glass-card {
			padding: 1.8rem;
		}
	}
</style>
