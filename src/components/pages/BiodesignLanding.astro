	.bd-sesion-phase--bootcamp {
		background: rgba(var(--bd-primary-rgb), 0.15);
		color: var(--bd-primary);
	}

	.bd-sesion-phase--hackathon {
		background: rgba(var(--bd-tertiary-rgb), 0.15);
		color: var(--bd-tertiary);
	}

	.bd-sesion-body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}

	.bd-sesion-icon-wrap {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.55rem;
		background: rgba(255, 255, 255, 0.04);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bd-sesion-icon {
		font-size: 1.2rem;
		color: var(--bd-primary);
	}

	.bd-sesion-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		margin: 0;
	}

	.bd-sesion-desc {
		font-size: 0.76rem;
		color: var(--bd-on-surface-variant);
		line-height: 1.45;
		margin: 0;
	}

	.bd-sesion-speaker-profile {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: auto;
		padding-top: 0.65rem;
		border-top: 1px solid rgba(var(--bd-secondary-container-rgb), 0.2);
	}

	.bd-sesion-avatar-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.bd-sesion-avatar-wrap {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		overflow: hidden;
		border: 1.5px solid rgba(var(--bd-primary-rgb), 0.4);
		background: rgba(0, 0, 0, 0.3);
		flex-shrink: 0;
	}

	.bd-sesion-avatar-wrap--stacked {
		margin-right: -10px;
	}

	.bd-sesion-avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.bd-sesion-speaker-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.bd-sesion-speaker-name {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bd-sesion-speaker-meta {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.66rem;
		color: var(--bd-on-surface-variant);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bd-sesion-speaker-org {
		color: var(--bd-tertiary);
		font-weight: 600;
	}

	/* ── Rúbrica inside Details ── */
	.bd-rubrica-total {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1.25rem;
		border-radius: 0.85rem;
		background: rgba(var(--bd-tertiary-rgb), 0.06);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.2);
		margin: 1rem 0 1.25rem;
	}

	.bd-criterios-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

