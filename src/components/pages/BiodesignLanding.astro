						</span>
						{c.desempate && (
							<span class="bd-chip" style="font-size:0.65rem; padding:0.15rem 0.5rem; background:rgba(var(--bd-secondary-rgb),0.15); color:var(--bd-secondary); margin-left:0.4rem;">
