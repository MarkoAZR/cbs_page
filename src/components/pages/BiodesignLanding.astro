		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--bd-primary);
	}
	.bd-nivel-desc {
		font-size: 0.76rem;
		color: var(--bd-on-surface-variant);
		margin: 0.25rem 0 0;
		line-height: 1.45;
	}

