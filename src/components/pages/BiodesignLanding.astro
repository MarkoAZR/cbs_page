---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
// import BiodesignMemories from '../biodesign/BiodesignMemories.astro';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Formularios oficiales cerrados el 23 de septiembre de 2026:
// const FORM_URL_INDIVIDUAL = 'https://forms.gle/mSu1fALd9AFnN15y8';
// const FORM_URL_GROUP = 'https://forms.gle/NoDNkHumVhDA9beE6';
const LINKEDIN_URL = 'https://www.linkedin.com/company/cbs-unmsm';
const EMAIL_CONTACT = 'cbs.unmsm@gmail.com';

// ── Tracks Oficiales ────────────────────────────────────────
const tracks = [
	{
		id: 'track1',
		icon: 'water_drop',
		color: 'teal',
		accentVar: '--bd-primary',
		rgbVar: 'var(--bd-primary-rgb)',
		retos: ['reto1', 'reto2', 'reto3'] as const,
		preguntas: ['q1', 'q2', 'q3'] as const,
	},
	{
		id: 'track2',
		icon: 'health_and_safety',
		color: 'purple',
		accentVar: '--bd-secondary',
		rgbVar: 'var(--bd-secondary-rgb)',
		retos: ['reto1', 'reto2', 'reto3'] as const,
		preguntas: ['q1', 'q2', 'q3'] as const,
	},
	{
		id: 'track3',
		icon: 'compost',
		color: 'lime',
		accentVar: '--bd-tertiary',
		rgbVar: 'var(--bd-tertiary-rgb)',
		retos: ['reto1', 'reto2', 'reto3'] as const,
		preguntas: ['q1', 'q2', 'q3'] as const,
	},
];

// ── Sesiones y Cronograma Oficial (10 Hitos) ─────────────────
interface Sesion {
	key: string;
	icon: string;
	special: string;
	fase: number;
	ponente: string;
	avatars: string[];
	org: string;
	role: string;
	pending?: boolean;
}

const sesiones: Sesion[] = [
	{
		key: 's0',
		icon: 'celebration',
		special: 'open',
		fase: 1,
		ponente: lang === 'es' ? 'Comité Organizador (CBS & NEA)' : 'Organizing Committee (CBS & NEA)',
		avatars: [`${base}/cbs_logo.png`, `${base}/allies/logo_nea.jpeg`],
		org: 'CBS & NEA',
		role: lang === 'es' ? 'Bienvenida Presencial en Lima' : 'In-Person Welcome in Lima'
	},
	{
		key: 's1',
		icon: 'biotech',
		special: 'lecture',
		fase: 1,
		ponente: 'Valery Velásquez',
		avatars: [`${base}/team/Valery_Velasquez.jpg`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Investigadora UNMSM' : 'UNMSM Researcher'
	},
	{
		key: 's2',
		icon: 'science',
		special: 'lecture',
		fase: 1,
		ponente: 'Victoria Esmeralda Vargas Alamo',
		avatars: [`${base}/allies/logo_asmutec.jpg`],
		org: 'ASM UTEC',
		role: lang === 'es' ? 'Bioingeniera UTEC' : 'UTEC Bioengineer'
	},
	{
		key: 's3',
		icon: 'bubble_chart',
		special: 'lecture',
		fase: 1,
		ponente: 'Marko Zapata',
		avatars: [`${base}/team/Marko_zapata.jpg`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Investigador INS - Exp. iGEM DL' : 'INS Researcher - iGEM DL Exp.'
	},
	{
		key: 's4',
		icon: 'extension',
		special: 'lecture',
		fase: 1,
		ponente: 'Benjamín Díaz',
		avatars: [`${base}/team/benja_cbs.jpg`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Estudiante de Maestría en UNMSM' : "Master's Student at UNMSM"
	},
	{
		key: 's5',
		icon: 'terminal',
		special: 'workshop',
		fase: 1,
		ponente: 'Rodrigo Puertas',
		avatars: [`${base}/team/Rodrigo_Puertas.png`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Tesista GIBIOBES' : 'GIBIOBES Thesis Student'
	},
	{
		key: 's6',
		icon: 'rocket_launch',
		special: 'kickoff',
		fase: 2,
		ponente: lang === 'es' ? 'Comité Organizador (CBS & NEA)' : 'Organizing Committee (CBS & NEA)',
		avatars: [`${base}/Biodesign/logo_biodesign_mm.png`],
		org: 'BioDesign 2026',
		role: lang === 'es' ? 'Kick off informativo' : 'Informative Kick-off'
	},
	{
		key: 's7',
		icon: 'code',
		special: 'hackathon',
		fase: 2,
		ponente: lang === 'es' ? 'Mentores y Equipos' : 'Mentors & Teams',
		avatars: [`${base}/Biodesign/logo_biodesign_mm.png`],
		org: 'BioDesign 2026',
		role: lang === 'es' ? 'Hackathon guiado' : 'Guided Hackathon'
	},
	{
		key: 's8',
		icon: 'fact_check',
		special: 'eval',
		fase: 2,
		ponente: lang === 'es' ? 'Comité Evaluador' : 'Evaluation Committee',
		avatars: [`${base}/Biodesign/logo_biodesign_mm.png`],
		org: 'Jurado Oficial',
		role: lang === 'es' ? 'Revisión por Rúbrica' : 'Rubric Evaluation'
	},
	{
		key: 's9',
		icon: 'emoji_events',
		special: 'clausura',
		fase: 2,
		ponente: lang === 'es' ? 'Panel de Jueces & Organizadores' : 'Judges & Organizers Panel',
		avatars: [`${base}/cbs_logo.png`, `${base}/allies/logo_nea.jpeg`],
		org: 'CBS & NEA',
		role: lang === 'es' ? 'Defensa Presencial & Top 3' : 'In-Person Defense & Top 3'
	},
];

// ── Organizadores (Comité Organizador Oficial) ───────────────
const organizers = [
	{
		name: 'CBS-UNMSM',
		logo: `${base}/cbs_logo.png`,
		badge: lang === 'es' ? 'Liderazgo Científico & Formación' : 'Scientific Leadership & Training',
		desc: t('biodesign.aliados.org.cbs'),
	},
	{
		name: 'NEA — Neuronas en Acción',
		logo: `${base}/allies/logo_nea.jpeg`,
		badge: lang === 'es' ? 'Divulgación STEM & Juventud' : 'STEM Outreach & Youth',
		desc: t('biodesign.aliados.org.nea'),
	},
];

// ── Criterios de Rúbrica ─────────────────────────────────────
const rubricaCriterios = [
	{ key: 'c1', peso: 20, etapa: 1, desempate: false },
	{ key: 'c2', peso: 20, etapa: 1, desempate: false },
	{ key: 'c3', peso: 25, etapa: 1, desempate: true },
	{ key: 'c4', peso: 15, etapa: 1, desempate: false },
	{ key: 'c5', peso: 20, etapa: 2, desempate: true },
];

// ── Aliados ──────────────────────────────────────────────────
const alliedOrgs = [
	{
		name: 'Synbio LATAM',
		logo: `${base}/allies/synbiolatam.jpg`,
		desc: t('biodesign.aliados.synbio.desc'),
	},
	{
		name: 'ASM UTEC',
		logo: `${base}/allies/logo_asmutec.jpg`,
		desc: t('biodesign.aliados.asmutec.desc'),
	},
	{
		name: 'BIOMIM',
		logo: `${base}/allies/logo_biomin.jpeg`,
		desc: t('biodesign.aliados.biomin.desc'),
	},
	{
		name: t('biodesign.aliados.clubesciencia.name'),
		logo: `${base}/allies/club_ciencia.jpeg`,
		desc: t('biodesign.aliados.clubesciencia.desc'),
	},
];
---

<!-- ═══════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════ -->
<section class="bd-hero">
	<!-- Animated background: WebGL shader + CSS orb fallback -->
	<div class="bd-hero-bg" aria-hidden="true">
		<div class="bd-hero-orb bd-hero-orb--1"></div>
		<div class="bd-hero-orb bd-hero-orb--2"></div>
		<div class="bd-hero-orb bd-hero-orb--3"></div>
		<canvas id="bd-shader-canvas" class="bd-shader-canvas"></canvas>
	</div>

	<div class="bd-section bd-hero-content">
		<div class="bd-hero-text">
			<!-- Badges Row: Status Badge (Inscripciones Concluidas) -->
			<div class="bd-hero-top-badges">
				<div class="bd-chip bd-chip-lime bd-hero-badge">
					<span class="material-icons" style="font-size: 14px;">event</span>
					{t('biodesign.hero.badge')}
				</div>
			</div>

			<h1 class="bd-headline-xl">
				{t('biodesign.hero.title1')}<br />
				<span class="bd-gradient-text">{t('biodesign.hero.title2')}</span>
			</h1>

			<p class="bd-body-lg bd-hero-subtitle">
				{t('biodesign.hero.subtitle')}
			</p>

			<div class="bd-hero-actions">
				<div class="bd-hero-cta-buttons">
					<a
						href="#inauguracion"
						class="bd-btn-primary bd-hero-btn bd-hero-btn--teal"
						id="btn-hero-inauguracion"
					>
						<span class="material-icons" style="font-size:1.1rem;">celebration</span>
						{t('biodesign.hero.cta.inauguracion')}
					</a>
					<a
						href="#fases"
						class="bd-btn-secondary bd-hero-btn bd-hero-btn--lime"
						id="btn-hero-cronograma"
					>
						<span class="material-icons" style="font-size:1.1rem;">calendar_month</span>
						{t('biodesign.hero.cta.cronograma')}
					</a>
				</div>
				<div class="bd-hero-sub-actions">
					<a href="#inauguracion" class="bd-btn-ghost bd-hero-sublink">
						<span class="material-icons" style="font-size:1rem;">place</span>
						{lang === 'es' ? 'Cómo llegar (Puerta 2)' : 'How to get there (Gate 2)'}
					</a>
					<span class="bd-hero-sep" aria-hidden="true">•</span>
					<a href="#tracks" class="bd-btn-ghost bd-hero-sublink">
						{t('biodesign.hero.cta.secondary')}
						<span class="material-icons" style="font-size:1rem;">arrow_forward</span>
					</a>
				</div>
			</div>
		</div>

		<div class="bd-hero-visual">
			<div class="bd-hero-img-glow"></div>
			<img
				src={`${base}/Biodesign/logo_biodesign_mm.png`}
				alt="BioDesign Logo"
				class="bd-hero-img"
				width="400"
				height="400"
				loading="eager"
			/>
		</div>
	</div>
</section>

<!-- ═══════════════════════════════════════════
     MODAL DE VISITAS A COLEGIOS (Popup sobre Hero)
     ═══════════════════════════════════════════ -->
<div
	class="bd-modal-overlay bd-school-modal-overlay"
	id="modal-colegios"
	role="dialog"
	aria-modal="true"
	aria-labelledby="modal-colegios-title"
	hidden
>
	<div class="bd-modal bd-modal--lime bd-school-modal">
		<div class="bd-modal-header">
			<span class="material-icons bd-modal-icon" style="color:var(--bd-tertiary);">school</span>
			<div>
				<span class="bd-chip bd-chip-lime" style="font-size:0.65rem;">{t('biodesign.school.modal.badge')}</span>
				<h2 class="bd-headline-md" id="modal-colegios-title" style="margin:0.4rem 0 0; font-size:1.25rem;">
					{t('biodesign.school.modal.title')}
				</h2>
			</div>
			<button class="bd-modal-close" data-close-school-modal aria-label="Cerrar">
				<span class="material-icons">close</span>
			</button>
		</div>
		<div class="bd-modal-body">
			<p class="bd-body-md" style="margin-bottom:1.25rem;">{t('biodesign.school.modal.desc')}</p>

			<div class="bd-school-modal-benefits">
				<div class="bd-school-modal-benefit">
					<span class="material-icons" style="color:var(--bd-primary);">science</span>
					<div>
						<strong>{t('biodesign.school.benefit1.title')}:</strong> {t('biodesign.school.benefit1.desc')}
					</div>
				</div>
				<div class="bd-school-modal-benefit">
					<span class="material-icons" style="color:var(--bd-tertiary);">rocket_launch</span>
					<div>
						<strong>{t('biodesign.school.benefit2.title')}:</strong> {t('biodesign.school.benefit2.desc')}
					</div>
				</div>
				<div class="bd-school-modal-benefit">
					<span class="material-icons" style="color:var(--bd-secondary);">workspace_premium</span>
					<div>
						<strong>{t('biodesign.school.benefit3.title')}:</strong> {t('biodesign.school.benefit3.desc')}
					</div>
				</div>
			</div>

			<div class="bd-school-modal-contact-card">
				<h3 class="bd-label-md" style="color:var(--bd-text-primary); margin-bottom:0.35rem;">
					<span class="material-icons" style="font-size:1rem; vertical-align:middle; color:var(--bd-tertiary);">contact_mail</span>
					{t('biodesign.school.modal.contact_title')}
				</h3>
				<p class="bd-caption" style="color:var(--bd-on-surface-variant); margin:0 0 0.85rem;">
					{t('biodesign.school.modal.contact_subtitle')}
				</p>
				<div class="bd-school-contact-actions">
					<a
						href={`mailto:${EMAIL_CONTACT}?subject=Solicitud%20de%20Visita%20Escolar%20-%20BioDesign%202026`}
						class="bd-btn-primary bd-school-email-btn"
					>
						<span class="material-icons" style="font-size:1rem;">mail</span>
						{t('biodesign.school.modal.email_cta')}
					</a>
					<button
						type="button"
						class="bd-btn-ghost bd-copy-btn"
						data-copy-target={EMAIL_CONTACT}
					>
						<span class="material-icons" style="font-size:1rem;">content_copy</span>
						<span class="bd-copy-text">{t('biodesign.school.modal.copy_email')}</span>
					</button>
				</div>
				<div class="bd-school-email-pill">
					<span class="material-icons" style="font-size:0.9rem; color:var(--bd-tertiary);">email</span>
					<code>{EMAIL_CONTACT}</code>
				</div>
			</div>
			<p class="bd-caption" style="color:var(--bd-on-surface-variant); margin-top:0.75rem; text-align:center;">
				{t('biodesign.school.modal.note')}
			</p>
		</div>
		<div class="bd-modal-footer">
			<button class="bd-btn-ghost" data-close-school-modal style="font-size:0.85rem;">
				{t('biodesign.tracks.modal.close')}
			</button>
		</div>
	</div>
</div>

<!-- ═══════════════════════════════════════════
     SECCIÓN DE INAUGURACIÓN PRESENCIAL
     ═══════════════════════════════════════════ -->
<section class="bd-section bd-inauguracion-section" id="inauguracion">
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">celebration</span>
			{t('biodesign.inauguracion.badge')}
		</span>
		<h2 class="bd-headline-lg">
			{t('biodesign.inauguracion.title1')} <span class="bd-gradient-text">{t('biodesign.inauguracion.title2')}</span>
		</h2>
		<p class="bd-body-md" style="max-width:760px; margin:0 auto;">
			{t('biodesign.inauguracion.subtitle')}
		</p>
	</div>

	<!-- Bento Grid de Inauguración (Logística + Mapa) -->
	<div class="bd-inauguracion-bento bd-reveal">
		<!-- Card 1: Datos Logísticos & Alerta de Acceso Puerta 2 -->
		<div class="bd-glass bd-inaug-card bd-inaug-card--info">
			<div class="bd-inaug-header">
				<div class="bd-inaug-icon-wrap">
					<span class="material-icons bd-inaug-icon">location_on</span>
				</div>
				<div>
					<span class="bd-chip bd-chip-teal bd-inaug-badge">UNMSM — CIUDAD UNIVERSITARIA</span>
					<h3 class="bd-headline-md bd-inaug-title">{t('biodesign.inauguracion.lugar.val')}</h3>
				</div>
			</div>

			<!-- Grid de Metadatos de Inauguración -->
			<div class="bd-inaug-meta-grid">
				<div class="bd-inaug-meta-item">
					<span class="material-icons bd-meta-icon">calendar_today</span>
					<div>
						<span class="bd-meta-label">{t('biodesign.inauguracion.fecha.label')}</span>
						<strong class="bd-meta-val">{t('biodesign.inauguracion.fecha.val')}</strong>
					</div>
				</div>
				<div class="bd-inaug-meta-item">
					<span class="material-icons bd-meta-icon">schedule</span>
					<div>
						<span class="bd-meta-label">{t('biodesign.inauguracion.hora.label')}</span>
						<strong class="bd-meta-val">{t('biodesign.inauguracion.hora.val')}</strong>
					</div>
				</div>
			</div>

			<!-- ALERTA CRÍTICA: Puerta N° 2 -->
			<div class="bd-inaug-gate-alert">
				<div class="bd-gate-alert-badge-row">
					<span class="bd-gate-alert-pill">
						<span class="material-icons" style="font-size:13px;">door_front</span>
						{t('biodesign.inauguracion.puerta.badge')}
					</span>
				</div>
				<h4 class="bd-gate-alert-title">
					<span class="material-icons bd-gate-alert-icon">warning_amber</span>
					{t('biodesign.inauguracion.puerta.title')}
				</h4>
				<p class="bd-gate-alert-desc">
					{t('biodesign.inauguracion.puerta.desc')}
				</p>
			</div>

			<!-- Lista de Indicaciones Clave -->
			<ul class="bd-inaug-guidelines">
				<li class="bd-inaug-guide-item">
					<span class="material-icons bd-guide-icon">badge</span>
					<div>
						<strong>{t('biodesign.inauguracion.dni.title')}:</strong> {t('biodesign.inauguracion.dni.desc')}
					</div>
				</li>
				<li class="bd-inaug-guide-item">
					<span class="material-icons bd-guide-icon">groups</span>
					<div>
						<strong>{t('biodesign.inauguracion.delegacion.title')}:</strong> {t('biodesign.inauguracion.delegacion.desc')}
					</div>
				</li>
			</ul>

			<div class="bd-inaug-support-row">
				<span class="material-icons" style="font-size:15px; color:var(--bd-primary);">help_outline</span>
				<span class="bd-caption">{t('biodesign.inauguracion.support')}</span>
			</div>
		</div>

		<!-- Card 2: Mapa Satelital/Interactivo con Zoom en la Facultad -->
		<div class="bd-glass bd-inaug-card bd-inaug-card--map">
			<div class="bd-map-header">
				<div class="bd-map-header-left">
					<span class="material-icons" style="color:var(--bd-primary);">map</span>
					<span class="bd-map-title">{t('biodesign.inauguracion.map.title')}</span>
				</div>
				<span class="bd-chip bd-chip-lime bd-map-tag">
					<span class="material-icons" style="font-size:12px;">door_front</span>
					Puerta N° 2 (Acceso)
				</span>
			</div>

			<div class="bd-map-frame-wrapper">
				<iframe
					src="https://maps.google.com/maps?q=Facultad%20de%20Ciencias%20Matem%C3%A1ticas%20UNMSM&t=&z=17&ie=UTF8&iwloc=&output=embed"
					class="bd-map-iframe"
					loading="lazy"
					title="Mapa de Ubicación: Facultad de Ciencias Matemáticas UNMSM"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
				<div class="bd-map-overlay-badge">
					<span class="material-icons" style="font-size:14px; color:var(--bd-tertiary);">pin_drop</span>
					<span>Facultad de Ciencias Matemáticas</span>
				</div>
			</div>

			<div class="bd-map-footer">
				<a
					href="https://www.google.com/maps/search/?api=1&query=Facultad+de+Ciencias+Matem%C3%A1ticas+UNMSM"
					target="_blank"
					rel="noopener noreferrer"
					class="bd-btn-primary bd-map-cta-btn"
					id="btn-abrir-google-maps"
				>
					<span class="material-icons" style="font-size:1.1rem;">directions</span>
					{t('biodesign.inauguracion.map.cta')}
				</a>
				<span class="bd-caption bd-map-route-hint">
					<span class="material-icons" style="font-size:12px; vertical-align:middle;">navigation</span>
					{lang === 'es' ? 'Ingreso por Av. Germán Amézaga (Puerta 2) hacia Ciencias Matemáticas' : 'Entry via Av. Germán Amézaga (Gate 2) to Mathematical Sciences'}
				</span>
			</div>
		</div>
	</div>
</section>

<!-- ═══════════════════════════════════════════
     SECCIÓN DE ESTADO DE INSCRIPCIONES
     ═══════════════════════════════════════════ -->
<section class="bd-section bd-inscripcion-section" id="inscripcion">
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-teal" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">task_alt</span>
			{t('biodesign.inscripcion.badge')}
		</span>
		<h2 class="bd-headline-lg">
			{t('biodesign.inscripcion.title1')} <span class="bd-gradient-text">{t('biodesign.inscripcion.title2')}</span>
		</h2>
		<p class="bd-body-md" style="max-width:720px; margin:0 auto;">
			{t('biodesign.inscripcion.subtitle')}
