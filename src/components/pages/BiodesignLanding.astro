		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		padding: 2.25rem 1.75rem;
		border-radius: 1.25rem;
		border: 1px solid rgba(var(--bd-primary-rgb), 0.3);
		background: var(--bd-surface-container);
		transition: transform 0.3s ease, border-color 0.3s ease;
