		height: 100%;
		border-radius: 99px;
		background: linear-gradient(90deg, var(--bd-primary), var(--bd-tertiary));
	}

	.bd-criterio-toggle {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		background: none;
		border: none;
		color: var(--bd-on-surface-variant);
		cursor: pointer;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0;
