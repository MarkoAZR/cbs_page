<style>
	.bd-legacy-anchor {
		position: relative;
		top: -80px;
		display: block;
		height: 0;
		visibility: hidden;
	}

	/* ══════════════════════════════
	   HERO & BENTO KPI BAR
	   ══════════════════════════════ */
	.bd-hero {
		position: relative;
		min-height: calc(100vh - 65px);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.bd-hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.bd-shader-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		z-index: 2;
		display: block;
		transition: opacity 0.8s ease;
	}

	.bd-shader-canvas.active {
		opacity: 0.92;
	}

	.bd-hero-bg.webgl-active .bd-hero-orb {
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.bd-hero-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.4;
	}

	.bd-hero-orb--1 {
		width: clamp(300px, 35vw, 600px);
		height: clamp(300px, 35vw, 600px);
		background: rgba(var(--bd-secondary-container-rgb), 0.2);
		top: 10%;
		left: 20%;
		animation: bd-float 8s ease-in-out infinite;
	}

	.bd-hero-orb--2 {
		width: clamp(200px, 25vw, 400px);
		height: clamp(200px, 25vw, 400px);
		background: rgba(var(--bd-primary-rgb), 0.15);
		bottom: 20%;
		right: 15%;
		animation: bd-float 6s ease-in-out infinite;
		animation-delay: -2s;
	}

	.bd-hero-orb--3 {
		width: clamp(150px, 18vw, 300px);
		height: clamp(150px, 18vw, 300px);
		background: rgba(var(--bd-tertiary-rgb), 0.1);
		top: 60%;
		left: 5%;
		animation: bd-float 10s ease-in-out infinite;
		animation-delay: -4s;
	}

	.bd-hero-content {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		align-items: center;
		gap: clamp(2rem, 5vw, 4rem);
		padding-top: clamp(2.5rem, 5vw, 5rem);
		padding-bottom: clamp(2.5rem, 4vw, 4.5rem);
		width: 100%;
	}

	.bd-hero-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.bd-hero-top-badges {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

