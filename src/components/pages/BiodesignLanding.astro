	/* Light Mode Overrides */
	:root:not(.dark) .bd-hero-kpi-bento {
		background: rgba(255, 255, 255, 0.9);
		border-color: rgba(5, 150, 105, 0.25);
		box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
	}
	:root:not(.dark) .bd-hero-kpi-item {
		border-right-color: rgba(15, 23, 42, 0.08);
	}
	:root:not(.dark) .bd-ally-card,
	:root:not(.dark) .bd-org-card,
	:root:not(.dark) .bd-step-card,
	:root:not(.dark) .bd-prog-details,
	:root:not(.dark) .bd-sesion-card {
		background: rgba(255, 255, 255, 0.95);
		border-color: rgba(15, 23, 42, 0.1);
	}
	:root:not(.dark) .bd-native-dialog {
		background: #ffffff;
		color: #0f172a;
	}
</style>

<script is:inline>
	// ── WebGL Hero Shader ─────────────────────────────────────────
	function initBdShader() {
		const canvas = document.getElementById('bd-shader-canvas');
		if (!canvas) return;

		function syncSize() {
			const w = canvas.clientWidth || 1280;
			const h = canvas.clientHeight || 720;
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
			}
		}
		if (typeof ResizeObserver !== 'undefined') {
			new ResizeObserver(syncSize).observe(canvas);
		}
		syncSize();

		const gl = canvas.getContext('webgl', { alpha: true, antialias: true }) || canvas.getContext('experimental-webgl');
		if (!gl) return;

		const vs = `attribute vec2 a_position;
varying vec2 v_texCoord;
void main() {
  v_texCoord = a_position * 0.5 + 0.5;
  gl_Position = vec4(a_position, 0.0, 1.0);
}`;
		const fs = `precision highp float;
varying vec2 v_texCoord;
uniform float u_time;
uniform vec2 u_resolution;
uniform vec2 u_mouse;
uniform float u_dark;

float hash(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

void main() {
  vec2 uv = v_texCoord;
  vec2 mouse = u_mouse / u_resolution;

  vec2 grid = uv * 22.0;
  vec2 id = floor(grid);
  vec2 f = fract(grid) - 0.5;

  float particles = 0.0;
  float halos = 0.0;

  for(float y=-1.0; y<=1.0; y++) {
    for(float x=-1.0; x<=1.0; x++) {
      vec2 offs = vec2(x, y);
      float n = hash(id + offs);
      vec2 p = offs + vec2(sin(u_time * 0.45 + n * 6.28), cos(u_time * 0.38 + n * 4.71)) * 0.38;
      float d = length(f - p);

      float mDist = length(uv - mouse);
      float mScale = smoothstep(0.32, 0.0, mDist) * 0.55;

      float coreSize = (0.035 + n * 0.045) * (1.0 + mScale);
      float haloSize = coreSize * 2.8;

      float core = smoothstep(coreSize, 0.0, d);
      float halo = smoothstep(haloSize, 0.0, d) * 0.45;

      particles += core * (0.65 + n * 0.35);
      halos += halo * n;
    }
  }

  vec3 darkBg       = vec3(0.075, 0.067, 0.125);
  vec3 darkTeal     = vec3(0.475, 0.973, 0.816);
  vec3 darkPurple   = vec3(0.784, 0.749, 1.000);
  vec3 darkParticle = mix(darkTeal, darkPurple, sin(u_time * 0.25 + uv.x * 2.5) * 0.5 + 0.5);

  vec3 colDark = darkBg;
  colDark += (particles + halos * 0.5) * darkParticle * 0.85;
  colDark += darkPurple * (1.0 - uv.y) * 0.10;

  vec3 lightBg       = vec3(0.973, 0.976, 0.988);
  vec3 lightEmerald  = vec3(0.020, 0.588, 0.412);
  vec3 lightViolet   = vec3(0.388, 0.267, 0.831);
  vec3 lightOlive    = vec3(0.302, 0.486, 0.059);

  float cycle = sin(u_time * 0.2 + uv.x * 3.0 + uv.y) * 0.5 + 0.5;
  vec3 lightParticle = mix(lightEmerald, mix(lightViolet, lightOlive, sin(u_time * 0.25 + uv.y * 2.0) * 0.5 + 0.5), cycle);

  vec3 colLight = lightBg;
  colLight -= vec3(0.012, 0.010, 0.005) * (1.0 - uv.y);
  float lightDensity = clamp(particles * 0.75 + halos * 0.3, 0.0, 1.0);
  colLight = mix(colLight, lightParticle, lightDensity * 0.65);

  vec3 color = mix(colLight, colDark, u_dark);
  gl_FragColor = vec4(color, 1.0);
}`;

		function createShader(type, src) {
			const s = gl.createShader(type);
			gl.shaderSource(s, src);
			gl.compileShader(s);
			return s;
		}
		const prog = gl.createProgram();
		gl.attachShader(prog, createShader(gl.VERTEX_SHADER, vs));
		gl.attachShader(prog, createShader(gl.FRAGMENT_SHADER, fs));
		gl.linkProgram(prog);
		gl.useProgram(prog);

		const buf = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buf);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
		const pos = gl.getAttribLocation(prog, 'a_position');
		gl.enableVertexAttribArray(pos);
		gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

		const uTime  = gl.getUniformLocation(prog, 'u_time');
		const uRes   = gl.getUniformLocation(prog, 'u_resolution');
		const uMouse = gl.getUniformLocation(prog, 'u_mouse');
		const uDark  = gl.getUniformLocation(prog, 'u_dark');

		let mouse = { x: canvas.width / 2, y: canvas.height / 2 };
		window.addEventListener('mousemove', e => {
			const rect = canvas.getBoundingClientRect();
			if (rect.width && rect.height) {
				mouse.x = ((e.clientX - rect.left) / rect.width) * canvas.width;
				mouse.y = (1.0 - (e.clientY - rect.top) / rect.height) * canvas.height;
			}
		}, { passive: true });

		canvas.classList.add('active');
		const heroBg = canvas.closest('.bd-hero-bg');
		if (heroBg) heroBg.classList.add('webgl-active');

		let currentDark = document.documentElement.classList.contains('dark') ? 1.0 : 0.0;
		let rafId = null;
		function render(t) {
			if (typeof ResizeObserver === 'undefined') syncSize();
			gl.viewport(0, 0, canvas.width, canvas.height);

			const targetDark = document.documentElement.classList.contains('dark') ? 1.0 : 0.0;
			currentDark += (targetDark - currentDark) * 0.08;

			if (uTime)  gl.uniform1f(uTime, t * 0.001);
			if (uRes)   gl.uniform2f(uRes, canvas.width, canvas.height);
			if (uMouse) gl.uniform2f(uMouse, mouse.x, mouse.y);
			if (uDark)  gl.uniform1f(uDark, currentDark);

			gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
			rafId = requestAnimationFrame(render);
		}
		render(0);
		document.addEventListener('astro:before-swap', () => {
			if (rafId) cancelAnimationFrame(rafId);
		}, { once: true });
	}

	// ── Scroll Reveal ─────────────────────────────────────────────
	function initBdReveal() {
		const elements = document.querySelectorAll('.bd-reveal');
		if (!elements.length) return;
		const observer = new IntersectionObserver((entries, obs) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					obs.unobserve(entry.target);
				}
			});
		}, { root: null, threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
		elements.forEach(el => observer.observe(el));
	}

	// ── Native <dialog> Modals (Tracks & School Visit 2027) ───────
	function initBdDialogs() {
		const trackCards = document.querySelectorAll('[data-track-id]');

		function openDialog(dialogEl) {
			if (!dialogEl) return;
			if (typeof dialogEl.showModal === 'function') {
				dialogEl.showModal();
			} else {
				dialogEl.setAttribute('open', '');
			}
		}

		function closeDialog(dialogEl) {
			if (!dialogEl) return;
			if (typeof dialogEl.close === 'function') {
				dialogEl.close();
			} else {
				dialogEl.removeAttribute('open');
			}
		}

		trackCards.forEach(card => {
			card.addEventListener('click', () => {
				const dlg = document.getElementById(`modal-${card.dataset.trackId}`);
				openDialog(dlg);
			});
			card.addEventListener('keydown', e => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					const dlg = document.getElementById(`modal-${card.dataset.trackId}`);
					openDialog(dlg);
				}
			});
		});

		document.querySelectorAll('[data-close-modal]').forEach(btn => {
			btn.addEventListener('click', () => {
				const dlg = btn.closest('dialog');
				closeDialog(dlg);
			});
		});

		// School Visit 2027 Dialog
		const openSchoolBtn = document.getElementById('open-school-modal');
		const schoolDialog = document.getElementById('modal-colegios');
		if (openSchoolBtn && schoolDialog) {
			openSchoolBtn.addEventListener('click', () => openDialog(schoolDialog));
			schoolDialog.querySelectorAll('[data-close-school-modal]').forEach(btn => {
				btn.addEventListener('click', () => closeDialog(schoolDialog));
			});
		}

		// Backdrop click closes any <dialog.bd-native-dialog>
		document.querySelectorAll('dialog.bd-native-dialog').forEach(dlg => {
			dlg.addEventListener('click', e => {
				if (e.target === dlg) closeDialog(dlg);
			});
		});
	}

	// ── Rubrica Accordion + Auto-Open Details on Hash Navigation ──
	function initBdRubrica() {
		const toggles = document.querySelectorAll('.bd-criterio-toggle');
		toggles.forEach(toggle => {
			toggle.addEventListener('click', () => {
				const bodyId = toggle.getAttribute('aria-controls');
				const body = document.getElementById(bodyId);
				if (!body) return;
				const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', String(!isExpanded));
				const textEl = toggle.querySelector('.bd-criterio-toggle-text');
				if (textEl) {
					textEl.textContent = isExpanded
						? (document.documentElement.lang === 'en' ? 'View performance levels' : 'Ver niveles de desempeño')
						: (document.documentElement.lang === 'en' ? 'Hide levels' : 'Ocultar niveles');
				}
				body.hidden = isExpanded;
			});
		});

		// If URL hash points to #tracks, #rubrica, or #sesiones, open that <details> automatically
		function checkHashDetails() {
			const hash = window.location.hash.replace('#', '');
			if (hash === 'tracks' || hash === 'rubrica' || hash === 'sesiones') {
				const el = document.getElementById(hash);
				if (el && el.tagName === 'DETAILS') {
					el.open = true;
				}
			}
		}
		checkHashDetails();
		window.addEventListener('hashchange', checkHashDetails);
	}

	// ── Copy Buttons (Email clipboard with feedback) ───────────────
	function initBdCopyButtons() {
		const copyBtns = document.querySelectorAll('.bd-copy-btn');
		copyBtns.forEach(btn => {
			btn.addEventListener('click', async () => {
				const textToCopy = btn.dataset.copyTarget;
				if (!textToCopy) return;

				try {
					await navigator.clipboard.writeText(textToCopy);
					const labelEl = btn.querySelector('.bd-copy-text');
					const origText = labelEl ? labelEl.textContent : '';
					const isEn = document.documentElement.lang === 'en';
					if (labelEl) labelEl.textContent = isEn ? 'Copied!' : '¡Copiado!';
					btn.style.borderColor = 'var(--bd-tertiary)';

					setTimeout(() => {
						if (labelEl) labelEl.textContent = origText;
						btn.style.borderColor = '';
					}, 2000);
				} catch (err) {
					console.error('Clipboard copy failed:', err);
				}
			});
		});
	}

	initBdShader();
	initBdReveal();
	initBdDialogs();
	initBdRubrica();
	initBdCopyButtons();
	document.addEventListener('astro:after-swap', () => {
		initBdShader();
		initBdReveal();
		initBdDialogs();
		initBdRubrica();
		initBdCopyButtons();
	});
</script>
