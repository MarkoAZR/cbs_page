		font-size: 0.72rem;
		font-weight: 600;
		color: var(--bd-on-surface-variant);
		margin-top: 0.2rem;
		line-height: 1.2;
	}

	.bd-hero-actions {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.bd-hero-cta-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.bd-hero-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		font-size: 0.92rem;
		text-decoration: none;
	}

	.bd-hero-sub-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--bd-on-surface-variant);
	}

	.bd-hero-status-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-weight: 600;
	}

	.bd-hero-sep {
		opacity: 0.4;
	}

	.bd-hero-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bd-hero-img-glow {
		position: absolute;
		width: 320px;
		height: 320px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(var(--bd-primary-rgb), 0.25) 0%, rgba(var(--bd-secondary-rgb), 0.12) 50%, transparent 70%);
		filter: blur(45px);
		pointer-events: none;
	}

	.bd-hero-img {
		position: relative;
		z-index: 1;
		width: clamp(220px, 28vw, 380px);
		height: auto;
		object-fit: contain;
		filter: drop-shadow(0 16px 40px rgba(0, 0, 0, 0.45));
		animation: bd-float 7s ease-in-out infinite;
	}

	@media (max-width: 900px) {
		.bd-hero-content {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.bd-hero-text {
			align-items: center;
		}
		.bd-hero-top-badges,
		.bd-hero-cta-buttons,
		.bd-hero-sub-actions {
			justify-content: center;
		}
		.bd-hero-visual {
			order: -1;
		}
		.bd-hero-img {
			width: clamp(160px, 36vw, 230px);
		}
	}

	@media (max-width: 767px) {
		.bd-hero-kpi-bento {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
			padding: 0.65rem 0.85rem;
			max-height: 165px;
		}
		.bd-hero-kpi-item {
			border-right: none;
			padding: 0.25rem 0.4rem;
			background: rgba(255, 255, 255, 0.03);
			border-radius: 10px;
			text-align: center;
		}
		.bd-hero-kpi-num {
			font-size: 1.25rem;
		}
		.bd-hero-kpi-lbl {
			font-size: 0.68rem;
		}
		.bd-hero-cta-buttons {
			flex-direction: column;
			width: 100%;
		}
		.bd-hero-btn {
			width: 100%;
			justify-content: center;
		}
	}

	/* ══════════════════════════════
	   SECCIÓN #PROGRAMA: STEPPER 4 PASOS & ACORDEONES
	   ══════════════════════════════ */
	.bd-program-stepper {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-top: 2.25rem;
	}

	@media (max-width: 980px) {
		.bd-program-stepper {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.bd-program-stepper {
			grid-template-columns: 1fr;
		}
	}

	.bd-step-card {
		padding: 1.25rem 1.3rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		position: relative;
		border: 1px solid rgba(var(--bd-primary-rgb), 0.22);
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.bd-step-card:hover {
		transform: translateY(-3px);
		border-color: rgba(var(--bd-primary-rgb), 0.5);
	}

	.bd-step-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.bd-step-num-badge {
		font-family: 'Space Grotesk', monospace;
		font-size: 0.78rem;
		font-weight: 800;
		padding: 0.2rem 0.55rem;
		border-radius: 8px;
		background: rgba(var(--bd-primary-rgb), 0.14);
		color: var(--bd-primary);
	}

	.bd-step-done-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.7rem;
		font-weight: 700;
		color: #10b981;
		background: rgba(16, 185, 129, 0.12);
		padding: 0.18rem 0.55rem;
		border-radius: 999px;
	}

	.bd-step-title-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.15rem;
	}

	.bd-step-icon {
		font-size: 1.25rem;
		color: var(--bd-tertiary);
	}

	.bd-step-title {
		font-size: 0.98rem;
		margin: 0;
		color: var(--bd-text-primary);
	}

	.bd-step-desc {
		color: var(--bd-on-surface-variant);
		margin: 0;
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.bd-step-dates {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.55rem;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--bd-text-primary);
	}

	/* ── Bloques Desplegables de Metodología (<details>) ── */
	.bd-prog-accordions-wrap {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 2rem;
	}

	.bd-prog-details {
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		transition: border-color 0.25s ease;
	}

	.bd-prog-details[open] {
		border-color: rgba(var(--bd-primary-rgb), 0.38);
	}

	.bd-prog-summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.15rem 1.4rem;
		user-select: none;
	}

	.bd-prog-summary::-webkit-details-marker {
		display: none;
	}

	.bd-prog-sum-left {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.bd-prog-sum-icon {
		font-size: 1.5rem;
		flex-shrink: 0;
	}

	.bd-prog-sum-title {
		display: block;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.02rem;
		color: var(--bd-text-primary);
	}

	.bd-prog-sum-sub {
		display: block;
		color: var(--bd-on-surface-variant);
		margin-top: 0.15rem;
	}

	.bd-prog-sum-right {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex-shrink: 0;
	}

	.bd-prog-chevron {
		color: var(--bd-on-surface-variant);
		transition: transform 0.25s ease;
	}

	.bd-prog-details[open] .bd-prog-chevron {
		transform: rotate(180deg);
	}

	.bd-prog-details-body {
		padding: 0.5rem 1.4rem 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
	}

	/* ── Tracks Archive Cards inside Details ── */
	.bd-tracks-archive-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-top: 1rem;
	}

	@media (max-width: 900px) {
		.bd-tracks-archive-grid {
			grid-template-columns: 1fr;
		}
	}

	.bd-track-archive-card {
		padding: 1.4rem;
		border-radius: 16px;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.bd-track-archive-card:hover {
		transform: translateY(-4px);
		border-color: rgba(var(--bd-primary-rgb), 0.45);
	}

	.bd-track-archive-top {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.bd-track-archive-icon-wrap {
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.05);
