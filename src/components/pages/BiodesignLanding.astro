<!-- ═══════════════════════════════════════════
     ALIADOS / SPONSORS SECTION
     ═══════════════════════════════════════════ -->
<section class="bd-section bd-aliados-section" id="aliados">

	<!-- Comité Organizador (CBS-UNMSM & NEA) — ubicado encima de SENAJU -->
	<div class="bd-reveal" style="margin-bottom: 4.5rem;">
		<div class="bd-section-header" style="text-align:center;">
			<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
				<span class="material-icons" style="font-size:14px;">groups</span>
				{lang === 'es' ? 'LIDERAZGO CIENTÍFICO' : 'SCIENTIFIC LEADERSHIP'}
			</span>
			<h2 class="bd-headline-lg">{t('biodesign.aliados.org.title')}</h2>
			<p class="bd-body-md" style="max-width:680px; margin:0 auto;">{t('biodesign.aliados.org.subtitle')}</p>
		</div>

		<div class="bd-org-grid">
			{organizers.map((org) => (
				<div class="bd-glass bd-org-card">
					<div class="bd-org-logo-wrap">
						<img src={org.logo} alt={org.name} class="bd-org-logo" width="72" height="72" loading="lazy" />
					</div>
					<span class="bd-chip bd-chip-teal bd-org-badge">{org.badge}</span>
					<h3 class="bd-headline-md bd-org-name">{org.name}</h3>
					<p class="bd-body-md bd-org-desc">{org.desc}</p>
				</div>
			))}
		</div>
	</div>



	<!-- Allied Organizations — Continuous Cosmic Carousel -->
	<div class="bd-reveal" style="margin-top: 5rem;">
		<h2 class="bd-headline-lg bd-gradient-text" style="text-align: center;">
			{t('biodesign.aliados.allies.title')}
		</h2>
		<p class="bd-body-md" style="text-align: center; max-width: 540px; margin: 0 auto 2.5rem;">
			{t('biodesign.aliados.allies.subtitle')}
		</p>
		
		<div class="bd-allies-carousel-wrapper" aria-label="Carrusel de Organizaciones Aliadas">
			<div class="bd-allies-carousel-track">
				{/* Loop 1 */}
				{alliedOrgs.map(org => (
					<div class="bd-glass bd-ally-card">
						<div class="bd-ally-logo-wrap">
							<img
								src={org.logo}
								alt={org.name}
								class="bd-ally-logo"
								width="120"
								height="80"
								loading="lazy"
							/>
						</div>
						<h3 class="bd-headline-md bd-ally-name">{org.name}</h3>
						<p class="bd-body-md bd-ally-desc">{org.desc}</p>
					</div>
				))}
				{/* Loop 2 (Duplicación para loop infinito continuo) */}
				{alliedOrgs.map(org => (
					<div class="bd-glass bd-ally-card" aria-hidden="true" tabindex="-1">
						<div class="bd-ally-logo-wrap">
							<img
								src={org.logo}
								alt=""
								class="bd-ally-logo"
								width="120"
								height="80"
								loading="lazy"
							/>
						</div>
						<h3 class="bd-headline-md bd-ally-name">{org.name}</h3>
						<p class="bd-body-md bd-ally-desc">{org.desc}</p>
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- Sponsors CTA Card (Oculta tiers vacíos y muestra la tarjeta llamativa) -->
	<div class="bd-reveal" style="margin-top: 5rem;">
		<div class="bd-glass bd-sponsors-cta-card">
			<div class="bd-sponsors-cta-ambient" aria-hidden="true"></div>
			<div class="bd-sponsors-cta-content">
				<span class="bd-chip bd-chip-lime" style="margin-bottom:0.75rem;">
					<span class="material-icons" style="font-size:13px;">star</span>
					{t('biodesign.aliados.sponsors.card.tag')}
				</span>
				<h2 class="bd-headline-md bd-gradient-text" style="font-size:clamp(1.25rem, 2.5vw, 1.75rem); margin:0 0 0.75rem;">
					{t('biodesign.aliados.sponsors.card.title')}
				</h2>
				<p class="bd-body-md" style="max-width:620px; margin:0 auto 1.75rem; color:var(--bd-on-surface-variant);">
					{t('biodesign.aliados.sponsors.card.subtitle')}
				</p>
				<div class="bd-sponsors-cta-actions">
					<a
						href={LINKEDIN_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="bd-btn-primary bd-sponsors-btn-linkedin"
					>
						<svg class="bd-linkedin-svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
							<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25a1.62 1.62 0 0 0-1.63 1.62 1.63 1.63 0 0 0 1.63 1.63 1.63 1.63 0 0 0 1.63-1.63c0-.9-.73-1.62-1.63-1.62Z"/>
						</svg>
						{t('biodesign.aliados.sponsors.card.linkedin')}
					</a>
					<a
						href={`mailto:${EMAIL_CONTACT}?subject=Propuesta%20de%20Auspicio%20-%20BioDesign%202026`}
						class="bd-btn-ghost bd-sponsors-btn-email"
					>
						<span class="material-icons" style="font-size:1.1rem;">mail</span>
						{t('biodesign.aliados.sponsors.card.email')}
					</a>
					<button
						type="button"
						class="bd-btn-ghost bd-copy-btn bd-sponsors-copy-btn"
						data-copy-target={EMAIL_CONTACT}
						aria-label="Copiar correo"
					>
						<span class="material-icons" style="font-size:1rem;">content_copy</span>
						<span class="bd-copy-text">{EMAIL_CONTACT}</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* ══════════════════════════════
	   TRACKS
	   ══════════════════════════════ */
	.bd-tracks-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 2vw, 1.5rem);
		margin-top: 3rem;
	}

	.bd-track-card {
		padding: clamp(1.5rem, 3vw, 2.25rem);
		border-radius: 1.25rem;
		cursor: pointer;
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.bd-track-card--teal  { border-color: rgba(var(--bd-primary-rgb), 0.25); }
	.bd-track-card--purple { border-color: rgba(var(--bd-secondary-rgb), 0.25); }
	.bd-track-card--lime  { border-color: rgba(var(--bd-tertiary-rgb), 0.25); }

	.bd-track-card--teal:hover  { border-color: rgba(var(--bd-primary-rgb), 0.6); box-shadow: 0 0 40px rgba(var(--bd-primary-rgb), 0.18); transform: translateY(-6px) scale(1.01); }
	.bd-track-card--purple:hover { border-color: rgba(var(--bd-secondary-rgb), 0.6); box-shadow: 0 0 40px rgba(var(--bd-secondary-rgb), 0.18); transform: translateY(-6px) scale(1.01); }
	.bd-track-card--lime:hover  { border-color: rgba(var(--bd-tertiary-rgb), 0.6); box-shadow: 0 0 40px rgba(var(--bd-tertiary-rgb), 0.18); transform: translateY(-6px) scale(1.01); }

	.bd-track-number {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.5rem, 4vw, 4rem);
		font-weight: 800;
		line-height: 1;
		color: rgba(255,255,255,0.04);
		position: absolute;
		top: 1rem;
		right: 1.25rem;
		pointer-events: none;
		user-select: none;
		letter-spacing: -0.04em;
	}

	.bd-track-icon-wrap {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 1rem;
		background: var(--bd-surface-container);
		border: 1px solid rgba(255,255,255,0.08);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.3s ease, background 0.3s;
	}

	.bd-track-card:hover .bd-track-icon-wrap { transform: scale(1.12) rotate(-4deg); }
	.bd-track-card--teal .bd-track-icon   { color: var(--bd-primary); font-size: 1.8rem; }
	.bd-track-card--purple .bd-track-icon { color: var(--bd-secondary); font-size: 1.8rem; }
	.bd-track-card--lime .bd-track-icon   { color: var(--bd-tertiary); font-size: 1.8rem; }

	.bd-track-badge { font-size: 0.68rem; letter-spacing: 0.08em; padding: 0.2rem 0.65rem; }
	.bd-track-title { font-size: clamp(1.05rem, 1.8vw, 1.3rem); margin: 0; }
	.bd-track-tagline { font-size: 0.88rem; color: var(--bd-on-surface-variant); margin: 0; flex: 1; }

	.bd-track-cta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--bd-primary);
		margin-top: 0.5rem;
		opacity: 0;
		transition: opacity 0.3s, transform 0.3s;
		transform: translateY(4px);
	}
	.bd-track-card--purple .bd-track-cta { color: var(--bd-secondary); }
	.bd-track-card--lime .bd-track-cta   { color: var(--bd-tertiary); }
	.bd-track-card:hover .bd-track-cta   { opacity: 1; transform: translateY(0); }

	.bd-track-shimmer {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.04) 50%, rgba(255,255,255,0) 100%);
		transform: translateX(-100%);
		transition: transform 0.6s ease;
		pointer-events: none;
	}
	.bd-track-card:hover .bd-track-shimmer { transform: translateX(100%); }

	@media (max-width: 960px) { .bd-tracks-grid { grid-template-columns: 1fr; } }
	@media (min-width: 600px) and (max-width: 960px) { .bd-tracks-grid { grid-template-columns: repeat(2, 1fr); } }

	/* ── Modales ── */
	.bd-modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.72);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	.bd-modal-overlay:not([hidden]) { opacity: 1; }
	.bd-modal-overlay[hidden] { display: none; }

	.bd-modal {
		background: var(--bd-surface-container-high);
		border-radius: 1.5rem;
		border: 1px solid rgba(var(--bd-secondary-rgb), 0.3);
		max-width: 560px;
		width: 100%;
		max-height: 90dvh;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		transform: scale(0.93);
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
		display: flex;
		flex-direction: column;
	}
	.bd-modal-overlay:not([hidden]) .bd-modal { transform: scale(1); }
	.bd-modal--teal  { border-color: rgba(var(--bd-primary-rgb), 0.4); }
	.bd-modal--purple { border-color: rgba(var(--bd-secondary-rgb), 0.4); }
	.bd-modal--lime  { border-color: rgba(var(--bd-tertiary-rgb), 0.4); }

	.bd-modal-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.5rem 1.5rem 1rem;
		border-bottom: 1px solid rgba(var(--bd-secondary-container-rgb), 0.25);
	}
	.bd-modal-icon { font-size: 2rem; color: var(--bd-primary); flex-shrink: 0; }
	.bd-modal--purple .bd-modal-icon { color: var(--bd-secondary); }
	.bd-modal--lime .bd-modal-icon   { color: var(--bd-tertiary); }

	.bd-modal-close {
		margin-left: auto;
		background: rgba(255,255,255,0.06);
		border: 1px solid rgba(255,255,255,0.1);
		border-radius: 0.5rem;
		color: var(--bd-on-surface-variant);
		cursor: pointer;
		padding: 0.35rem;
		line-height: 1;
		display: flex;
		align-items: center;
		transition: background 0.2s, color 0.2s;
		flex-shrink: 0;
	}
	.bd-modal-close:hover { background: rgba(var(--bd-secondary-rgb),0.2); color: var(--bd-on-surface); }

	.bd-modal-body { padding: 1.25rem 1.5rem; flex: 1; }

	.bd-modal-section-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--bd-on-surface-variant);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.72rem;
		margin-bottom: 0.75rem;
	}
	.bd-modal-retos { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
	.bd-modal-reto-item {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		padding: 0.65rem 0.85rem;
		border-radius: 0.65rem;
		background: rgba(var(--bd-primary-rgb), 0.06);
		border: 1px solid rgba(var(--bd-primary-rgb), 0.15);
		font-size: 0.9rem;
		color: var(--bd-text-primary);
	}
	.bd-modal--purple .bd-modal-reto-item { background: rgba(var(--bd-secondary-rgb), 0.06); border-color: rgba(var(--bd-secondary-rgb), 0.15); }
	.bd-modal--lime   .bd-modal-reto-item { background: rgba(var(--bd-tertiary-rgb), 0.06); border-color: rgba(var(--bd-tertiary-rgb), 0.15); }

	.bd-modal-preguntas { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
	.bd-modal-pregunta-item {
		padding: 0.5rem 0;
		padding-left: 1rem;
		border-left: 2px solid rgba(var(--bd-secondary-rgb), 0.3);
		font-size: 0.88rem;
		color: var(--bd-on-surface-variant);
	}
	.bd-modal-footer {
		padding: 1rem 1.5rem 1.25rem;
		border-top: 1px solid rgba(var(--bd-secondary-container-rgb), 0.2);
		display: flex;
		justify-content: flex-end;
	}

	/* ══════════════════════════════
	   FASES / CRONOGRAMA
	   ══════════════════════════════ */
	.bd-fases-row {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 3rem;
		position: relative;
	}

	.bd-fase-card {
		flex: 1;
		padding: clamp(1.5rem, 3vw, 2.25rem);
		border-radius: 1.5rem;
		position: relative;
		overflow: hidden;
		transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.bd-fase-card:hover {
		transform: translateY(-5px);
	}

	.bd-fase-card--bootcamp {
		border-color: rgba(var(--bd-primary-rgb), 0.3);
	}
	.bd-fase-card--bootcamp:hover {
		border-color: rgba(var(--bd-primary-rgb), 0.6);
		box-shadow: 0 0 35px rgba(var(--bd-primary-rgb), 0.15);
	}

	.bd-fase-card--hackathon {
		border-color: rgba(var(--bd-tertiary-rgb), 0.3);
	}
	.bd-fase-card--hackathon:hover {
		border-color: rgba(var(--bd-tertiary-rgb), 0.6);
		box-shadow: 0 0 35px rgba(var(--bd-tertiary-rgb), 0.15);
	}

	.bd-fase-glow {
		position: absolute;
		top: -30%;
		right: -20%;
		width: 250px;
		height: 250px;
		border-radius: 50%;
		filter: blur(50px);
		pointer-events: none;
		opacity: 0.15;
		transition: opacity 0.3s ease;
	}
	.bd-fase-card--bootcamp .bd-fase-glow { background: var(--bd-primary); }
	.bd-fase-card--hackathon .bd-fase-glow { background: var(--bd-tertiary); }
	.bd-fase-card:hover .bd-fase-glow { opacity: 0.28; }

	.bd-fase-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.bd-fase-step {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 2.25rem;
		font-weight: 900;
		color: rgba(255, 255, 255, 0.08);
		line-height: 1;
		user-select: none;
	}

	.bd-fases-connector {
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		flex-shrink: 0;
		width: 48px;
	}

	.bd-fases-arrow-wrap {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: var(--bd-surface-container-high);
		border: 1px solid rgba(var(--bd-secondary-rgb), 0.3);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--bd-tertiary);
		box-shadow: 0 0 15px rgba(var(--bd-tertiary-rgb), 0.2);
		animation: bd-pulse-arrow 2.5s ease-in-out infinite;
	}

	@keyframes bd-pulse-arrow {
		0%, 100% { transform: scale(1); box-shadow: 0 0 15px rgba(var(--bd-tertiary-rgb), 0.2); }
		50% { transform: scale(1.08); box-shadow: 0 0 25px rgba(var(--bd-tertiary-rgb), 0.45); }
	}

	.bd-fase-dates {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--bd-on-surface);
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(var(--bd-secondary-container-rgb), 0.2);
	}

	.bd-fase-format-badge {
		font-size: 0.68rem;
		padding: 0.2rem 0.55rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.06);
		color: var(--bd-on-surface-variant);
		margin-left: auto;
	}

	@media (max-width: 768px) {
		.bd-fases-row { flex-direction: column; }
		.bd-fases-connector { width: 100%; height: 36px; }
		.bd-fases-arrow-wrap { transform: rotate(90deg); }
		@keyframes bd-pulse-arrow {
			0%, 100% { transform: rotate(90deg) scale(1); }
			50% { transform: rotate(90deg) scale(1.08); }
		}
		.bd-fase-format-badge { margin-left: 0; }
	}

	/* ── Sesiones Grid & Rich Speaker Cards ── */
	.bd-sesiones-header { margin-bottom: 2.25rem; }
	.bd-sesiones-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.15rem;
		margin-top: 1.5rem;
	}

	.bd-sesion-card {
		padding: 1.35rem;
		border-radius: 1.25rem;
		border: 1px solid rgba(var(--bd-secondary-container-rgb), 0.3);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
		background: var(--bd-surface-container);
		position: relative;
	}

	.bd-sesion-card:hover {
		transform: translateY(-5px);
		border-color: rgba(var(--bd-primary-rgb), 0.5);
		box-shadow: 0 0 25px rgba(var(--bd-primary-rgb), 0.14);
	}

	.bd-sesion-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.bd-sesion-fecha {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--bd-primary);
		padding: 0.2rem 0.55rem;
		border-radius: 0.4rem;
		background: rgba(var(--bd-primary-rgb), 0.08);
	}

	.bd-sesion-phase-chip {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		text-transform: uppercase;
	}

	.bd-sesion-phase--bootcamp {
		background: rgba(var(--bd-primary-rgb), 0.15);
		color: var(--bd-primary);
		border: 1px solid rgba(var(--bd-primary-rgb), 0.3);
	}

	.bd-sesion-phase--hackathon {
		background: rgba(var(--bd-tertiary-rgb), 0.15);
		color: var(--bd-tertiary);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.3);
	}

	.bd-sesion-body {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		flex: 1;
	}

	.bd-sesion-icon-wrap {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.6rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 0.15rem;
		transition: transform 0.25s ease;
	}

	.bd-sesion-card:hover .bd-sesion-icon-wrap {
		transform: scale(1.1);
	}

	.bd-sesion-icon {
		font-size: 1.3rem;
		color: var(--bd-primary);
	}

	.bd-sesion-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		margin: 0;
		line-height: 1.35;
	}

	.bd-sesion-desc {
		font-size: 0.78rem;
		color: var(--bd-on-surface-variant);
		line-height: 1.5;
		margin: 0;
	}

	/* Speaker Profile Box */
	.bd-sesion-speaker-profile {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: auto;
		padding-top: 0.75rem;
		border-top: 1px solid rgba(var(--bd-secondary-container-rgb), 0.2);
	}

	.bd-sesion-avatar-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.bd-sesion-avatar-wrap {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		overflow: hidden;
		border: 1.5px solid rgba(var(--bd-primary-rgb), 0.4);
		background: rgba(0, 0, 0, 0.3);
		flex-shrink: 0;
	}

	.bd-sesion-avatar-wrap--stacked {
		margin-right: -10px;
		border-color: rgba(var(--bd-tertiary-rgb), 0.6);
		transition: transform 0.2s ease;
	}

	.bd-sesion-card:hover .bd-sesion-avatar-wrap--stacked:first-child {
		transform: translateX(-2px);
	}
	.bd-sesion-card:hover .bd-sesion-avatar-wrap--stacked:last-child {
		transform: translateX(2px);
	}

	.bd-sesion-avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.bd-sesion-speaker-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.bd-sesion-speaker-name {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bd-sesion-pending {
		color: var(--bd-on-surface-variant);
		font-style: italic;
	}

	.bd-sesion-speaker-meta {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.68rem;
		color: var(--bd-on-surface-variant);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bd-sesion-speaker-org {
		color: var(--bd-tertiary);
		font-weight: 600;
	}

	.bd-sesion-speaker-dot {
		color: rgba(255, 255, 255, 0.2);
	}

	.bd-sesion-speaker-role {
		color: var(--bd-on-surface-variant);
	}

	/* Card Specific Highlights */
	.bd-sesion-card--kickoff {
		border-color: rgba(var(--bd-primary-rgb), 0.4);
		background: linear-gradient(135deg, rgba(var(--bd-primary-rgb), 0.08) 0%, rgba(var(--bd-surface-container), 0.9) 100%);
	}
	.bd-sesion-card--kickoff .bd-sesion-icon { color: var(--bd-primary); }

	.bd-sesion-card--hackathon {
		border-color: rgba(var(--bd-tertiary-rgb), 0.5);
		background: linear-gradient(135deg, rgba(var(--bd-tertiary-rgb), 0.08) 0%, rgba(var(--bd-surface-container), 0.9) 100%);
		box-shadow: 0 0 25px rgba(var(--bd-tertiary-rgb), 0.08);
	}
	.bd-sesion-card--hackathon .bd-sesion-icon { color: var(--bd-tertiary); }
	.bd-sesion-card--hackathon .bd-sesion-fecha {
		color: var(--bd-tertiary);
		background: rgba(var(--bd-tertiary-rgb), 0.12);
	}

	.bd-sesion-card--eval {
		border-color: rgba(var(--bd-secondary-rgb), 0.4);
		background: linear-gradient(135deg, rgba(var(--bd-secondary-rgb), 0.06) 0%, rgba(var(--bd-surface-container), 0.9) 100%);
	}
	.bd-sesion-card--eval .bd-sesion-icon { color: var(--bd-secondary); }

	.bd-sesion-card--open {
		border-color: rgba(var(--bd-primary-rgb), 0.55);
		background: linear-gradient(135deg, rgba(var(--bd-primary-rgb), 0.12) 0%, rgba(var(--bd-surface-container), 0.9) 100%);
		box-shadow: 0 0 30px rgba(var(--bd-primary-rgb), 0.18);
	}
	.bd-sesion-card--open .bd-sesion-icon { color: var(--bd-primary); }
	.bd-sesion-card--open .bd-sesion-fecha {
		color: var(--bd-primary);
		background: rgba(var(--bd-primary-rgb), 0.15);
		font-weight: 700;
	}

	.bd-sesion-card--clausura {
		border-color: rgba(251, 191, 36, 0.5);
		background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(var(--bd-surface-container), 0.9) 100%);
		box-shadow: 0 0 30px rgba(251, 191, 36, 0.15);
	}
	.bd-sesion-card--clausura .bd-sesion-icon { color: #fbbf24; }
	.bd-sesion-card--clausura .bd-sesion-fecha {
		color: #fbbf24;
		background: rgba(251, 191, 36, 0.15);
	}

	@media (max-width: 1200px) { .bd-sesiones-grid { grid-template-columns: repeat(3, 1fr); } }
	@media (max-width: 820px)   { .bd-sesiones-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 520px)   { .bd-sesiones-grid { grid-template-columns: 1fr; } }

	/* ══════════════════════════════
	   RÚBRICA
	   ══════════════════════════════ */
	.bd-rubrica-total {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.5rem;
		border-radius: 0.85rem;
		background: rgba(var(--bd-tertiary-rgb), 0.06);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.2);
		max-width: 600px;
		margin: 2rem auto;
	}
	.bd-criterios-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 2rem;
	}
	.bd-criterio-card {
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		border-radius: 1rem;
		transition: border-color 0.3s;
	}
	.bd-criterio-card--live { border-color: rgba(var(--bd-secondary-rgb), 0.3); }
	.bd-criterio-card:hover { border-color: rgba(var(--bd-primary-rgb), 0.4); }

	.bd-criterio-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.bd-criterio-left { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
	.bd-criterio-peso {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--bd-tertiary);
		line-height: 1;
		margin-left: auto;
	}
	.bd-criterio-card--live .bd-criterio-peso { color: var(--bd-secondary); }
	.bd-criterio-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(0.95rem, 1.5vw, 1.15rem);
		font-weight: 600;
		color: var(--bd-text-primary);
		margin: 0 0 1rem;
	}

	/* Barra animada */
	.bd-criterio-bar-wrap { margin-bottom: 1rem; }
	.bd-criterio-bar-track {
		height: 6px;
		border-radius: 99px;
		background: rgba(var(--bd-secondary-container-rgb), 0.3);
		overflow: hidden;
	}
	.bd-criterio-bar-fill {
		height: 100%;
		width: 0;
		border-radius: 99px;
		background: linear-gradient(90deg, var(--bd-primary), var(--bd-tertiary));
		transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-criterio-card.bar-animated .bd-criterio-bar-fill { width: var(--bar-width, 0); }

	/* Toggle acordeón */
	.bd-criterio-toggle {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		background: none;
		border: none;
		color: var(--bd-on-surface-variant);
		cursor: pointer;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 0;
		transition: color 0.2s;
	}
	.bd-criterio-toggle:hover { color: var(--bd-primary); }
	.bd-criterio-toggle-icon { font-size: 1.1rem; transition: transform 0.3s ease; }
	.bd-criterio-toggle[aria-expanded="true"] .bd-criterio-toggle-icon { transform: rotate(180deg); }
	.bd-criterio-toggle[aria-expanded="true"] .bd-criterio-toggle-text::before { content: attr(data-collapse); }

	/* Body acordeón */
	.bd-criterio-body { margin-top: 1.25rem; }
	.bd-niveles-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
	}
	.bd-nivel-card {
		padding: 0.85rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(var(--bd-secondary-container-rgb), 0.25);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.bd-nivel-card--inicio   { border-color: rgba(255,100,100,0.2); }
	.bd-nivel-card--proceso  { border-color: rgba(255,180,50,0.2); }
	.bd-nivel-card--logrado  { border-color: rgba(var(--bd-primary-rgb), 0.25); }
	.bd-nivel-card--destacado { border-color: rgba(var(--bd-tertiary-rgb), 0.35); background: rgba(var(--bd-tertiary-rgb),0.05); }
	.bd-nivel-label {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.bd-nivel-card--inicio   .bd-nivel-label { color: hsl(0,70%,65%); }
	.bd-nivel-card--proceso  .bd-nivel-label { color: hsl(38,85%,60%); }
	.bd-nivel-card--logrado  .bd-nivel-label { color: var(--bd-primary); }
	.bd-nivel-card--destacado .bd-nivel-label { color: var(--bd-tertiary); }
	.bd-nivel-desc { font-size: 0.78rem; color: var(--bd-on-surface-variant); margin: 0; line-height: 1.5; }

	/* ══════════════════════════════
	   ORGANIZING COMMITTEE (CBS & NEA)
	   ══════════════════════════════ */
	.bd-org-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		max-width: 920px;
		margin: 0 auto;
		align-items: stretch;
	}

	.bd-org-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		padding: 2.25rem 1.75rem;
		border-radius: 1.25rem;
		border: 1px solid rgba(var(--bd-primary-rgb), 0.3);
		background: var(--bd-surface-container);
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.bd-org-card:hover {
		transform: translateY(-4px);
		border-color: rgba(var(--bd-primary-rgb), 0.6);
		box-shadow: 0 0 30px rgba(var(--bd-primary-rgb), 0.12);
	}

	.bd-org-logo-wrap {
		width: 72px;
		height: 72px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.04);
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		padding: 0.5rem;
	}

	.bd-org-logo {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		display: block;
	}

	.bd-org-badge {
		font-size: 0.65rem;
		margin-top: 0.25rem;
	}

	.bd-org-name {
		font-size: 1.1rem;
		margin: 0;
		line-height: 1.3;
	}

	.bd-org-desc {
		font-size: 0.82rem;
		color: var(--bd-on-surface-variant);
		margin: 0;
		line-height: 1.55;
		flex-grow: 1;
	}

	@media (max-width: 768px) {
		.bd-org-grid { grid-template-columns: 1fr; max-width: 480px; }
	}

	/* ══════════════════════════════
	   SENAJU BANNER
	   ══════════════════════════════ */
	.bd-senaju-banner {
		position: relative;
		border-radius: 1.5rem;
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.4);
		padding: clamp(1.75rem, 4vw, 2.5rem);
		overflow: hidden;
		background: linear-gradient(135deg, rgba(var(--bd-tertiary-rgb), 0.06) 0%, rgba(var(--bd-primary-rgb), 0.04) 100%);
	}
	.bd-senaju-banner-inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 3vw, 3rem);
	}
	.bd-senaju-logo-wrap {
		flex-shrink: 0;
		padding: 1rem 1.25rem;
		background: rgba(255,255,255,0.06);
		border-radius: 1rem;
		border: 1px solid rgba(255,255,255,0.1);
	}
	.bd-senaju-logo {
		display: block;
		width: auto;
		height: 52px;
		object-fit: contain;
		filter: brightness(1.1);
	}
	.bd-senaju-badge { margin-bottom: 0.75rem; }
	.bd-senaju-title { margin: 0.5rem 0; }
	.bd-senaju-glow {
		position: absolute;
		width: 350px;
		height: 350px;
		background: rgba(var(--bd-tertiary-rgb), 0.12);
		border-radius: 50%;
		filter: blur(80px);
		top: -50%;
		right: -5%;
		pointer-events: none;
	}
	@media (max-width: 640px) {
		.bd-senaju-banner-inner { flex-direction: column; text-align: center; }
		.bd-senaju-logo-wrap { align-self: center; }
	}

	/* ══════════════════════════════
	   ALLIES REAL LOGOS
	   ══════════════════════════════ */
	/* ── Allies Continuous Cosmic Marquee / Carousel ── */
	.bd-allies-carousel-wrapper {
		width: 100%;
		overflow: hidden;
		position: relative;
		padding: 1.5rem 0 2rem;
		mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
	}

	.bd-allies-carousel-track {
		display: flex;
		gap: 2rem;
		width: max-content;
		animation: bd-allies-scroll 26s linear infinite;
	}

	.bd-allies-carousel-wrapper:hover .bd-allies-carousel-track,
	.bd-allies-carousel-wrapper:focus-within .bd-allies-carousel-track {
		animation-play-state: paused;
	}

	@keyframes bd-allies-scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.bd-ally-card {
		width: 290px;
		min-height: 240px;
		flex-shrink: 0;
		padding: 2rem 1.75rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		border-radius: 20px;
		border: 1px solid rgba(var(--bd-secondary-container-rgb), 0.25);
		background: rgba(28, 25, 42, 0.75);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
	}

	:root:not(.dark) .bd-ally-card {
		background: rgba(255, 255, 255, 0.95);
		border-color: rgba(0, 0, 0, 0.08);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
	}

	.bd-ally-card:hover {
		transform: translateY(-6px);
		border-color: rgba(var(--bd-primary-rgb), 0.5);
		box-shadow: 0 14px 35px rgba(0, 0, 0, 0.45), 0 0 25px rgba(var(--bd-primary-rgb), 0.15);
	}

	.bd-ally-logo-wrap {
		height: 75px;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.25rem;
		padding: 0.5rem;
		box-sizing: border-box;
	}

	.bd-ally-logo {
		max-height: 64px;
		max-width: 140px;
		width: auto;
		object-fit: contain;
		border-radius: 0.5rem;
		filter: brightness(0.95) saturate(0.95);
		transition: filter 0.3s, transform 0.3s;
	}

	.bd-ally-card:hover .bd-ally-logo {
		filter: brightness(1) saturate(1.1);
		transform: scale(1.05);
	}

	.bd-ally-name {
		font-size: 1.1rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		color: var(--bd-text-primary);
	}

	.bd-ally-desc {
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--bd-on-surface-variant);
		margin: 0;
	}
	/* ══════════════════════════════
	   HERO TOP BADGES & SCHOOL PILL
	   ══════════════════════════════ */
	.bd-hero-top-badges {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.bd-school-pill-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.85rem;
		min-height: 36px;
		max-width: 100%;
		box-sizing: border-box;
		border-radius: 9999px;
		background: rgba(var(--bd-tertiary-rgb), 0.08);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.35);
		color: var(--bd-text-primary);
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		overflow: hidden;
		text-align: left;
		text-decoration: none;
	}

	.bd-school-pill-btn:hover {
		background: rgba(var(--bd-tertiary-rgb), 0.16);
		border-color: rgba(var(--bd-tertiary-rgb), 0.7);
		transform: translateY(-2px);
		box-shadow: 0 0 20px rgba(var(--bd-tertiary-rgb), 0.25);
	}

	.bd-school-pill-icon {
		font-size: 1rem;
		color: var(--bd-tertiary);
		flex-shrink: 0;
	}

	.bd-school-pill-tag {
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		background: rgba(var(--bd-tertiary-rgb), 0.25);
		color: var(--bd-tertiary);
		text-transform: uppercase;
		flex-shrink: 0;
	}

	.bd-school-pill-text {
		color: var(--bd-on-surface);
	}

	.bd-school-pill-arrow {
		font-size: 0.9rem;
		color: var(--bd-tertiary);
		transition: transform 0.2s ease;
	}

	.bd-school-pill-btn:hover .bd-school-pill-arrow {
		transform: translateX(3px);
	}

	/* ── School Modal Specifics (Mobile-First) ── */
	.bd-school-modal {
		max-width: 600px;
	}

	.bd-school-modal-benefits {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-bottom: 1.25rem;
	}

	.bd-school-modal-benefit {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.65rem 0.85rem;
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		font-size: 0.84rem;
		line-height: 1.4;
	}

	.bd-school-modal-contact-card {
		padding: 1.15rem;
		border-radius: 1rem;
		background: rgba(var(--bd-tertiary-rgb), 0.05);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.25);
	}

	.bd-school-contact-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 0.75rem;
	}

	.bd-school-email-btn {
		font-size: 0.82rem;
		padding: 0.6rem 1rem;
	}

	.bd-copy-btn {
		font-size: 0.8rem;
		padding: 0.55rem 0.85rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.bd-school-email-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.65rem;
		border-radius: 0.5rem;
		background: rgba(0, 0, 0, 0.3);
		border: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8rem;
	}

	.bd-school-email-pill code {
		font-family: 'Space Grotesk', monospace;
		color: var(--bd-tertiary);
	}

	/* ── Sponsors CTA Card ── */
	.bd-sponsors-cta-card {
		position: relative;
		border-radius: 1.5rem;
		padding: clamp(2rem, 5vw, 3.5rem);
		text-align: center;
		overflow: hidden;
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.35);
		background: linear-gradient(135deg, rgba(var(--bd-primary-rgb), 0.05) 0%, rgba(var(--bd-tertiary-rgb), 0.08) 100%);
	}

	.bd-sponsors-cta-ambient {
		position: absolute;
		top: -40%;
		left: 50%;
		transform: translateX(-50%);
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, rgba(var(--bd-tertiary-rgb), 0.2) 0%, transparent 70%);
		pointer-events: none;
		border-radius: 50%;
		filter: blur(60px);
	}

	.bd-sponsors-cta-content {
		position: relative;
		z-index: 1;
	}

	.bd-sponsors-cta-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.bd-sponsors-btn-linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #0077b5;
		color: #ffffff;
		border-color: #0077b5;
	}

	.bd-sponsors-btn-linkedin:hover {
		background: #006097;
		box-shadow: 0 0 25px rgba(0, 119, 181, 0.4);
	}

	.bd-sponsors-btn-email {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.bd-sponsors-copy-btn {
		font-family: 'Space Grotesk', monospace;
	}

	.bd-sesion-card--kickoff {
		border-color: rgba(var(--bd-primary-rgb), 0.35);
		background: rgba(var(--bd-primary-rgb), 0.03);
	}

	/* ── Mobile-First Responsive Styles ── */
	@media (max-width: 640px) {
		.bd-hero-top-badges {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}

		.bd-school-pill-btn {
			width: 100%;
			max-width: 100%;
			box-sizing: border-box;
			justify-content: flex-start;
			padding: 0.45rem 0.75rem;
			gap: 0.35rem;
		}

		.bd-school-pill-text {
			font-size: clamp(0.68rem, 2.7vw, 0.78rem);
			line-height: 1.25;
			white-space: normal;
			text-align: left;
			flex: 1;
		}

		.bd-school-pill-tag {
			font-size: 0.62rem;
			padding: 0.15rem 0.45rem;
			flex-shrink: 0;
		}

		.bd-school-pill-arrow {
			margin-left: auto;
			flex-shrink: 0;
		}

		/* Bottom-sheet popup on mobile — School Modal */
		.bd-school-modal-overlay {
			align-items: flex-end;
			padding: 0;
		}

		.bd-school-modal-overlay .bd-school-modal {
			max-height: 85vh;
			max-height: 85dvh;
			border-bottom-left-radius: 0;
			border-bottom-right-radius: 0;
			width: 100%;
			transform: translateY(20px);
			overscroll-behavior: contain;
		}

		.bd-school-modal-overlay:not([hidden]) .bd-school-modal {
			transform: translateY(0);
		}

		/* Bottom-sheet popup on mobile — Track Modals */
		.bd-modal-overlay:not(.bd-school-modal-overlay) {
			align-items: flex-end;
			padding: 0;
		}

		.bd-modal-overlay:not(.bd-school-modal-overlay) .bd-modal {
			max-height: 85vh;
			max-height: 85dvh;
			border-bottom-left-radius: 0;
			border-bottom-right-radius: 0;
			width: 100%;
			transform: translateY(20px);
		}

		.bd-modal-overlay:not(.bd-school-modal-overlay):not([hidden]) .bd-modal {
			transform: translateY(0);
		}

		.bd-school-contact-actions {
			flex-direction: column;
			width: 100%;
		}

		.bd-school-email-btn,
		.bd-copy-btn {
			width: 100%;
			justify-content: center;
			min-height: 44px;
		}

		.bd-sponsors-cta-actions {
			flex-direction: column;
			width: 100%;
		}

		.bd-sponsors-btn-linkedin,
		.bd-sponsors-btn-email,
		.bd-sponsors-copy-btn {
			width: 100%;
			justify-content: center;
			min-height: 44px;
		}
	}

	/* ══════════════════════════════
	   HERO
	   ══════════════════════════════ */
	.bd-hero {
		position: relative;
		min-height: calc(100vh - 65px);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.bd-hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	/* WebGL canvas on top of orbs */
	.bd-shader-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		z-index: 2;
		display: block;
		transition: opacity 0.8s ease;
	}

	.bd-shader-canvas.active {
		opacity: 0.92;
	}

	/* Hide orbs when WebGL canvas is active */
	.bd-hero-bg.webgl-active .bd-hero-orb {
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.bd-hero-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.4;
	}

	.bd-hero-orb--1 {
		width: clamp(300px, 35vw, 600px);
		height: clamp(300px, 35vw, 600px);
		background: rgba(var(--bd-secondary-container-rgb), 0.2);
		top: 10%;
		left: 20%;
		animation: bd-float 8s ease-in-out infinite;
	}

	.bd-hero-orb--2 {
		width: clamp(200px, 25vw, 400px);
		height: clamp(200px, 25vw, 400px);
		background: rgba(var(--bd-primary-rgb), 0.15);
		bottom: 20%;
		right: 15%;
		animation: bd-float 6s ease-in-out infinite;
		animation-delay: -2s;
	}

	.bd-hero-orb--3 {
		width: clamp(150px, 18vw, 300px);
		height: clamp(150px, 18vw, 300px);
		background: rgba(var(--bd-tertiary-rgb), 0.1);
		top: 60%;
		left: 5%;
		animation: bd-float 10s ease-in-out infinite;
		animation-delay: -4s;
	}

	.bd-hero-content {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: clamp(2rem, 5vw, 4.5rem);
		padding-top: clamp(3rem, 6vw, 6rem);
		padding-bottom: clamp(3rem, 5vw, 5rem);
		width: 100%;
	}

	.bd-hero-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.bd-hero-badge {
		margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
		box-shadow: 0 0 15px rgba(var(--bd-tertiary-rgb), 0.2);
	}

	.bd-hero-subtitle {
		max-width: 580px;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}

	.bd-hero-actions {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		align-items: flex-start;
		margin-top: 0.5rem;
	}

	.bd-hero-cta-buttons {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	.bd-hero-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.8rem 1.45rem !important;
		font-size: 0.9rem !important;
		font-weight: 600;
		border-radius: 0.85rem !important;
	}

	.bd-hero-btn--teal {
		background: linear-gradient(135deg, var(--bd-primary), hsl(164, 70%, 35%)) !important;
		box-shadow: 0 4px 20px rgba(var(--bd-primary-rgb), 0.35) !important;
	}

	.bd-hero-btn--teal:hover {
		background: linear-gradient(135deg, hsl(164, 90%, 65%), hsl(164, 70%, 40%)) !important;
		transform: translateY(-2px);
		box-shadow: 0 6px 25px rgba(var(--bd-primary-rgb), 0.5) !important;
	}

	.bd-hero-btn--lime {
		background: linear-gradient(135deg, var(--bd-tertiary), hsl(80, 70%, 35%)) !important;
		box-shadow: 0 4px 20px rgba(var(--bd-tertiary-rgb), 0.35) !important;
		color: #0d1e00 !important;
	}

	.bd-hero-btn--lime:hover {
		background: linear-gradient(135deg, hsl(80, 85%, 55%), hsl(80, 70%, 40%)) !important;
		transform: translateY(-2px);
		box-shadow: 0 6px 25px rgba(var(--bd-tertiary-rgb), 0.5) !important;
	}

	.bd-hero-sub-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.bd-hero-sublink {
		font-size: 0.84rem !important;
		padding: 0.35rem 0.75rem !important;
		color: var(--bd-on-surface-variant);
		gap: 0.35rem !important;
	}

	.bd-hero-sublink:hover {
		color: var(--bd-text-primary);
	}

	.bd-hero-sep {
		color: rgba(255, 255, 255, 0.2);
		font-size: 0.8rem;
	}

	/* ══════════════════════════════
	   SECCIÓN DE INSCRIPCIÓN DEDICADA
	   ══════════════════════════════ */
	.bd-inscripcion-section {
		scroll-margin-top: 90px;
		padding-top: clamp(2.5rem, 5vw, 4.5rem);
	}

	.bd-inscripcion-dates-banner {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-top: 1.25rem;
		padding: 0.45rem 1.2rem;
		border-radius: 9999px;
		background: rgba(35, 32, 56, 0.65);
		border: 1px solid rgba(121, 248, 208, 0.25);
		box-shadow: 0 0 20px rgba(121, 248, 208, 0.1);
	}

	/* ══════════════════════════════
	   INAUGURACIÓN PRESENCIAL
	   ══════════════════════════════ */
	.bd-inauguracion-section {
		position: relative;
		overflow: hidden;
	}

	.bd-inauguracion-bento {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: clamp(1.25rem, 2.5vw, 2rem);
		align-items: stretch;
		margin-top: 2.5rem;
	}

	.bd-inaug-card {
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 2.5vw, 2.25rem);
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.bd-inaug-card--info {
		border-color: rgba(var(--bd-primary-rgb), 0.3);
		background: radial-gradient(circle at top left, rgba(var(--bd-primary-rgb), 0.08) 0%, rgba(27, 24, 45, 0.7) 60%);
	}

	.bd-inaug-card--map {
		border-color: rgba(var(--bd-tertiary-rgb), 0.3);
		background: radial-gradient(circle at top right, rgba(var(--bd-tertiary-rgb), 0.08) 0%, rgba(27, 24, 45, 0.7) 60%);
	}

	.bd-inaug-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.bd-inaug-icon-wrap {
		width: 52px;
		height: 52px;
		border-radius: 14px;
		background: rgba(var(--bd-primary-rgb), 0.15);
		border: 1px solid rgba(var(--bd-primary-rgb), 0.3);
		color: var(--bd-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 0 20px rgba(var(--bd-primary-rgb), 0.25);
	}

	.bd-inaug-icon {
		font-size: 1.8rem;
	}

	.bd-inaug-badge {
		margin-bottom: 0.4rem;
	}

	.bd-inaug-title {
		font-size: clamp(1.2rem, 2vw, 1.5rem);
		color: var(--bd-text-primary);
		margin: 0;
	}

	.bd-inaug-meta-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.bd-inaug-meta-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.bd-meta-icon {
		font-size: 1.35rem;
		color: var(--bd-tertiary);
		flex-shrink: 0;
	}

	.bd-meta-label {
		display: block;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--bd-on-surface-variant);
		font-family: 'Space Grotesk', sans-serif;
	}

	.bd-meta-val {
		display: block;
		font-size: 0.92rem;
		color: var(--bd-text-primary);
	}

	/* Gate Alert */
	.bd-inaug-gate-alert {
		border-radius: 14px;
		padding: 1.15rem 1.25rem;
		margin-bottom: 1.5rem;
		background: linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(245, 158, 11, 0.08) 100%);
		border: 1px solid rgba(245, 158, 11, 0.4);
		box-shadow: 0 0 25px rgba(245, 158, 11, 0.12);
	}

	.bd-gate-alert-badge-row {
		margin-bottom: 0.45rem;
	}

	.bd-gate-alert-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #fde047;
		background: rgba(234, 179, 8, 0.2);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px solid rgba(234, 179, 8, 0.4);
	}

	.bd-gate-alert-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: #fef08a;
		margin: 0 0 0.45rem;
	}

	.bd-gate-alert-icon {
		font-size: 1.3rem;
		color: #f59e0b;
	}

	.bd-gate-alert-desc {
		font-size: 0.88rem;
		line-height: 1.5;
		color: #fef3c7;
		margin: 0;
	}

	.bd-inaug-guidelines {
		list-style: none;
		padding: 0;
		margin: 0 0 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.bd-inaug-guide-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		font-size: 0.86rem;
		line-height: 1.5;
		color: #cbd5e1;
	}

	.bd-guide-icon {
		font-size: 1.2rem;
		color: var(--bd-primary);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.bd-inaug-guide-item strong {
		color: var(--bd-text-primary);
	}

	.bd-inaug-support-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		color: var(--bd-on-surface-variant);
	}

	/* Map Card */
	.bd-map-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.bd-map-header-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.bd-map-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--bd-text-primary);
	}

	.bd-map-frame-wrapper {
		position: relative;
		width: 100%;
		height: 320px;
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: #0f172a;
		box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
	}

	.bd-map-iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		filter: contrast(1.05) brightness(0.95);
	}

	:root.dark .bd-map-iframe {
		filter: invert(90%) hue-rotate(180deg) contrast(0.9) brightness(0.95);
	}

	.bd-map-overlay-badge {
		position: absolute;
		bottom: 10px;
		left: 10px;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.75rem;
		border-radius: 8px;
		background: rgba(15, 23, 42, 0.85);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.15);
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		color: #e2e8f0;
		pointer-events: none;
	}

	.bd-map-footer {
		margin-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		align-items: center;
	}

	.bd-map-cta-btn {
		width: 100%;
		justify-content: center;
	}

	.bd-map-route-hint {
		color: var(--bd-on-surface-variant);
		text-align: center;
	}

	/* Disabled registration buttons */
	.bd-modalidad-card--closed {
		opacity: 0.92;
	}

	.bd-modalidad-btn-disabled {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: 0.85rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #94a3b8;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		user-select: none;
		cursor: default;
	}

	.bd-inscripcion-dates-banner--closed {
		border-color: rgba(var(--bd-primary-rgb), 0.3) !important;
	}

	@media (max-width: 992px) {
		.bd-inauguracion-bento {
			grid-template-columns: 1fr;
		}
		.bd-map-frame-wrapper {
			height: 280px;
		}
	}

	@media (max-width: 640px) {
		.bd-inaug-meta-grid {
			grid-template-columns: 1fr;
		}
		.bd-map-frame-wrapper {
			height: 240px;
		}
	}

	.bd-inscripcion-dates-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--bd-text-primary);
		letter-spacing: 0.02em;
	}

	.bd-inscripcion-cards-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(1.25rem, 2.5vw, 2rem);
		margin-top: 2.75rem;
		width: 100%;
	}

	.bd-modalidad-card {
		display: flex;
		flex-direction: column;
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 2.5vw, 2.25rem);
		position: relative;
		overflow: hidden;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.bd-modalidad-card--group {
		border-color: rgba(var(--bd-primary-rgb), 0.3);
		background: radial-gradient(circle at top left, rgba(var(--bd-primary-rgb), 0.08) 0%, rgba(27, 24, 45, 0.7) 60%);
	}

	.bd-modalidad-card--group:hover {
		border-color: rgba(var(--bd-primary-rgb), 0.65);
		box-shadow: 0 0 35px rgba(var(--bd-primary-rgb), 0.2);
		transform: translateY(-4px);
	}

	.bd-modalidad-card--individual {
		border-color: rgba(var(--bd-tertiary-rgb), 0.3);
		background: radial-gradient(circle at top left, rgba(var(--bd-tertiary-rgb), 0.08) 0%, rgba(27, 24, 45, 0.7) 60%);
	}

	.bd-modalidad-card--individual:hover {
		border-color: rgba(var(--bd-tertiary-rgb), 0.65);
		box-shadow: 0 0 35px rgba(var(--bd-tertiary-rgb), 0.2);
		transform: translateY(-4px);
	}

	.bd-modalidad-badge-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.25rem;
		gap: 0.5rem;
	}

	.bd-modalidad-pill-tag {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bd-primary);
		padding: 0.2rem 0.65rem;
		border-radius: 6px;
		background: rgba(var(--bd-primary-rgb), 0.1);
		border: 1px solid rgba(var(--bd-primary-rgb), 0.2);
	}

	.bd-modalidad-pill-tag--lime {
		color: var(--bd-tertiary);
		background: rgba(var(--bd-tertiary-rgb), 0.1);
		border-color: rgba(var(--bd-tertiary-rgb), 0.2);
	}

	.bd-modalidad-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.bd-modalidad-icon-wrap {
		width: 48px;
		height: 48px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.bd-modalidad-icon-wrap--teal {
		background: rgba(var(--bd-primary-rgb), 0.15);
		border: 1px solid rgba(var(--bd-primary-rgb), 0.3);
		color: var(--bd-primary);
		box-shadow: 0 0 15px rgba(var(--bd-primary-rgb), 0.2);
	}

	.bd-modalidad-icon-wrap--lime {
		background: rgba(var(--bd-tertiary-rgb), 0.15);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.3);
		color: var(--bd-tertiary);
		box-shadow: 0 0 15px rgba(var(--bd-tertiary-rgb), 0.2);
	}

	.bd-modalidad-icon {
		font-size: 1.6rem;
	}

	.bd-modalidad-title {
		font-size: clamp(1.15rem, 2vw, 1.35rem);
		margin: 0 0 0.35rem;
		color: var(--bd-text-primary);
	}

	.bd-modalidad-desc {
		color: var(--bd-on-surface-variant);
		margin: 0;
		line-height: 1.5;
	}

	.bd-modalidad-divider {
		height: 1px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.02));
		margin: 1.25rem 0 1.5rem;
	}

	.bd-modalidad-features {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.bd-modalidad-feature {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		font-size: 0.88rem;
		line-height: 1.5;
		color: #bccac2;
	}

	.bd-modalidad-feature strong {
		color: var(--bd-text-primary);
		font-weight: 600;
	}

	.bd-feature-icon {
		font-size: 1.2rem;
		flex-shrink: 0;
		margin-top: 2px;
	}

	.bd-feature-icon--teal {
		color: var(--bd-primary);
	}

	.bd-feature-icon--lime {
		color: var(--bd-tertiary);
	}

	.bd-modalidad-footer {
		margin-top: auto;
		padding-top: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		align-items: center;
		width: 100%;
	}

	.bd-modalidad-btn {
		width: 100%;
		justify-content: center;
		padding: 0.85rem 1.5rem !important;
		font-size: 0.92rem !important;
		border-radius: 0.85rem !important;
	}

	.bd-modalidad-btn--teal {
		background: linear-gradient(135deg, var(--bd-primary), hsl(164, 70%, 35%)) !important;
		box-shadow: 0 4px 20px rgba(var(--bd-primary-rgb), 0.35) !important;
	}

	.bd-modalidad-btn--teal:hover {
		background: linear-gradient(135deg, hsl(164, 90%, 65%), hsl(164, 70%, 40%)) !important;
		box-shadow: 0 6px 25px rgba(var(--bd-primary-rgb), 0.5) !important;
	}

	.bd-modalidad-btn--lime {
		background: linear-gradient(135deg, var(--bd-tertiary), hsl(80, 70%, 35%)) !important;
		box-shadow: 0 4px 20px rgba(var(--bd-tertiary-rgb), 0.35) !important;
		color: #0d1e00 !important;
	}

	.bd-modalidad-btn--lime:hover {
		background: linear-gradient(135deg, hsl(80, 85%, 55%), hsl(80, 70%, 40%)) !important;
		box-shadow: 0 6px 25px rgba(var(--bd-tertiary-rgb), 0.5) !important;
	}

	.bd-modalidad-note {
		font-size: 0.76rem;
		color: var(--bd-on-surface-variant);
		text-align: center;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	/* Aviso Presencial */
	.bd-inscripcion-notice-banner {
		margin-top: 2rem;
		border-radius: 1.25rem;
		padding: 1.35rem 1.75rem;
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(200, 191, 255, 0.2);
		background: rgba(35, 32, 56, 0.55);
	}

	.bd-inscripcion-notice-glow {
		position: absolute;
		top: -40%;
		left: 20%;
		width: 60%;
		height: 180%;
		background: radial-gradient(ellipse, rgba(121, 248, 208, 0.08) 0%, transparent 70%);
		pointer-events: none;
	}

	.bd-inscripcion-notice-inner {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 1.15rem;
	}

	.bd-inscripcion-notice-icon-wrap {
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: rgba(121, 248, 208, 0.12);
		border: 1px solid rgba(121, 248, 208, 0.25);
		color: var(--bd-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.bd-inscripcion-notice-icon {
		font-size: 1.4rem;
	}

	.bd-inscripcion-notice-title {
		margin: 0 0 0.35rem;
		color: var(--bd-text-primary);
		font-size: 1rem;
		font-weight: 700;
	}

	.bd-inscripcion-notice-desc {
		margin: 0;
		color: #bccac2;
		line-height: 1.55;
		font-size: 0.85rem;
	}



	.bd-hero-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: clamp(280px, 30vw, 440px);
		margin: 0 auto;
	}

	.bd-hero-img-glow {
		position: absolute;
		inset: -20%;
		background: radial-gradient(circle, rgba(var(--bd-primary-rgb), 0.25) 0%, transparent 70%);
		border-radius: 50%;
		z-index: -1;
		animation: bd-float 6s ease-in-out infinite;
	}

	.bd-hero-img {
		width: 100%;
		max-width: clamp(240px, 26vw, 380px);
		height: auto;
		object-fit: contain;
		border-radius: 1.5rem;
		filter: drop-shadow(0 0 35px rgba(var(--bd-primary-rgb), 0.35));
		transition: transform 0.7s ease;
		animation: bd-float 4s ease-in-out infinite;
	}

	.bd-hero-img:hover {
		transform: scale(1.05);
	}

	@media (max-width: 900px) {
		.bd-hero-content {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 2.5rem;
			padding-top: 5.25rem;
		}
		.bd-hero-text {
			align-items: center;
		}
		.bd-hero-actions {
			justify-content: center;
		}
		.bd-hero-visual {
			max-width: 260px;
		}
	}

	@media (max-width: 860px) {
		.bd-inscripcion-cards-grid {
			grid-template-columns: 1fr;
			max-width: 580px;
			margin-left: auto;
			margin-right: auto;
		}
	}

	@media (max-width: 768px) {
		.bd-hero-actions {
			align-items: center;
			width: 100%;
		}
		.bd-hero-cta-buttons {
			justify-content: center;
		}
		.bd-hero-sub-actions {
			justify-content: center;
		}
	}

	@media (max-width: 540px) {
		.bd-hero-cta-buttons {
			width: 100%;
			flex-direction: column;
		}
		.bd-hero-btn {
			width: 100%;
			justify-content: center;
		}
		.bd-hero-sub-actions {
			width: 100%;
			justify-content: center;
		}
		.bd-inscripcion-notice-inner {
			flex-direction: column;
			gap: 0.85rem;
		}
	}



	/* ══════════════════════════════
	   IMPACTO
	   ══════════════════════════════ */
	.bd-section-header {
		margin-bottom: 3rem;
	}

	.bd-impact-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	.bd-impact-card {
		padding: 2rem;
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
	}

	.bd-impact-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 0 30px var(--card-shadow-color, rgba(var(--bd-primary-rgb), 0.3));
	}

	.bd-impact-icon-wrap {
		width: 3rem;
		height: 3rem;
		border-radius: 0.75rem;
		background: rgba(var(--bd-surface-container-high), 0.5);
		border: 1px solid;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
		transition: all 0.3s;
	}

	.bd-impact-card:hover .bd-impact-icon-wrap {
		transform: scale(1.1);
		background: var(--card-shadow-color, rgba(var(--bd-primary-rgb), 0.1));
		drop-shadow: 0 0 8px var(--card-shadow-color);
	}

	.bd-impact-icon {
		font-size: 1.75rem;
	}

	/* Detail: hidden by default, revealed on hover */
	.bd-impact-detail {
		margin-top: 0;
		padding-top: 0;
		border-top: 1px solid rgba(var(--bd-secondary-container-rgb), 0.15);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transition: max-height 0.4s ease, opacity 0.35s ease, margin-top 0.3s ease, padding-top 0.3s ease;
	}

	.bd-impact-card:hover .bd-impact-detail {
		max-height: 200px;
		opacity: 1;
		margin-top: 1rem;
		padding-top: 1rem;
	}

	@media (max-width: 1100px) {
		.bd-impact-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.bd-impact-grid {
			grid-template-columns: 1fr;
		}
		/* On mobile, always show the detail */
		.bd-impact-detail {
			max-height: 200px;
			opacity: 1;
			margin-top: 1rem;
			padding-top: 1rem;
		}
	}

	/* ══════════════════════════════
	   TIMELINE / FASES
	   ══════════════════════════════ */
	.bd-timeline {
		position: relative;
		max-width: 820px;
		margin: 0 auto;
		width: 100%;
	}

	.bd-timeline-track {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 2px;
		background: linear-gradient(to bottom, var(--bd-primary), var(--bd-tertiary), var(--bd-secondary-container));
		opacity: 0.35;
		transform: translateX(-50%);
	}

	.bd-timeline-item {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.bd-timeline-item--left {
		flex-direction: row;
	}

	.bd-timeline-item--right {
		flex-direction: row;
	}

	.bd-timeline-content {
		flex: 0 0 calc(50% - 1.75rem);
		width: calc(50% - 1.75rem);
		box-sizing: border-box;
	}

	.bd-timeline-item--left .bd-timeline-content {
		text-align: right;
		padding-right: clamp(1.5rem, 3vw, 2.5rem);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.bd-timeline-item--right .bd-timeline-content {
		text-align: left;
		padding-left: clamp(1.5rem, 3vw, 2.5rem);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.bd-timeline-spacer {
		flex: 0 0 calc(50% - 1.75rem);
		width: calc(50% - 1.75rem);
	}

	.bd-timeline-node {
		position: absolute;
		left: 50%;
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 50%;
		background: var(--bd-surface);
		border: 2px solid;
		transform: translateX(-50%);
		z-index: 2;
		transition: all 0.3s;
	}

	.bd-timeline-node--teal {
		border-color: var(--bd-primary);
		box-shadow: 0 0 15px rgba(var(--bd-primary-rgb), 0.6);
		animation: bd-pulse-node 2s infinite;
	}

	.bd-timeline-node--lime {
		border-color: var(--bd-tertiary);
		box-shadow: 0 0 15px rgba(var(--bd-tertiary-rgb), 0.6);
		animation: bd-pulse-node-tertiary 2s infinite;
	}

	.bd-timeline-item:hover .bd-timeline-node--teal {
		background: var(--bd-primary);
		transform: translateX(-50%) scale(1.3);
	}

	.bd-timeline-item:hover .bd-timeline-node--lime {
		background: var(--bd-tertiary);
		transform: translateX(-50%) scale(1.3);
	}

	@media (max-width: 768px) {
		.bd-timeline-track {
			left: 1.25rem;
			transform: none;
		}
		.bd-timeline-item {
			flex-direction: row;
			margin-bottom: 2.5rem;
		}
		.bd-timeline-content {
			width: 100%;
			flex: 1;
			text-align: left !important;
			padding-left: 2.75rem !important;
			padding-right: 0 !important;
		}
		.bd-timeline-spacer {
			display: none;
		}
		.bd-timeline-node {
			left: 1.25rem;
			transform: translateX(-50%);
		}
	}

	/* ══════════════════════════════
	   CERTIFICACIÓN
	   ══════════════════════════════ */
	.bd-cert-card {
		padding: clamp(1.75rem, 4vw, 3rem);
		border-radius: 1.5rem;
		border-color: rgba(var(--bd-secondary-rgb), 0.3);
		position: relative;
		overflow: hidden;
	}

	.bd-cert-card:hover {
		border-color: rgba(var(--bd-secondary-rgb), 0.5);
	}

	.bd-cert-ambient {
		position: absolute;
		top: 0;
		right: 0;
		width: 300px;
		height: 300px;
		background: rgba(var(--bd-tertiary-rgb), 0.08);
		border-radius: 50%;
		filter: blur(80px);
		z-index: 0;
		transition: background 0.5s;
	}

	.bd-cert-card:hover .bd-cert-ambient {
		background: rgba(var(--bd-tertiary-rgb), 0.15);
	}

	.bd-cert-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: center;
	}

	.bd-cert-text {
		width: 100%;
	}

	.bd-cert-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.bd-cert-icon {
		font-size: 2rem;
		color: var(--bd-tertiary);
		filter: drop-shadow(0 0 8px rgba(var(--bd-tertiary-rgb), 0.4));
		animation: bd-pulse 1.5s infinite;
		flex-shrink: 0;
	}

	.bd-cert-progress {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
	}

	.bd-cert-progress-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}

	@media (max-width: 900px) {
		.bd-cert-inner {
			grid-template-columns: 1fr;
		}
	}

	/* Topics Grid */
	.bd-topics-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 2.5vw, 1.5rem);
	}

	.bd-topic-card {
		padding: clamp(1.5rem, 2.5vw, 2rem);
		text-align: center;
	}

	.bd-topic-icon-wrap {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 0.75rem;
		background: var(--bd-surface-container);
		border: 1px solid rgba(var(--bd-primary-rgb), 0.2);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
		transition: all 0.3s;
	}

	.bd-topic-card:hover .bd-topic-icon-wrap {
		transform: scale(1.1);
		background: rgba(var(--bd-primary-rgb), 0.1);
	}

	.bd-topic-instructor {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		justify-content: center;
	}

	.bd-topic-abbr {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--bd-surface-container-high);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.65rem;
		font-weight: 700;
		color: var(--bd-on-surface-variant);
	}

	@media (max-width: 960px) {
		.bd-topics-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.bd-topics-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Requisito Card */
	.bd-requisito-card {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		padding: clamp(1.25rem, 3vw, 2rem);
		border-radius: 1rem;
		background: rgba(var(--bd-tertiary-rgb), 0.05);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.2);
	}

	@media (max-width: 600px) {
		.bd-requisito-card {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}

	/* ══════════════════════════════
	   ALIADOS
	   ══════════════════════════════ */
	.bd-aliados-section {
		border-top: 1px solid rgba(var(--bd-secondary-rgb), 0.1);
		padding-top: 5rem;
	}

	@media (max-width: 768px) {
		.bd-org-grid {
			grid-template-columns: 1fr;
			max-width: 480px;
		}
	}

	/* ══════════════════════════════
	   CAMPAÑA ESCOLAR
	   ══════════════════════════════ */

	/* Ambient background orbs */
	.bd-school-section {
		position: relative;
		overflow: hidden;
		border-top: 1px solid rgba(var(--bd-tertiary-rgb), 0.1);
	}

	.bd-school-ambient {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}

	.bd-school-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(90px);
		opacity: 0.18;
	}

	.bd-school-orb--1 {
		width: clamp(250px, 28vw, 450px);
		height: clamp(250px, 28vw, 450px);
		background: rgba(var(--bd-primary-rgb), 0.6);
		top: -10%;
		right: 5%;
		animation: bd-float 9s ease-in-out infinite;
	}

	.bd-school-orb--2 {
		width: clamp(180px, 20vw, 320px);
		height: clamp(180px, 20vw, 320px);
		background: rgba(var(--bd-tertiary-rgb), 0.5);
		bottom: 5%;
		left: 3%;
		animation: bd-float 7s ease-in-out infinite;
		animation-delay: -3s;
	}

	/* Header */
	.bd-school-section > * {
		position: relative;
		z-index: 1;
	}

	.bd-school-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.bd-school-badge {
		margin-bottom: 1rem;
		box-shadow: 0 0 18px rgba(var(--bd-tertiary-rgb), 0.25);
	}

	.bd-school-pretitle {
		color: var(--bd-on-surface-variant);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin: 0.5rem 0 0.75rem;
		font-size: 0.72rem;
	}

	.bd-school-title {
		margin-bottom: 1.25rem;
	}

	.bd-school-subtitle {
		max-width: 660px;
		margin: 0 auto;
	}

	/* Stats bar */
	.bd-school-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		max-width: 680px;
		margin: 0 auto 3.5rem;
		border-radius: 1.25rem;
		overflow: hidden;
		background: var(--bd-glass-fill);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(var(--bd-secondary-container-rgb), 0.3);
	}

	.bd-school-stat-card {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		padding: 1.5rem 1rem;
		background: transparent;
		border: none;
		border-radius: 0;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		box-shadow: none;
		transition: background 0.3s;
	}

	.bd-school-stat-card:hover {
		background: rgba(255, 255, 255, 0.03);
		transform: none;
		box-shadow: none;
	}

	.bd-school-stat-value {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.6rem, 2.8vw, 2.2rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.bd-school-stat-label {
		color: var(--bd-on-surface-variant);
		text-align: center;
		font-size: 0.72rem;
		line-height: 1.3;
	}

	.bd-school-stat-divider {
		width: 1px;
		height: 3rem;
		background: rgba(var(--bd-secondary-container-rgb), 0.4);
		flex-shrink: 0;
	}

	/* Main grid */
	.bd-school-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: start;
	}

	/* Benefit cards */
	.bd-school-benefits {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.bd-school-benefit-card {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
