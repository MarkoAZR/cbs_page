	.bd-criterio-left {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.bd-criterio-peso {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--bd-tertiary);
	}

	.bd-criterio-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--bd-text-primary);
