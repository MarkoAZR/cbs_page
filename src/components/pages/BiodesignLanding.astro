		box-shadow: 0 0 15px rgba(var(--bd-tertiary-rgb), 0.2);
	}

	.bd-hero-subtitle {
		max-width: 620px;
		margin-bottom: 1.35rem;
	}

	/* Bento KPI Bar (4 columns desktop / 2x2 grid mobile < 180px) */
	.bd-hero-kpi-bento {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		width: 100%;
		max-width: 640px;
		padding: 0.9rem 1.1rem;
		border-radius: 16px;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(var(--bd-primary-rgb), 0.28);
		background: rgba(19, 17, 32, 0.72);
