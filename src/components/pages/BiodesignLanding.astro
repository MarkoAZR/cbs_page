<section class="bd-section" id="tracks">
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">route</span>
			{lang === 'es' ? 'EJES TEMÁTICOS OFICIALES' : 'OFFICIAL TRACKS'}
		</span>
		<h2 class="bd-headline-lg">{t('biodesign.tracks.section.title')}</h2>
		<p class="bd-body-md" style="max-width:680px; margin:0 auto;">{t('biodesign.tracks.section.subtitle')}</p>
	</div>

	<div class="bd-tracks-grid">
		{tracks.map((track, idx) => (
			<div
				class={`bd-glass bd-track-card bd-track-card--${track.color} bd-reveal`}
				data-track-id={track.id}
				role="button"
				tabindex="0"
				aria-haspopup="dialog"
				aria-label={t(`biodesign.tracks.${track.id}.title`)}
			>
				<div class="bd-track-number">{String(idx + 1).padStart(2, '0')}</div>
				<div class="bd-track-icon-wrap">
					<span class="material-icons bd-track-icon">{track.icon}</span>
				</div>
				<span class="bd-chip bd-track-badge" style={`color: var(${track.accentVar}); background: rgba(${track.rgbVar === 'var(--bd-primary-rgb)' ? 'var(--bd-primary-rgb)' : track.rgbVar === 'var(--bd-secondary-rgb)' ? 'var(--bd-secondary-rgb)' : 'var(--bd-tertiary-rgb)'}, 0.12);`}>
					{t(`biodesign.tracks.${track.id}.badge`)}
				</span>
				<h3 class="bd-headline-md bd-track-title">{t(`biodesign.tracks.${track.id}.title`)}</h3>
				<p class="bd-body-md bd-track-tagline">{t(`biodesign.tracks.${track.id}.tagline`)}</p>
				<div class="bd-track-cta">
					<span class="material-icons" style="font-size:1rem;">open_in_full</span>
					{lang === 'es' ? 'Ver detalles' : 'See details'}
				</div>
				<div class="bd-track-shimmer" aria-hidden="true"></div>
			</div>
		))}
	</div>

	<!-- Modales de Tracks -->
	{tracks.map(track => (
		<div
			class="bd-modal-overlay"
			id={`modal-${track.id}`}
			role="dialog"
			aria-modal="true"
			aria-labelledby={`modal-${track.id}-title`}
			hidden
		>
			<div class={`bd-modal bd-modal--${track.color}`}>
				<div class="bd-modal-header">
					<span class="material-icons bd-modal-icon">{track.icon}</span>
					<div>
						<span class="bd-chip bd-track-badge">{t(`biodesign.tracks.${track.id}.badge`)}</span>
						<h2 class="bd-headline-md" id={`modal-${track.id}-title`} style="margin:0.5rem 0 0;">
							{t(`biodesign.tracks.${track.id}.title`)}
						</h2>
					</div>
					<button class="bd-modal-close" data-close-modal aria-label="Cerrar">
						<span class="material-icons">close</span>
					</button>
				</div>
				<div class="bd-modal-body">
					<p class="bd-body-md" style="margin-bottom:1.5rem;">{t(`biodesign.tracks.${track.id}.desc`)}</p>

					<h3 class="bd-label-md bd-modal-section-title">
						<span class="material-icons" style="font-size:1rem;">lightbulb</span>
						{t('biodesign.tracks.modal.reto')}
					</h3>
					<ul class="bd-modal-retos">
						{track.retos.map(r => (
							<li class="bd-modal-reto-item">
								<span class="material-icons" style="font-size:1rem;">chevron_right</span>
								{t(`biodesign.tracks.${track.id}.${r}`)}
							</li>
						))}
					</ul>

					<h3 class="bd-label-md bd-modal-section-title" style="margin-top:1.5rem;">
						<span class="material-icons" style="font-size:1rem;">help_outline</span>
						{t('biodesign.tracks.modal.guia')}
					</h3>
					<ul class="bd-modal-preguntas">
						{track.preguntas.map(q => (
							<li class="bd-modal-pregunta-item">{t(`biodesign.tracks.${track.id}.${q}`)}</li>
						))}
					</ul>
				</div>
				<div class="bd-modal-footer">
					<button class="bd-btn-ghost" data-close-modal style="font-size:0.85rem;">
						{t('biodesign.tracks.modal.close')}
					</button>
				</div>
			</div>
		</div>
	))}
</section>

