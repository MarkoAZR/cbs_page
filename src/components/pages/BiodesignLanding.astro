	   ORGANIZING COMMITTEE & ALLIES
	   ══════════════════════════════ */
	.bd-org-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		max-width: 920px;
		margin: 0 auto;
		align-items: stretch;
