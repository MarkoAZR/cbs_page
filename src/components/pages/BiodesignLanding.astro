		align-items: center;
		justify-content: center;
	}

	.bd-track-archive-card--teal .bd-track-archive-icon { color: var(--bd-primary); }
	.bd-track-archive-card--purple .bd-track-archive-icon { color: var(--bd-secondary); }
	.bd-track-archive-card--lime .bd-track-archive-icon { color: var(--bd-tertiary); }

	.bd-track-archive-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.bd-track-archive-tagline {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--bd-on-surface-variant);
	}

	.bd-track-archive-num {
		margin-left: auto;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.6rem;
		font-weight: 800;
		color: rgba(255, 255, 255, 0.08);
	}

	.bd-track-archive-title {
		margin: 0;
		color: var(--bd-text-primary);
	}

	.bd-track-archive-desc {
		margin: 0;
		color: var(--bd-on-surface-variant);
		line-height: 1.45;
	}

	.bd-track-retos-pills {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.bd-track-reto-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		padding: 0.3rem 0.6rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.04);
		color: var(--bd-text-primary);
	}

	.bd-track-archive-footer {
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.bd-track-archive-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--bd-primary);
	}

	/* ── Sesiones Grid inside Details ── */
	.bd-sesiones-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.15rem;
		margin-top: 1rem;
	}

	@media (max-width: 1200px) { .bd-sesiones-grid { grid-template-columns: repeat(3, 1fr); } }
	@media (max-width: 820px)   { .bd-sesiones-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 520px)   { .bd-sesiones-grid { grid-template-columns: 1fr; } }

	.bd-sesion-card {
		padding: 1.25rem;
		border-radius: 1.15rem;
		border: 1px solid rgba(var(--bd-secondary-container-rgb), 0.3);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		background: var(--bd-surface-container);
	}

