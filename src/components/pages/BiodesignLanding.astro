---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import BiodesignImpact from '../biodesign/BiodesignImpact.astro';
import BiodesignHonorRoll from '../biodesign/BiodesignHonorRoll.astro';
import BiodesignFinalists from '../biodesign/BiodesignFinalists.astro';
import BiodesignJury from '../biodesign/BiodesignJury.astro';
import BiodesignHackathonPortal from '../biodesign/BiodesignHackathonPortal.astro';
import BiodesignFunding from '../biodesign/BiodesignFunding.astro';
import BiodesignTestimonials from '../biodesign/BiodesignTestimonials.astro';
// import BiodesignMemories from '../biodesign/BiodesignMemories.astro';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const EMAIL_CONTACT = 'cbs.unmsm@gmail.com';

// ── Tracks Oficiales (con conteo auditado de equipos inscritos) ──
const tracks = [
	{
		id: 'track1',
		icon: 'water_drop',
		color: 'teal',
		teamsCount: 12,
		accentVar: '--bd-primary',
		rgbVar: 'var(--bd-primary-rgb)',
		retos: ['reto1', 'reto2', 'reto3'] as const,
		preguntas: ['q1', 'q2', 'q3'] as const,
	},
	{
		id: 'track2',
		icon: 'health_and_safety',
		color: 'purple',
		teamsCount: 10,
		accentVar: '--bd-secondary',
		rgbVar: 'var(--bd-secondary-rgb)',
		retos: ['reto1', 'reto2', 'reto3'] as const,
		preguntas: ['q1', 'q2', 'q3'] as const,
	},
	{
		id: 'track3',
		icon: 'compost',
		color: 'lime',
		teamsCount: 5,
		accentVar: '--bd-tertiary',
		rgbVar: 'var(--bd-tertiary-rgb)',
		retos: ['reto1', 'reto2', 'reto3'] as const,
		preguntas: ['q1', 'q2', 'q3'] as const,
	},
];

// ── Stepper de 4 Fases Concluidas ───────────────────────────
const programSteps = [
	{
		num: '01',
		icon: 'school',
		titleKey: 'biodesign.programa.step1.title' as const,
		datesKey: 'biodesign.programa.step1.dates' as const,
		descKey: 'biodesign.programa.step1.desc' as const,
	},
	{
		num: '02',
		icon: 'cast_for_education',
		titleKey: 'biodesign.programa.step2.title' as const,
		datesKey: 'biodesign.programa.step2.dates' as const,
		descKey: 'biodesign.programa.step2.desc' as const,
	},
	{
		num: '03',
		icon: 'biotech',
		titleKey: 'biodesign.programa.step3.title' as const,
		datesKey: 'biodesign.programa.step3.dates' as const,
		descKey: 'biodesign.programa.step3.desc' as const,
	},
	{
		num: '04',
		icon: 'emoji_events',
		titleKey: 'biodesign.programa.step4.title' as const,
		datesKey: 'biodesign.programa.step4.dates' as const,
		descKey: 'biodesign.programa.step4.desc' as const,
	},
];

// ── Sesiones y Cronograma Oficial (10 Hitos) ─────────────────
interface Sesion {
	key: string;
	icon: string;
	special: string;
	fase: number;
	ponente: string;
	avatars: string[];
	org: string;
	role: string;
	pending?: boolean;
}

const sesiones: Sesion[] = [
	{
		key: 's0',
		icon: 'celebration',
		special: 'open',
		fase: 1,
		ponente: lang === 'es' ? 'Comité Organizador (CBS & NEA)' : 'Organizing Committee (CBS & NEA)',
		avatars: [`${base}/cbs_logo.png`, `${base}/allies/logo_nea.jpeg`],
		org: 'CBS & NEA',
		role: lang === 'es' ? 'Inauguración y Bienvenida 100% Virtual' : '100% Virtual Welcome & Opening'
	},
	{
		key: 's1',
		icon: 'biotech',
		special: 'lecture',
		fase: 1,
		ponente: 'Valery Velásquez',
		avatars: [`${base}/team/Valery_Velasquez.jpg`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Investigadora UNMSM' : 'UNMSM Researcher'
	},
	{
		key: 's2',
		icon: 'science',
		special: 'lecture',
		fase: 1,
		ponente: 'Victoria Esmeralda Vargas Alamo',
		avatars: [`${base}/allies/logo_asmutec.jpg`],
		org: 'ASM UTEC',
		role: lang === 'es' ? 'Bioingeniera UTEC' : 'UTEC Bioengineer'
	},
	{
		key: 's3',
		icon: 'bubble_chart',
		special: 'lecture',
		fase: 1,
		ponente: 'Marko Zapata',
		avatars: [`${base}/team/Marko_zapata.jpg`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Investigador INS - Exp. iGEM DL' : 'INS Researcher - iGEM DL Exp.'
	},
	{
		key: 's4',
		icon: 'extension',
		special: 'lecture',
		fase: 1,
		ponente: 'Benjamín Díaz',
		avatars: [`${base}/team/benja_cbs.jpg`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Estudiante de Maestría en UNMSM' : "Master's Student at UNMSM"
	},
	{
		key: 's5',
		icon: 'terminal',
		special: 'workshop',
		fase: 1,
		ponente: 'Rodrigo Puertas',
		avatars: [`${base}/team/Rodrigo_Puertas.png`],
		org: 'CBS-UNMSM',
		role: lang === 'es' ? 'Tesista GIBIOBES' : 'GIBIOBES Thesis Student'
	},
	{
		key: 's6',
		icon: 'rocket_launch',
		special: 'kickoff',
		fase: 2,
		ponente: lang === 'es' ? 'Comité Organizador (CBS & NEA)' : 'Organizing Committee (CBS & NEA)',
		avatars: [`${base}/Biodesign/logo_biodesign_mm.png`],
		org: 'BioDesign 2026',
		role: lang === 'es' ? 'Kick off informativo' : 'Informative Kick-off'
	},
	{
		key: 's7',
		icon: 'code',
		special: 'hackathon',
		fase: 2,
		ponente: lang === 'es' ? 'Mentores y Equipos' : 'Mentors & Teams',
		avatars: [`${base}/Biodesign/logo_biodesign_mm.png`],
		org: 'BioDesign 2026',
		role: lang === 'es' ? 'Hackathon guiado' : 'Guided Hackathon'
	},
	{
		key: 's8',
		icon: 'fact_check',
		special: 'eval',
		fase: 2,
		ponente: lang === 'es' ? 'Comité Evaluador' : 'Evaluation Committee',
		avatars: [`${base}/Biodesign/logo_biodesign_mm.png`],
		org: 'Jurado Oficial',
		role: lang === 'es' ? 'Revisión por Rúbrica' : 'Rubric Evaluation'
	},
	{
		key: 's9',
		icon: 'emoji_events',
		special: 'clausura',
		fase: 2,
		ponente: lang === 'es' ? 'Panel de Jueces & Organizadores' : 'Judges & Organizers Panel',
		avatars: [`${base}/cbs_logo.png`, `${base}/allies/logo_nea.jpeg`],
		org: 'CBS & NEA',
		role: lang === 'es' ? 'Defensa Presencial & Top 3' : 'In-Person Defense & Top 3'
	},
];

// ── Organizadores (Comité Organizador Oficial) ───────────────
const organizers = [
	{
		name: 'CBS-UNMSM',
		logo: `${base}/cbs_logo.png`,
		badge: lang === 'es' ? 'Liderazgo Científico & Formación' : 'Scientific Leadership & Training',
		desc: t('biodesign.aliados.org.cbs'),
	},
	{
		name: 'NEA — Neuronas en Acción',
		logo: `${base}/allies/logo_nea.jpeg`,
		badge: lang === 'es' ? 'Divulgación STEM & Juventud' : 'STEM Outreach & Youth',
		desc: t('biodesign.aliados.org.nea'),
	},
];

// ── Criterios de Rúbrica ─────────────────────────────────────
const rubricaCriterios = [
	{ key: 'c1', peso: 20, etapa: 1, desempate: false },
	{ key: 'c2', peso: 20, etapa: 1, desempate: false },
	{ key: 'c3', peso: 25, etapa: 1, desempate: true },
	{ key: 'c4', peso: 15, etapa: 1, desempate: false },
	{ key: 'c5', peso: 20, etapa: 2, desempate: true },
];

// ── Auspiciadores Institucionales ────────────────────────────
const institutionalSponsors = [
	{
		name: t('biodesign.aliados.ieee.name'),
		logo: `${base}/Biodesign/logo_IEEE.png`,
		desc: t('biodesign.aliados.ieee.desc'),
	},
	{
		name: t('biodesign.aliados.fcm.name'),
		logo: `${base}/Biodesign/logo_FCM.jpeg`,
		desc: t('biodesign.aliados.fcm.desc'),
	},
];

// ── Aliados ──────────────────────────────────────────────────
const alliedOrgs = [
	{
		name: 'Synbio LATAM',
		logo: `${base}/allies/synbiolatam.jpg`,
		desc: t('biodesign.aliados.synbio.desc'),
	},
	{
		name: 'ASM UTEC',
		logo: `${base}/allies/logo_asmutec.jpg`,
		desc: t('biodesign.aliados.asmutec.desc'),
	},
	{
		name: 'BIOMIM',
		logo: `${base}/allies/logo_biomin.jpeg`,
		desc: t('biodesign.aliados.biomin.desc'),
	},
	{
		name: t('biodesign.aliados.biomicas.name'),
		logo: `${base}/Biodesign/logo_biomicas.png`,
		desc: t('biodesign.aliados.biomicas.desc'),
	},
	{
		name: t('biodesign.aliados.clubesciencia.name'),
		logo: `${base}/allies/club_ciencia.jpeg`,
		desc: t('biodesign.aliados.clubesciencia.desc'),
	},
];
---

<!-- ═══════════════════════════════════════════
     1. HERO SECTION (MEMORIAS BIODESIGN 2026)
     ═══════════════════════════════════════════ -->
<section class="bd-hero">
	<!-- Animated background: WebGL shader + CSS orb fallback -->
	<div class="bd-hero-bg" aria-hidden="true">
		<div class="bd-hero-orb bd-hero-orb--1"></div>
		<div class="bd-hero-orb bd-hero-orb--2"></div>
		<div class="bd-hero-orb bd-hero-orb--3"></div>
		<canvas id="bd-shader-canvas" class="bd-shader-canvas"></canvas>
	</div>

	<div class="bd-section bd-hero-content">
		<div class="bd-hero-text">
			<div class="bd-hero-top-badges">
				<div class="bd-chip bd-chip-lime bd-hero-badge">
					<span class="material-icons" style="font-size: 14px;">verified</span>
					{t('biodesign.hero.badge')}
				</div>
			</div>

			<h1 class="bd-headline-xl">
				{t('biodesign.hero.title1')}<br />
				<span class="bd-gradient-text">{t('biodesign.hero.title2')}</span>
			</h1>

			<p class="bd-body-lg bd-hero-subtitle">
				{t('biodesign.hero.subtitle')}
			</p>

			<!-- Bento Bar de 4 KPIs de Impacto Auditados (4 col desktop / 2x2 mobile <180px) -->
			<div class="bd-hero-kpi-bento bd-glass" role="region" aria-label="Indicadores clave de impacto BioDesign 2026">
				<div class="bd-hero-kpi-item">
					<span class="bd-hero-kpi-num bd-hero-kpi-num--accent">9</span>
					<span class="bd-hero-kpi-lbl">{t('biodesign.hero.kpi.regions')}</span>
				</div>
				<div class="bd-hero-kpi-item">
					<span class="bd-hero-kpi-num">+150</span>
					<span class="bd-hero-kpi-lbl">{t('biodesign.hero.kpi.students')}</span>
				</div>
				<div class="bd-hero-kpi-item">
					<span class="bd-hero-kpi-num">27</span>
					<span class="bd-hero-kpi-lbl">{t('biodesign.hero.kpi.teams')}</span>
				</div>
				<div class="bd-hero-kpi-item">
					<span class="bd-hero-kpi-num">10</span>
					<span class="bd-hero-kpi-lbl">{t('biodesign.hero.kpi.projects')}</span>
				</div>
			</div>

			<div class="bd-hero-actions">
				<div class="bd-hero-cta-buttons">
					<a
						href="#ganadores"
						class="bd-btn-primary bd-hero-btn bd-hero-btn--teal"
						id="btn-hero-ganadores"
					>
						<span class="material-icons" style="font-size:1.1rem;">emoji_events</span>
						{t('biodesign.hero.cta.primary')}
					</a>
					<a
						href="#financiamiento"
						class="bd-btn-secondary bd-hero-btn bd-hero-btn--lime"
						id="btn-hero-financiamiento"
					>
						<span class="material-icons" style="font-size:1.1rem;">handshake</span>
						{t('biodesign.hero.cta.secondary')}
					</a>
				</div>
				<div class="bd-hero-sub-actions">
					<span class="bd-hero-status-pill bd-hero-status-pill--done">
						<span class="material-icons" style="font-size:14px; color: #10b981;">task_alt</span>
						{t('biodesign.hero.status.sprint')}
					</span>
					<span class="bd-hero-sep" aria-hidden="true">•</span>
					<span class="bd-hero-status-pill bd-hero-status-pill--done">
						<span class="material-icons" style="font-size:14px; color: #10b981;">task_alt</span>
						{t('biodesign.hero.status.eval')}
					</span>
					<span class="bd-hero-sep" aria-hidden="true">•</span>
					<span class="bd-hero-status-pill bd-hero-status-pill--done">
						<span class="material-icons" style="font-size:14px; color: #10b981;">task_alt</span>
						{t('biodesign.hero.status.final')}
					</span>
				</div>
			</div>
		</div>

		<div class="bd-hero-visual">
			<div class="bd-hero-img-glow"></div>
			<img
				src={`${base}/Biodesign/logo_biodesign_mm.png`}
				alt="BioDesign Logo"
				class="bd-hero-img"
				width="400"
				height="400"
				loading="eager"
			/>
		</div>
	</div>
</section>

<!-- ═══════════════════════════════════════════
     2. IMPACTO NACIONAL Y MÉTRICAS AUDITADAS (#impacto)
     ═══════════════════════════════════════════ -->
<BiodesignImpact lang={lang} />

<!-- ═══════════════════════════════════════════
     3. CUADRO DE HONOR Y PREMIACIÓN (#ganadores)
     ═══════════════════════════════════════════ -->
<BiodesignHonorRoll lang={lang} />

<!-- ═══════════════════════════════════════════
     4. CATÁLOGO TÉCNICO DE PROYECTOS FINALISTAS (#proyectos)
     ═══════════════════════════════════════════ -->
<BiodesignFinalists lang={lang} />

<!-- ═══════════════════════════════════════════
     5. JURADO CALIFICADOR, MESA DE HONOR Y MENTORES (#jurado)
     ═══════════════════════════════════════════ -->
<BiodesignJury lang={lang} />

<!-- ═══════════════════════════════════════════
     6. METODOLOGÍA Y RUTA FORMATIVA CUMPLIDA (#programa / #fases)
     ═══════════════════════════════════════════ -->
<section class="bd-section bd-program-section" id="programa">
	<span id="fases" class="bd-legacy-anchor" aria-hidden="true"></span>

	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">alt_route</span>
			{t('biodesign.programa.badge')}
		</span>
		<h2 class="bd-headline-lg">
			{t('biodesign.programa.title1')} <span class="bd-gradient-text">{t('biodesign.programa.title2')}</span>
		</h2>
		<p class="bd-body-md" style="max-width:720px; margin:0 auto;">
			{t('biodesign.programa.subtitle')}
		</p>
	</div>

	<!-- Stepper Horizontal de 4 Pasos Concluidos -->
	<div class="bd-program-stepper bd-reveal">
		{programSteps.map((step) => (
			<article class="bd-step-card bd-glass">
				<div class="bd-step-top">
					<span class="bd-step-num-badge">{step.num}</span>
					<span class="bd-step-done-chip">
						<span class="material-icons" style="font-size:13px;">check_circle</span>
						{t('biodesign.programa.completed')}
					</span>
				</div>
				<div class="bd-step-title-row">
					<span class="material-icons bd-step-icon">{step.icon}</span>
					<h3 class="bd-headline-sm bd-step-title">{t(step.titleKey)}</h3>
				</div>
				<p class="bd-caption bd-step-desc">{t(step.descKey)}</p>
				<div class="bd-step-dates">
					<span class="material-icons" style="font-size:13px; color:var(--bd-primary);">event_available</span>
					<span>{t(step.datesKey)}</span>
				</div>
			</article>
		))}
	</div>

	<!-- Bloques Desplegables de Metodología (Cero fatiga de scroll) -->
	<div class="bd-prog-accordions-wrap">

		<!-- Desplegable A: Ejes Temáticos y Retos Abordados (#tracks) -->
		<details class="bd-prog-details bd-glass bd-reveal" id="tracks">
			<summary class="bd-prog-summary">
				<div class="bd-prog-sum-left">
					<span class="material-icons bd-prog-sum-icon" style="color:var(--bd-primary);">category</span>
					<div>
						<strong class="bd-prog-sum-title">{t('biodesign.tracks.archive_title')}</strong>
						<span class="bd-caption bd-prog-sum-sub">{t('biodesign.tracks.archive_subtitle')}</span>
					</div>
				</div>
				<div class="bd-prog-sum-right">
					<span class="bd-chip bd-chip-teal">{lang === 'es' ? '3 Tracks · 27 Equipos' : '3 Tracks · 27 Teams'}</span>
					<span class="material-icons bd-prog-chevron">expand_more</span>
				</div>
			</summary>

			<div class="bd-prog-details-body">
				<div class="bd-tracks-archive-grid">
					{tracks.map((track, idx) => (
						<div
							class={`bd-glass bd-track-archive-card bd-track-archive-card--${track.color}`}
							data-track-id={track.id}
							role="button"
							tabindex="0"
							aria-haspopup="dialog"
							aria-label={t(`biodesign.tracks.${track.id}.title`)}
						>
							<div class="bd-track-archive-top">
								<div class="bd-track-archive-icon-wrap">
									<span class="material-icons bd-track-archive-icon">{track.icon}</span>
								</div>
								<div class="bd-track-archive-meta">
									<span class="bd-chip bd-track-badge" style={`color: var(${track.accentVar}); background: rgba(${track.rgbVar === 'var(--bd-primary-rgb)' ? 'var(--bd-primary-rgb)' : track.rgbVar === 'var(--bd-secondary-rgb)' ? 'var(--bd-secondary-rgb)' : 'var(--bd-tertiary-rgb)'}, 0.12); font-size: 0.65rem;`}>
										{t(`biodesign.tracks.${track.id}.badge`)}
									</span>
									<span class="bd-track-archive-tagline">
										{track.teamsCount} {lang === 'es' ? 'equipos inscritos' : 'registered teams'}
									</span>
								</div>
								<div class="bd-track-archive-num">{String(idx + 1).padStart(2, '0')}</div>
							</div>

							<h3 class="bd-headline-sm bd-track-archive-title">{t(`biodesign.tracks.${track.id}.title`)}</h3>
							<p class="bd-caption bd-track-archive-desc">{t(`biodesign.tracks.${track.id}.tagline`)}</p>

							<div class="bd-track-retos-pills">
								{track.retos.map(r => (
									<span class="bd-track-reto-pill">
										<span class="material-icons" style="font-size:11px;">check_circle</span>
										{t(`biodesign.tracks.${track.id}.${r}`)}
									</span>
								))}
							</div>

							<div class="bd-track-archive-footer">
								<span class="bd-track-archive-btn">
									<span class="material-icons" style="font-size:14px;">description</span>
									{t('biodesign.tracks.archive_cta')}
								</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</details>

		<!-- Desplegable B: Rúbrica Oficial de Evaluación (#rubrica) -->
		<details class="bd-prog-details bd-glass bd-reveal" id="rubrica">
			<summary class="bd-prog-summary">
				<div class="bd-prog-sum-left">
					<span class="material-icons bd-prog-sum-icon" style="color:var(--bd-tertiary);">fact_check</span>
					<div>
						<strong class="bd-prog-sum-title">{t('biodesign.rubrica.section.title')}</strong>
						<span class="bd-caption bd-prog-sum-sub">{t('biodesign.rubrica.section.subtitle')}</span>
					</div>
				</div>
				<div class="bd-prog-sum-right">
					<span class="bd-chip bd-chip-lime">{lang === 'es' ? '5 Criterios · 100 pts' : '5 Criteria · 100 pts'}</span>
					<span class="material-icons bd-prog-chevron">expand_more</span>
				</div>
			</summary>

			<div class="bd-prog-details-body">
				<div class="bd-rubrica-total">
					<span class="material-icons" style="color:var(--bd-tertiary);">verified</span>
					<p class="bd-body-md" style="margin:0;">{lang === 'es' ? 'Puntuación total: 100 puntos — Etapa 1 In Silico (80 pts) + Etapa 2 Defensa en Vivo (20 pts)' : 'Total score: 100 points — Stage 1 In Silico (80 pts) + Stage 2 Live Defense (20 pts)'}</p>
				</div>

				<div class="bd-criterios-list">
					{rubricaCriterios.map((c) => (
						<div class={`bd-criterio-card bd-glass bar-animated ${c.etapa === 2 ? 'bd-criterio-card--live' : ''}`} data-criterio={c.key}>
							<div class="bd-criterio-header">
								<div class="bd-criterio-left">
