---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CalendarBento from './CalendarBento.astro';
import CommunityFrame from './CommunityFrame.astro';
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const allLangEvents = await getCollection('events', ({ id }) => id.startsWith(`${lang}/`));
const now = new Date();

// Upcoming or Featured Events
const upcomingEvents = allLangEvents.filter(e => e.data.date >= now || e.data.featured);
upcomingEvents.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Past non-featured Events
const pastEvents = allLangEvents.filter(e => e.data.date < now && !e.data.featured);
pastEvents.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const events = [...upcomingEvents, ...pastEvents];
---

<Layout title={t('events.title')} description={t('events.description')} lang={lang}>
	<div class="container page-content">
		<header class="page-header animate-in">
			<span class="hero-badge glass">{t('events.pretitle')}</span>
			<h1>{t('events.heading')} <span class="gradient-text">{t('events.heading.highlight')}</span></h1>
			<p>{t('events.subtitle')}</p>
		</header>

		<!-- Calendar Bento Section -->
		<CalendarBento lang={lang} />

		<!-- Luma Official Calendar Section -->
		<CommunityFrame lang={lang} />

		<!-- Divider -->
		{events.length > 0 && (
			<div class="section-divider animate-in" style="animation-delay: 0.3s">
				<div class="divider-line"></div>
				<span class="divider-label">{lang === 'es' ? 'Cronograma Completo & Hitos' : 'Full Agenda & Milestones'}</span>
				<div class="divider-line"></div>
			</div>
		)}

		<div class="events-grid animate-in" style="animation-delay: 0.4s">
			{events.map((event, index) => {
				const isUpcoming = event.data.date >= now || event.data.featured;
				const slug = event.id.replace(`${lang}/`, '').replace(/\.[^.]+$/, '');
				return (
					<a href={getLocalePath(lang, `events/${slug}`)} class={`event-card glass ${isUpcoming ? 'upcoming-card' : ''} ${index === 0 ? 'large' : ''}`}>
						<div class="card-header">
							<span class="date">{event.data.date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
							<div class="card-tags">
								{event.data.badge && <span class="badge-pill">{event.data.badge}</span>}
								<span class="type-pill">{t(`type.${event.data.type}`)}</span>
							</div>
						</div>
						
						<div class="card-body">
							<h3>{event.data.title}</h3>
							<p>{event.data.description}</p>
						</div>

						<div class="card-footer">
							<div class="location">
								<span class="material-icons">place</span>
								<span>{event.data.location}</span>
							</div>
							<div class="arrow">
								<span class="material-icons">east</span>
							</div>
						</div>
					</a>
				);
			})}
		</div>
	</div>
</Layout>

<style>
	.page-content {
		padding-bottom: 8rem;
	}

	.section-divider {
		display: flex;
		align-items: center;
		gap: 2rem;
		margin: 4rem 0 3rem;
	}
	.divider-line {
		flex: 1;
		height: 1px;
		background: var(--border-color);
	}
	.divider-label {
		font-size: 0.7rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--text-color);
		opacity: 0.4;
		white-space: nowrap;
	}

	.page-header {
		padding: 8rem 0 4rem;
		text-align: center;
	}

	.hero-badge {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--accent-cyan);
		padding: 0.4rem 1.2rem;
		border-radius: 50px;
		display: inline-block;
		margin-bottom: 1.5rem;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		line-height: 1;
		margin-bottom: 1.5rem;
		font-weight: 800;
	}

	.page-header p {
		font-size: 1.25rem;
		opacity: 0.7;
		max-width: 600px;
		margin: 0 auto;
	}

	.events-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		grid-auto-rows: minmax(350px, auto);
		gap: 1.5rem;
	}

	.event-card {
		padding: 2.5rem;
		border-radius: 28px;
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		border: 1px solid var(--border-color);
	}

	.event-card:hover {
		transform: translateY(-8px) scale(1.02);
		border-color: var(--accent-purple);
		background: rgba(var(--accent-purple-rgb), 0.05);
	}

	.event-card.large {
		grid-column: span 2;
		grid-row: span 1;
		background: linear-gradient(135deg, rgba(var(--cbs-emerald-rgb), 0.12), rgba(var(--cbs-blue-corp-rgb), 0.08));
	}

	.event-card.upcoming-card {
		border-color: rgba(var(--cbs-emerald-rgb), 0.4);
		box-shadow: 0 12px 36px rgba(var(--cbs-emerald-rgb), 0.08);
	}
	.event-card.upcoming-card:hover {
		border-color: var(--cbs-emerald);
		box-shadow: 0 16px 48px rgba(var(--cbs-emerald-rgb), 0.2);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.card-tags {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.badge-pill {
		font-size: 0.65rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.3rem 0.8rem;
		border-radius: 100px;
		background: var(--cbs-emerald);
		color: white;
		box-shadow: 0 4px 12px rgba(var(--cbs-emerald-rgb), 0.3);
	}

	.date {
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--accent-cyan);
		font-variant-numeric: tabular-nums;
	}

	.type-pill {
		font-size: 0.65rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.3rem 0.8rem;
		border-radius: 100px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		opacity: 0.8;
	}

	.card-body h3 {
		font-size: 1.8rem;
		line-height: 1.2;
		margin-bottom: 1rem;
		color: var(--text-color);
		font-weight: 800;
	}

	.event-card.large h3 {
		font-size: 2.5rem;
	}

	.card-body p {
		font-size: 1rem;
		line-height: 1.6;
		opacity: 0.7;
		margin-bottom: 2rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-footer {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.location {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.6;
	}

	.location .material-icons {
		font-size: 1.1rem;
		color: var(--accent-cyan);
	}

	.arrow {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: rgba(var(--accent-cyan-rgb), 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent-cyan);
		transition: all 0.3s;
	}

	.event-card:hover .arrow {
		background: var(--accent-cyan);
		color: #fff;
		transform: translateX(5px);
	}

	@media (max-width: 900px) {
		.event-card.large {
			grid-column: span 1;
		}
		.event-card.large h3 {
			font-size: 1.8rem;
		}
	}

	@media (max-width: 600px) {
		.events-grid {
			grid-template-columns: 1fr;
		}
		.event-card {
			padding: 1.5rem;
		}
	}
</style>
