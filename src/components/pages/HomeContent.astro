---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const heroPhotos = [
	{ src: `${base}/pictures/ponencia_septiembre_2025.JPG`, alt: 'Ponencia CBS-UNMSM, Septiembre 2025' },
	{ src: `${base}/pictures/conferencia_julio.jpg`, alt: 'Conferencia CBS-UNMSM, Julio 2025' },
	{ src: `${base}/pictures/conferencia_setiembre_2025.jpg`, alt: 'Conferencia CBS-UNMSM, Setiembre 2025' },
];

const stats = [
	{ icon: 'event', value: t('stats.events'), label: t('stats.events.label'), sub: t('stats.events.sub') },
	{ icon: 'groups', value: t('stats.community'), label: t('stats.community.label'), sub: t('stats.community.sub') },
	{ icon: 'badge', value: t('stats.members'), label: t('stats.members.label'), sub: t('stats.members.sub') },
	{ icon: 'handshake', value: t('stats.allies'), label: t('stats.allies.label'), sub: t('stats.allies.sub') },
];

const milestones = [
	{ year: '2021', label: t('timeline.2021.label'), desc: t('timeline.2021.desc'), highlight: false },
	{ year: '2022', label: t('timeline.2022.label'), desc: t('timeline.2022.desc'), highlight: true },
	{ year: '2023', label: t('timeline.2023.label'), desc: t('timeline.2023.desc'), highlight: false },
	{ year: '2025', label: t('timeline.2025.label'), desc: t('timeline.2025.desc'), highlight: false },
	{ year: '2026', label: t('timeline.2026.label'), desc: t('timeline.2026.desc'), highlight: true },
];

const allies = [
	{ name: lang === 'es' ? 'AI Kids Perú' : 'AI Kids Peru', img: `${base}/allies/ai_kids.png`, url: '#', hasLogo: true },
	{ name: 'CEM',           img: `${base}/allies/Logo-CEM.avif`,    url: '#', hasLogo: true },
	{ name: 'ASM UTEC',      img: `${base}/allies/logo_asmutec.jpg`, url: '#', hasLogo: true },
	{ name: 'SynBio Latam',  img: `${base}/allies/synbiolatam.jpg`,  url: 'https://synbiolatam.org', hasLogo: true },
	{ name: 'FCB-UNMSM',     img: `${base}/allies/fcb_logo.png`,     url: '#', hasLogo: true },
	{ name: 'UNMSM',         img: `${base}/allies/unmsm_logo.png`,   url: 'https://unmsm.edu.pe', hasLogo: true },
	{ name: 'Lyn Biolearning', img: `${base}/allies/logo_lyn.png`,   url: '#', hasLogo: true },
	{ name: 'NEA',           img: `${base}/allies/logo_nea.jpeg`,    url: '#', hasLogo: true },
	{ name: 'Biomin',        img: `${base}/allies/logo_biomin.jpeg`,  url: '#', hasLogo: true },
];
---

<Layout title={lang === 'es' ? 'Inicio' : 'Home'} lang={lang}>

	<!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â
	     HERO SPLIT-SCREEN
	Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
	<section class="hero-split animate-in">
		<div class="mosaic-bg" aria-hidden="true">
			<div class="blob blob-1 float"></div>
			<div class="blob blob-2 float" style="animation-delay: -2s;"></div>
			<div class="blob blob-3 float" style="animation-delay: -4s;"></div>
		</div>

		<!-- Left: Text content -->
		<div class="hero-content">
			<div class="pre-title">
				<span class="hero-badge glass">{t('hero.pretitle')}</span>
			</div>
			<h1>
				{t('hero.title.line1')}<br/>
				<span class="gradient-text">{t('hero.title.highlight')}</span>
			</h1>
			<p class="description">{t('hero.description')}</p>
			<div class="actions">
				<a href={getLocalePath(lang, 'events')} class="btn primary">
					{t('hero.cta.events')} <span class="material-icons">event</span>
				</a>
				<a href="https://markoazr.github.io/symposium-cbs/es/" target="_blank" rel="noopener noreferrer" class="btn secondary">
					{t('hero.cta.symposium')} <span class="material-icons">open_in_new</span>
				</a>
			</div>
			<!-- Scroll indicator -->
			<div class="scroll-hint" aria-hidden="true">
				<div class="scroll-mouse">
					<div class="scroll-dot"></div>
				</div>
				<span class="scroll-label">{t('hero.scroll')}</span>
			</div>
		</div>

		<!-- Right: Photo Collage -->
		<div class="hero-collage" aria-label="Fotos de eventos CBS-UNMSM">
			{heroPhotos.map((photo, i) => (
				<div class={`collage-frame frame-${i}`}>
					<img src={photo.src} alt={photo.alt} loading={i === 0 ? 'eager' : 'lazy'} />
					<div class="frame-glow"></div>
				</div>
			))}
		</div>
	</section>

	<!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â
	     STATS BAR
	Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
	<section class="stats-section animate-in" style="animation-delay: 0.15s">
		<div class="container">
			<div class="stats-grid">
				{stats.map((stat, i) => (
					<div class="stat-card glass" data-value={stat.value} style={`animation-delay: ${0.1 * i}s`}>
						<div class="stat-icon-wrap">
							<span class="material-icons stat-icon">{stat.icon}</span>
						</div>
						<div class="stat-number" data-target={stat.value}>{stat.value}</div>
						<div class="stat-label">{stat.label}</div>
						<div class="stat-sub">{stat.sub}</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â
	     TIMELINE DE HITOS
	Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
	<section class="timeline-section animate-in" style="animation-delay: 0.2s">
		<div class="container">
			<div class="section-header">
				<span class="hero-badge glass">{t('timeline.pretitle')}</span>
				<h2>{t('timeline.title')} <span class="gradient-text">{t('timeline.highlight')}</span></h2>
			</div>
			<div class="timeline-track">
				<div class="timeline-line" aria-hidden="true"></div>
				{milestones.map((m) => (
					<div class={`milestone ${m.highlight ? 'milestone-highlight' : ''}`}>
						<div class="milestone-dot">
							{m.highlight && <span class="dot-pulse" aria-hidden="true"></span>}
						</div>
						<div class="milestone-year">{m.year}</div>
						<div class="milestone-card glass">
							<span class="milestone-label">{m.label}</span>
							<p class="milestone-desc">{m.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â
	     ALLIES CAROUSEL
	Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
	<section class="allies-section animate-in" style="animation-delay: 0.25s">
		<div class="allies-header container">
			<span class="hero-badge glass">{t('allies.pretitle')}</span>
			<h2>{t('allies.title')} <span class="gradient-text">{t('allies.highlight')}</span></h2>
		</div>
		<div class="marquee-wrapper" aria-label="Aliados institucionales">
			<div class="marquee-track">
				<!-- First copy -->
				{allies.map(ally => (
					<a href={ally.url} target={ally.url !== '#' ? '_blank' : '_self'} rel="noopener noreferrer"
					   class="marquee-item glass" aria-label={ally.name}>
						{ally.hasLogo
							? <img src={ally.img} alt={ally.name} loading="lazy" />
							: <span class="material-icons marquee-placeholder">biotech</span>
						}
						<span class="marquee-name">{ally.name}</span>
					</a>
				))}
				<!-- Duplicate for seamless loop -->
				{allies.map(ally => (
					<a href={ally.url} target={ally.url !== '#' ? '_blank' : '_self'} rel="noopener noreferrer"
					   class="marquee-item glass" aria-label={ally.name} tabindex="-1">
						{ally.hasLogo
							? <img src={ally.img} alt="" loading="lazy" />
							: <span class="material-icons marquee-placeholder">biotech</span>
						}
						<span class="marquee-name">{ally.name}</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â
	     BENTO GRID Ã¢â‚¬â€ Nuestra Labor
	Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
	<section id="impacto" class="impact-section animate-in" style="animation-delay: 0.3s">
		<div class="container">
			<div class="section-header">
				<h2 class="gradient-text">{t('impact.title')}</h2>
				<p>{t('impact.subtitle')}</p>
			</div>
			<div class="bento-grid">
				<!-- Featured: Simposio -->
				<div class="bento-item glass wide featured">
					<div class="bento-img-bg" aria-hidden="true">
						<img src={`${base}/pictures/conferencia_ciclo%20de%20foros.JPG`} alt="" loading="lazy" />
					</div>
					<div class="content">
						<span class="category">{t('bento.weekly')}</span>
						<h3>{t('bento.weekly.title')}</h3>
						<p>{t('bento.weekly.desc')}</p>
						<a href={getLocalePath(lang, 'events')} class="link-arrow">{t('bento.weekly.link')}</a>
					</div>
				</div>

				<div class="bento-item glass">
					<div class="content">
						<span class="category">{t('bento.community')}</span>
						<h3>{t('bento.community.title')}</h3>
						<p>{t('bento.community.desc')}</p>
					</div>
				</div>

				<div class="bento-item glass tall">
					<div class="content">
						<span class="category">{t('bento.mission')}</span>
						<div class="mv-block">
							<h3>{lang === 'es' ? 'Misión' : 'Mission'}</h3>
							<p>{t('bento.mission.desc')}</p>
						</div>
						<div class="mv-block" style="margin-top: 1.25rem;">
							<h3>{lang === 'es' ? 'Visión' : 'Vision'}</h3>
							<p>{t('bento.vision.desc')}</p>
						</div>
					</div>
					<div class="visual-accent dna-helix" aria-hidden="true"></div>
				</div>

				<div class="bento-item glass">
					<div class="content">
						<span class="category">{t('bento.next')}</span>
						<h3>{t('bento.next.title')}</h3>
						<p>{t('bento.next.desc')}</p>
					</div>
				</div>

				<div class="bento-item glass wide">
					<div class="content">
						<span class="category">{t('bento.projects')}</span>
						<h3>{t('bento.projects.title')}</h3>
						<p>{t('bento.projects.desc')}</p>
						<span class="link-arrow disabled" style="opacity: 0.75; cursor: default;">
							<span class="material-icons" style="font-size: 0.95rem; vertical-align: -2px; margin-right: 0.3rem;">schedule</span>
							{t('bento.projects.link')}
						</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â
	     COMMUNITY CTA
	Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
	<section class="cta-section animate-in" style="animation-delay: 0.35s">
		<div class="cta-bg" aria-hidden="true">
			<div class="cta-blob cta-blob-1"></div>
			<div class="cta-blob cta-blob-2"></div>
		</div>
		<div class="container cta-content">
			<span class="hero-badge glass">{t('cta.join.pretitle')}</span>
			<h2>
				{t('cta.join.title')} <span class="gradient-text">{t('cta.join.highlight')}</span> {t('cta.join.title2')}
			</h2>
			<p>{t('cta.join.desc')}</p>
			<div class="cta-actions">
				<a href="https://chat.whatsapp.com/CEd3BXnUV879xKuM0MuoXE" target="_blank" rel="noopener noreferrer" class="btn primary">
					{t('cta.join.btn')} <span class="material-icons">arrow_forward</span>
				</a>
				<a href={getLocalePath(lang, 'events')} class="btn secondary">
					{t('cta.join.btn2')}
				</a>
			</div>
		</div>
	</section>

</Layout>

<style>
/* â”€â”€â”€ HERO SPLIT â”€â”€â”€ */
.hero-split {
	position: relative;
	width: 100%;
	min-height: 100vh;
	overflow: hidden;
	display: grid;
	grid-template-columns: 55fr 45fr;
	align-items: center;
}

.hero-content {
	position: relative;
	z-index: 10;
	/* padding izquierdo fluido: entre 2rem y 6rem según pantalla */
	padding: 8rem clamp(1.5rem, 3vw, 4rem) 5rem clamp(2rem, 5vw, 6rem);
	/* ancho máximo fluido: crece con el viewport */
	max-width: clamp(480px, 48vw, 720px);
	margin-left: 0;
}

.mosaic-bg {
