const trackMeta: Record<TrackId, { num: number; icon: string; rgb: string; color: string; chip: string }> = {
	track1: { num: 1, icon: 'water_drop', rgb: 'var(--bd-primary-rgb)', color: 'var(--bd-primary)', chip: 'bd-chip-teal' },
	track2: { num: 2, icon: 'health_and_safety', rgb: 'var(--bd-secondary-rgb)', color: 'var(--bd-secondary)', chip: 'bd-chip-purple' },
	track3: { num: 3, icon: 'compost', rgb: 'var(--bd-tertiary-rgb)', color: 'var(--bd-tertiary)', chip: 'bd-chip-lime' },
};

const trackIds: TrackId[] = ['track1', 'track2', 'track3'];
const countByTrack = (id: TrackId) => finalists.filter((f) => f.track === id).length;
---

<!-- Ancla de compatibilidad para enlaces heredados (#clasificados) -->
<div id="clasificados" style="position:relative; top:-80px;" aria-hidden="true"></div>

<section class="bd-section bd-finalists-section" id="proyectos" aria-labelledby="finalists-title">
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-teal" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">biotech</span>
			{t('biodesign.finalists.badge')}
		</span>
		<h2 class="bd-headline-lg" id="finalists-title">
			{t('biodesign.finalists.title')} <span class="bd-gradient-text">{t('biodesign.finalists.title_highlight')}</span>
		</h2>
		<p class="bd-body-md" style="max-width:760px; margin:0 auto;">
			{t('biodesign.finalists.subtitle')}
		</p>
	</div>

	<!-- Filtros por Track -->
	<div class="bd-fin-filters bd-reveal" role="toolbar" aria-label={t('biodesign.finalists.filter.label')}>
		<button type="button" class="bd-fin-filter is-active" data-fin-filter="all" id="fin-filter-all" aria-pressed="true">
			<span class="material-icons" aria-hidden="true">apps</span>
			{t('biodesign.finalists.filter.all')}
			<span class="bd-fin-filter-count">{finalists.length}</span>
		</button>
		{trackIds.map((id) => (
			<button
				type="button"
				class="bd-fin-filter"
				data-fin-filter={id}
				id={`fin-filter-${id}`}
				aria-pressed="false"
				style={`--fin-rgb: ${trackMeta[id].rgb}; --fin-color: ${trackMeta[id].color};`}
			>
				<span class="material-icons" aria-hidden="true">{trackMeta[id].icon}</span>
				<span class="bd-fin-filter-label">
					Track {trackMeta[id].num}: {t(`biodesign.tracks.${id}.title`)}
				</span>
				<span class="bd-fin-filter-count">{countByTrack(id)}</span>
			</button>
		))}
	</div>

	<!-- Grid del Ranking Oficial Top 10 -->
	<ol class="bd-fin-grid bd-reveal" id="finalists-grid">
		{finalists.map((f) => {
			const meta = trackMeta[f.track];
			const trackTitle = `Track ${meta.num}: ${t(`biodesign.tracks.${f.track}.title`)}`;
			return (
				<li
					class={`bd-fin-card bd-glass ${f.rank <= 3 ? `bd-fin-card--top${f.rank}` : ''}`}
					data-track={f.track}
					id={`finalist-${f.code.toLowerCase()}`}
					style={`--fin-rgb: ${meta.rgb}; --fin-color: ${meta.color};`}
				>
					<div class="bd-fin-card-glow" aria-hidden="true"></div>
					<div class="bd-fin-card-top">
						<div class="bd-fin-rank-wrap">
							<span class="bd-fin-rank">#{f.rank}</span>
							<span class="bd-fin-code">{f.code}</span>
						</div>
						<span class="bd-fin-score">{f.score}</span>
					</div>

					<h3 class="bd-fin-project">{f.project}</h3>

					<p class="bd-fin-team">
						<span class="material-icons" aria-hidden="true">groups</span>
						<span><strong>{f.team}</strong> · {f.school} ({f.region})</span>
					</p>

					<div class="bd-fin-pills-row">
						<span class={`bd-chip ${meta.chip} bd-fin-track-chip`}>
							<span class="material-icons" style="font-size:12px;" aria-hidden="true">{meta.icon}</span>
							{trackTitle}
						</span>
						<span class="bd-fin-chassis-pill" title={f.chassisFull}>
							<span class="material-icons" style="font-size:12px;" aria-hidden="true">science</span>
							<em>{f.chassisShort}</em>
						</span>
					</div>

					<div class="bd-fin-card-footer">
						<button
							type="button"
							class="bd-fin-sheet-btn"
							data-project-trigger={f.code}
							data-rank={`#${f.rank}`}
							data-code={f.code}
							data-team={f.team}
							data-project={f.project}
							data-score={f.score}
							data-breakdown={f.breakdown || ''}
							data-tiebreaker={f.tiebreaker || ''}
							data-track={trackTitle}
							data-school={`${f.school} (${f.region})`}
							data-chassis={f.chassisFull}
							data-summary={f.summary}
							data-members={f.members}
							data-advisor={f.advisor || ''}
						>
							<span>{t('biodesign.finalists.view_sheet')}</span>
							<span class="material-icons" style="font-size:15px;" aria-hidden="true">arrow_forward</span>
						</button>
					</div>
				</li>
			);
		})}
	</ol>
</section>

<!-- ═══════════════════════════════════════════
     MODAL NATIVO <dialog>: FICHA TÉCNICA EJECUTIVA
     ═══════════════════════════════════════════ -->
<dialog class="bd-project-dialog" id="bd-project-sheet-dialog" aria-labelledby="bd-dialog-proj-title">
	<div class="bd-dialog-inner">
		<div class="bd-dialog-header">
			<div class="bd-dialog-badges">
				<span class="bd-dialog-rank" id="bd-dialog-rank">#1</span>
				<span class="bd-dialog-code" id="bd-dialog-code">EQ-09</span>
				<span class="bd-dialog-score" id="bd-dialog-score">93.33 pts</span>
				<span class="bd-dialog-breakdown" id="bd-dialog-breakdown" hidden></span>
			</div>
			<button type="button" class="bd-dialog-close" id="bd-dialog-close-btn" aria-label={t('biodesign.tracks.modal.close')}>
				<span class="material-icons">close</span>
			</button>
		</div>

		<div class="bd-dialog-body">
			<span class="bd-dialog-track" id="bd-dialog-track">Track 1</span>
			<h3 class="bd-headline-md bd-dialog-title" id="bd-dialog-proj-title">PET2PHA</h3>
			<p class="bd-dialog-team-line">
				<strong id="bd-dialog-team">BioSynTech</strong> · <span id="bd-dialog-school">Colegio Claretiano</span>
			</p>

			<div class="bd-dialog-box">
				<div class="bd-dialog-box-label">
					<span class="material-icons" style="font-size:15px; color:var(--bd-primary);">biotech</span>
					<span>{t('biodesign.finalists.sheet.chassis')}</span>
				</div>
				<p class="bd-dialog-box-val" id="bd-dialog-chassis"></p>
			</div>

			<div class="bd-dialog-box">
				<div class="bd-dialog-box-label">
					<span class="material-icons" style="font-size:15px; color:var(--bd-tertiary);">description</span>
					<span>{t('biodesign.finalists.sheet.summary')}</span>
				</div>
				<p class="bd-dialog-box-val" id="bd-dialog-summary"></p>
			</div>

			<div class="bd-dialog-meta-grid">
				<div class="bd-dialog-meta-item">
					<span class="bd-dialog-meta-lbl">{t('biodesign.finalists.sheet.members')}</span>
					<p class="bd-dialog-meta-txt" id="bd-dialog-members"></p>
				</div>
				<div class="bd-dialog-meta-item" id="bd-dialog-advisor-wrap">
					<span class="bd-dialog-meta-lbl">{t('biodesign.finalists.sheet.advisor')}</span>
					<p class="bd-dialog-meta-txt" id="bd-dialog-advisor"></p>
				</div>
			</div>
		</div>

		<div class="bd-dialog-footer">
			<button type="button" class="bd-btn-secondary bd-dialog-footer-close" id="bd-dialog-footer-close">
				{t('biodesign.tracks.modal.close')}
			</button>
		</div>
	</div>
</dialog>

<script>
	function initFinalistsPortfolio() {
		const section = document.getElementById('proyectos');
		if (!section) return;

		// 1. Filtro por Track
		const buttons = section.querySelectorAll<HTMLButtonElement>('[data-fin-filter]');
		const cards = section.querySelectorAll<HTMLElement>('.bd-fin-card');

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.dataset.finFilter;
				buttons.forEach((b) => {
					const active = b === btn;
					b.classList.toggle('is-active', active);
					b.setAttribute('aria-pressed', String(active));
				});
				cards.forEach((card) => {
					const show = filter === 'all' || card.dataset.track === filter;
					card.classList.toggle('is-hidden', !show);
				});
			});
		});

		// 2. Modal nativo <dialog> de Ficha Técnica
		const dialog = document.getElementById('bd-project-sheet-dialog') as HTMLDialogElement | null;
		if (!dialog) return;

		const rankEl = document.getElementById('bd-dialog-rank');
		const codeEl = document.getElementById('bd-dialog-code');
		const scoreEl = document.getElementById('bd-dialog-score');
		const breakdownEl = document.getElementById('bd-dialog-breakdown');
		const trackEl = document.getElementById('bd-dialog-track');
		const titleEl = document.getElementById('bd-dialog-proj-title');
		const teamEl = document.getElementById('bd-dialog-team');
		const schoolEl = document.getElementById('bd-dialog-school');
		const chassisEl = document.getElementById('bd-dialog-chassis');
		const summaryEl = document.getElementById('bd-dialog-summary');
		const membersEl = document.getElementById('bd-dialog-members');
		const advisorWrap = document.getElementById('bd-dialog-advisor-wrap');
		const advisorEl = document.getElementById('bd-dialog-advisor');

		let lastTrigger: HTMLElement | null = null;

		function openProjectDialog(btn: HTMLButtonElement) {
			if (!dialog) return;
			lastTrigger = btn;

			if (rankEl) rankEl.textContent = btn.dataset.rank || '';
			if (codeEl) codeEl.textContent = btn.dataset.code || '';
			if (scoreEl) scoreEl.textContent = btn.dataset.score || '';

			const extra = btn.dataset.breakdown || btn.dataset.tiebreaker || '';
			if (breakdownEl) {
				breakdownEl.textContent = extra;
				breakdownEl.hidden = !extra;
			}

			if (trackEl) trackEl.textContent = btn.dataset.track || '';
			if (titleEl) titleEl.textContent = btn.dataset.project || '';
			if (teamEl) teamEl.textContent = btn.dataset.team || '';
			if (schoolEl) schoolEl.textContent = btn.dataset.school || '';
			if (chassisEl) chassisEl.textContent = btn.dataset.chassis || '';
			if (summaryEl) summaryEl.textContent = btn.dataset.summary || '';
			if (membersEl) membersEl.textContent = btn.dataset.members || '';

			const advisor = btn.dataset.advisor || '';
			if (advisorWrap && advisorEl) {
				advisorEl.textContent = advisor;
				advisorWrap.hidden = !advisor;
			}

			if (typeof dialog.showModal === 'function') {
				dialog.showModal();
			} else {
				dialog.setAttribute('open', '');
			}
		}

		function closeProjectDialog() {
			if (!dialog) return;
			if (typeof dialog.close === 'function') {
				dialog.close();
			} else {
				dialog.removeAttribute('open');
			}
			if (lastTrigger) lastTrigger.focus();
		}

		section.querySelectorAll<HTMLButtonElement>('[data-project-trigger]').forEach((btn) => {
			btn.addEventListener('click', () => openProjectDialog(btn));
		});

		document.getElementById('bd-dialog-close-btn')?.addEventListener('click', closeProjectDialog);
		document.getElementById('bd-dialog-footer-close')?.addEventListener('click', closeProjectDialog);

		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) closeProjectDialog();
		});
	}

	initFinalistsPortfolio();
	document.addEventListener('astro:page-load', initFinalistsPortfolio);
</script>

