---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const isEs = lang === 'es';

const EMAIL_CONTACT = 'cbs.unmsm@gmail.com';
const LINKEDIN_URL = 'https://www.linkedin.com/company/cbs-unmsm';

const mailtoSubject = encodeURIComponent(
	isEs ? 'Solicitud de Dossier de Patrocinio - BioDesign 2027' : 'Sponsorship Dossier Request - BioDesign 2027'
);
const mailtoBody = encodeURIComponent(
	isEs
		? `Hola equipo de CBS-UNMSM y NEA,\n\nRepresento a [Nombre de la institución / empresa] y estamos interesados en conversar sobre una alianza de patrocinio para escalar los proyectos de BioDesign al laboratorio y apoyar la Edición 2027.\n\n- Nivel de interés preliminar: [Impulsor / Constructor / Diseñador]\n- Modalidad tentativa: [Aporte dinerario / En especie / Mixto]\n\nQuedamos atentos al envío del dossier oficial para coordinar una reunión.\n\nSaludos cordiales,`
		: `Hello CBS-UNMSM & NEA team,\n\nI represent [Organization / Company Name] and we are interested in discussing a sponsorship partnership to incubate BioDesign prototypes in the lab and support the 2027 Edition.\n\n- Preliminary tier of interest: [Impulsor / Constructor / Diseñador]\n- Tentative modality: [Financial / In-kind / Mixed]\n\nWe look forward to receiving the official dossier to schedule a meeting.\n\nBest regards,`
);
const mailtoUrl = `mailto:${EMAIL_CONTACT}?subject=${mailtoSubject}&body=${mailtoBody}`;

// ── 2 Destinos Estratégicos de los Fondos ──────────────────────
const goals = [
	{
		icon: 'science',
		title: isEs
			? '1. Incubación e implementación in vitro'
			: '1. In vitro incubation & lab implementation',
		desc: isEs
			? 'Llevar los prototipos ganadores del diseño computacional (in silico) a la validación experimental en laboratorios universitarios.'
			: 'Bring winning computational prototypes (in silico) into experimental wet-lab validation at university laboratories.',
		accent: 'var(--bd-primary)',
		rgb: 'var(--bd-primary-rgb)',
	},
	{
		icon: 'public',
		title: isEs
			? '2. Financiamiento de la 2.ª Edición (BioDesign 2027)'
			: '2. Funding the 2nd Edition (BioDesign 2027)',
		desc: isEs
			? 'Ampliar la gira nacional presencial, becar a delegaciones regionales y escalar el semillero escolar de biología sintética.'
			: 'Expand the national school tour, fund regional delegation travel, and scale the high school synthetic biology pipeline.',
		accent: 'var(--bd-tertiary)',
		rgb: 'var(--bd-tertiary-rgb)',
	},
];

// ── 3 Categorías de Alianza (SIN precios ni cupos) ─────────────
const tiers = [
	{
		id: 'impulsor',
		name: 'IMPULSOR',
		subtitle: isEs ? 'Patrocinador Aliado' : 'Allied Sponsor',
		icon: 'bolt',
		featured: false,
		accent: 'var(--bd-primary)',
		rgb: 'var(--bd-primary-rgb)',
		inkind: isEs
			? 'Papelería, credenciales institucionales (lanyards y lapiceros), imprenta de programas o presentes protocolares para el jurado.'
			: 'Stationery, official credentials (lanyards and pens), printed programs, or protocol gifts for the jury.',
		benefits: isEs
			? [
					'Logotipo en la web oficial de BioDesign',
					'Mención de agradecimiento en redes sociales',
					'Logotipo en el slide oficial de cierre del Pitch Day',
					'Certificado Oficial de Aliado BioDesign',
				]
			: [
					'Logo on the official BioDesign website',
					'Thank-you mention across social media channels',
					'Logo on the official Pitch Day closing slide',
					'Official BioDesign Allied Partner Certificate',
				],
	},
	{
		id: 'constructor',
		name: 'CONSTRUCTOR',
		subtitle: isEs ? 'Patrocinador Oficial' : 'Official Sponsor',
		icon: 'hub',
		featured: false,
		accent: 'var(--bd-secondary)',
		rgb: 'var(--bd-secondary-rgb)',
		inkind: isEs
			? 'Coffee break de la jornada presencial, medallas acrílicas con diplomas o señalética integral del auditorio (banners y Roll Ups).'
			: 'In-person finale coffee break, acrylic medals with diplomas, or full auditorium signage (banners & roll-ups).',
		benefits: isEs
			? [
					'Todos los beneficios de la categoría Impulsor',
					'Presencia de marca en piezas gráficas y banners del evento',
					'Inserción de souvenirs o folletería en el Kit de Bienvenida',
					'Inclusión en las Memorias Técnicas Oficiales',
					'Acceso al Talento (compendio de proyectos y perfiles destacados)',
				]
			: [
					'All benefits from the Impulsor tier',
					'Brand placement on graphic assets and event banners',
					'Souvenir or brochure inclusion in the Welcome Kit',
					'Recognition in the Official Technical Proceedings',
					'Talent Access (compendium of top projects and student profiles)',
				],
	},
	{
		id: 'disenador',
		name: 'DISEÑADOR',
		subtitle: isEs ? 'Patrocinador Principal' : 'Lead Sponsor',
		icon: 'workspace_premium',
		featured: true,
		accent: 'var(--bd-tertiary)',
		rgb: 'var(--bd-tertiary-rgb)',
		inkind: isEs
			? 'Padrinazgo oficial de un puesto del Podio (trofeos, medallas Zamak, pasajes de delegaciones regionales a laboratorio y kits científicos) + infraestructura (Backdrop de prensa o indumentaria del comité).'
			: 'Official patronage of a Podium place (trophies, Zamak medals, regional delegation lab travel, and science kits) + infrastructure (press backdrop or committee apparel).',
		benefits: isEs
			? [
					'Todos los beneficios de la categoría Constructor',
					'Derecho de Nombre Oficial en 1 de los 3 premios del Podio',
					'Logotipo de máxima jerarquía en Backdrop de prensa y diplomas',
					'Mención protocolar en la ceremonia de inauguración y clausura',
					'Reel audiovisual dedicado post-evento en canales oficiales',
				]
			: [
					'All benefits from the Constructor tier',
					'Official Naming Right on 1 of the 3 Podium awards',
					'Top-tier logo placement on the Press Backdrop and diplomas',
					'Protocol mention during the opening and closing ceremonies',
					'Dedicated post-event social media reel on official channels',
				],
	},
];

// ── Reglas de Homologación ─────────────────────────────────────
const rules = [
	{
		icon: 'sync_alt',
		title: isEs ? 'Aporte Dinerario o en Especie 1:1' : '1:1 Financial or In-Kind Contribution',
		desc: isEs ? 'Equivalencia comprobable en bienes o servicios para el evento.' : 'Verifiable equivalence in goods or services for the program.',
	},
	{
		icon: 'tune',
		title: isEs ? 'Modalidad Mixta Flexible' : 'Flexible Mixed Modality',
		desc: isEs ? 'Combina patrocinio financiero con ítems en especie a medida.' : 'Combine direct funding with tailored in-kind contributions.',
	},
	{
		icon: 'verified',
		title: isEs ? 'Certificación Institucional' : 'Institutional Certification',
		desc: isEs ? 'Respaldo oficial emitido por CBS-UNMSM y NEA.' : 'Official endorsement issued by CBS-UNMSM and NEA.',
	},
];

// ── Flujo de Conversación en 3 Pasos ───────────────────────────
const steps = [
	{
		num: '01',
		title: isEs ? 'Iniciemos el contacto' : 'Start the conversation',
		desc: isEs
			? 'Escríbenos indicando tu organización y el nivel o línea de apoyo de tu interés.'
			: 'Write to us sharing your organization and the partnership tier or focus of interest.',
	},
	{
		num: '02',
		title: isEs ? 'Envío del Dossier Oficial' : 'Receive the Official Dossier',
		desc: isEs
			? 'Te compartimos el One Pager detallado con las especificaciones técnicas e ítems requeridos.'
			: 'We send you the detailed One Pager with technical specifications and required items.',
	},
	{
		num: '03',
		title: isEs ? 'Acuerdo a medida' : 'Tailored partnership agreement',
		desc: isEs
			? 'Definimos conjuntamente los entregables de visibilidad, incubación o padrinazgo para 2027.'
			: 'We jointly define visibility, incubation, or podium patronage deliverables for 2027.',
	},
];
---

<section class="bd-section bd-funding-section" id="financiamiento" aria-labelledby="funding-title">
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">handshake</span>
			{t('biodesign.funding.badge')}
		</span>
		<h2 class="bd-headline-lg" id="funding-title">
			{t('biodesign.funding.title')} <span class="bd-gradient-text">{t('biodesign.funding.title_highlight')}</span>
		</h2>
		<p class="bd-body-md bd-funding-value-prop">
			{t('biodesign.funding.value_prop')}
		</p>
	</div>

	<!-- 1. Destinos Estratégicos del Financiamiento -->
	<div class="bd-funding-goals bd-reveal">
		{goals.map((g) => (
			<div class="bd-glass bd-goal-card" style={`--goal-accent: ${g.accent}; --goal-rgb: ${g.rgb};`}>
				<div class="bd-goal-icon">
					<span class="material-icons" aria-hidden="true">{g.icon}</span>
				</div>
				<div>
					<h3 class="bd-goal-title">{g.title}</h3>
					<p class="bd-goal-desc">{g.desc}</p>
				</div>
			</div>
		))}
	</div>

	<!-- 2. Niveles de Alianza (Desktop: 3 Columnas / Móvil: Acordeón <details>) -->
	<div class="bd-tiers-grid bd-reveal">
		{tiers.map((tier) => (
			<article
				class={`bd-glass bd-tier-card ${tier.featured ? 'bd-tier-card--featured' : ''}`}
				style={`--tier-accent: ${tier.accent}; --tier-rgb: ${tier.rgb};`}
			>
				{tier.featured && (
					<span class="bd-tier-featured-ribbon">
						<span class="material-icons" style="font-size:12px;">star</span>
						{isEs ? 'MÁXIMA JERARQUÍA' : 'TOP HIERARCHY'}
					</span>
				)}

				<div class="bd-tier-head">
					<div class="bd-tier-icon-wrap">
						<span class="material-icons" aria-hidden="true">{tier.icon}</span>
					</div>
					<div>
						<span class="bd-tier-subtitle">{tier.subtitle}</span>
						<h3 class="bd-tier-name">{tier.name}</h3>
					</div>
				</div>

				<!-- Acordeón nativo en móvil / Abierto en Desktop -->
				<details class="bd-tier-details" open>
					<summary class="bd-tier-summary">
						<span>{t('biodesign.funding.toggle_details')}</span>
						<span class="material-icons bd-tier-chevron" aria-hidden="true">expand_more</span>
					</summary>

					<div class="bd-tier-body">
						<div class="bd-tier-inkind-box">
							<span class="bd-tier-sec-label">
								<span class="material-icons" style="font-size:13px;">inventory_2</span>
								{t('biodesign.funding.inkind_label')}
							</span>
							<p class="bd-tier-inkind-text">{tier.inkind}</p>
						</div>

						<div class="bd-tier-benefits-wrap">
							<span class="bd-tier-sec-label">
								<span class="material-icons" style="font-size:13px;">verified</span>
								{t('biodesign.funding.benefits_label')}
							</span>
							<ul class="bd-tier-benefits">
								{tier.benefits.map((b) => (
									<li>
										<span class="material-icons" aria-hidden="true">check_circle</span>
										<span>{b}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</details>
			</article>
		))}
	</div>

	<!-- 3. Píldoras de Modalidades de Homologación -->
	<div class="bd-funding-rules bd-reveal">
		{rules.map((r) => (
			<div class="bd-glass bd-rule-pill">
				<span class="material-icons bd-rule-icon" aria-hidden="true">{r.icon}</span>
				<div>
					<strong>{r.title}</strong>
					<span>{r.desc}</span>
				</div>
			</div>
		))}
	</div>

	<!-- 4. Flujo de Conversación y Contacto Directo + CTA Colegios 2027 -->
	<div class="bd-glass bd-funding-contact-card bd-reveal">
		<div class="bd-funding-steps">
			{steps.map((s) => (
				<div class="bd-funding-step">
					<span class="bd-funding-step-num">{s.num}</span>
					<div>
						<strong>{s.title}</strong>
						<p>{s.desc}</p>
					</div>
				</div>
			))}
		</div>

		<div class="bd-funding-contact-main">
			<div class="bd-funding-leads">
				<span class="bd-chip bd-chip-teal" style="font-size:0.68rem; margin-bottom:0.4rem;">
					<span class="material-icons" style="font-size:12px;">contact_mail</span>
					{t('biodesign.funding.contact.badge')}
				</span>
				<h3 class="bd-headline-md" style="margin:0 0 0.35rem;">
					{t('biodesign.funding.contact.title')}
				</h3>
				<p class="bd-caption" style="color:var(--bd-on-surface-variant); margin:0 0 0.85rem;">
					{t('biodesign.funding.contact.subtitle')}
				</p>

				<div class="bd-leads-list">
					<div class="bd-lead-item">
						<span class="material-icons" aria-hidden="true">person</span>
						<div>
							<strong>Marko A. Zapata Roca</strong>
							<span>{isEs ? 'Presidente de la Comisión (CBS-UNMSM)' : 'Committee President (CBS-UNMSM)'}</span>
						</div>
					</div>
					<div class="bd-lead-item">
						<span class="material-icons" aria-hidden="true">person</span>
						<div>
							<strong>Fabio M. Farias Saavedra</strong>
							<span>{isEs ? 'Vicepresidente de la Comisión (NEA)' : 'Committee Vice President (NEA)'}</span>
						</div>
					</div>
				</div>
			</div>

			<div class="bd-funding-cta-col">
				<a href={mailtoUrl} class="bd-btn-primary bd-funding-main-btn">
					<span class="material-icons" style="font-size:1.1rem;">mail</span>
					{t('biodesign.funding.contact.cta_dossier')}
				</a>

				<div class="bd-funding-sub-btns">
					<button
						type="button"
						class="bd-btn-secondary bd-copy-btn bd-funding-copy-btn"
						data-copy-target={EMAIL_CONTACT}
					>
						<span class="material-icons" style="font-size:1rem;">content_copy</span>
						<span class="bd-copy-text">{EMAIL_CONTACT}</span>
					</button>

					<a
						href={LINKEDIN_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="bd-btn-secondary bd-funding-linkedin-btn"
					>
						<span class="material-icons" style="font-size:1rem;">open_in_new</span>
						LinkedIn CBS-UNMSM
					</a>
				</div>
			</div>
		</div>

		<!-- Franja para Colegios: Lleva BioDesign 2027 a tu institución -->
		<div class="bd-school-2027-banner">
			<div class="bd-school-2027-left">
				<span class="material-icons" style="color:var(--bd-tertiary); font-size:1.5rem;">school</span>
				<div>
					<strong>{t('biodesign.school.cta2027.title')}</strong>
					<p>{t('biodesign.school.cta2027.desc')}</p>
				</div>
			</div>
			<button type="button" class="bd-btn-secondary bd-school-2027-btn" id="open-school-modal">
				<span class="material-icons" style="font-size:1rem;">campaign</span>
				{t('biodesign.school.cta2027.btn')}
			</button>
		</div>
	</div>
</section>

<script>
	function initFundingResponsiveDetails() {
		const detailsList = document.querySelectorAll<HTMLDetailsElement>('#financiamiento .bd-tier-details');
		if (!detailsList.length) return;

		const mq = window.matchMedia('(max-width: 860px)');
		function syncDetails(e: MediaQueryList | MediaQueryListEvent) {
			detailsList.forEach((d, idx) => {
				if (e.matches) {
					// En móvil abrimos solo el destacado por defecto para evitar scroll largo
					d.open = idx === 2;
				} else {
					d.open = true;
				}
			});
		}
		syncDetails(mq);
		mq.addEventListener('change', syncDetails);
	}

	initFundingResponsiveDetails();
	document.addEventListener('astro:page-load', initFundingResponsiveDetails);
</script>

<style>
	.bd-funding-section {
		position: relative;
	}

	.bd-funding-value-prop {
		max-width: 820px;
		margin: 0 auto;
		font-size: clamp(0.95rem, 1.25vw, 1.08rem);
		color: var(--bd-on-surface);
	}

	/* ── Destinos de fondos ── */
	.bd-funding-goals {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.15rem;
		margin-top: 2rem;
	}

	.bd-goal-card {
		--goal-accent: var(--bd-primary);
		--goal-rgb: var(--bd-primary-rgb);
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		padding: 1.25rem 1.35rem;
		border-radius: 1.15rem;
		border: 1px solid rgba(var(--goal-rgb), 0.32);
	}

	.bd-goal-icon {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.7rem;
		background: rgba(var(--goal-rgb), 0.14);
		color: var(--goal-accent);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.bd-goal-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		margin: 0 0 0.25rem;
	}

	.bd-goal-desc {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--bd-on-surface-variant);
	}

	/* ── 3 Niveles de Alianza ── */
	.bd-tiers-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-top: 1.25rem;
		align-items: stretch;
	}

	.bd-tier-card {
		--tier-accent: var(--bd-primary);
		--tier-rgb: var(--bd-primary-rgb);
		position: relative;
		padding: 1.5rem;
		border-radius: 1.35rem;
		border: 1px solid rgba(var(--tier-rgb), 0.32);
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.bd-tier-card--featured {
		border: 1.5px solid rgba(var(--bd-tertiary-rgb), 0.65);
		background: linear-gradient(160deg, rgba(var(--bd-tertiary-rgb), 0.1) 0%, var(--bd-glass-fill) 55%);
		box-shadow: 0 12px 38px -12px rgba(var(--bd-tertiary-rgb), 0.3);
	}

	.bd-tier-featured-ribbon {
		position: absolute;
		top: 0.9rem;
		right: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		background: rgba(var(--bd-tertiary-rgb), 0.2);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.45);
		color: var(--bd-tertiary);
	}

	.bd-tier-head {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	.bd-tier-icon-wrap {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.8rem;
		background: rgba(var(--tier-rgb), 0.14);
		border: 1px solid rgba(var(--tier-rgb), 0.35);
		color: var(--tier-accent);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.bd-tier-subtitle {
		display: block;
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--bd-on-surface-variant);
	}

	.bd-tier-name {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--tier-accent);
		margin: 0;
		letter-spacing: 0.02em;
	}

	.bd-tier-summary {
		display: none;
		align-items: center;
		justify-content: space-between;
		padding: 0.55rem 0.8rem;
		border-radius: 0.65rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--tier-accent);
		cursor: pointer;
		list-style: none;
	}

	.bd-tier-summary::-webkit-details-marker {
		display: none;
	}

	.bd-tier-body {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.bd-tier-inkind-box {
		padding: 0.8rem 0.9rem;
		border-radius: 0.85rem;
		background: rgba(var(--tier-rgb), 0.07);
		border: 1px solid rgba(var(--tier-rgb), 0.22);
	}

	.bd-tier-sec-label {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--tier-accent);
		margin-bottom: 0.35rem;
	}

	.bd-tier-inkind-text {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--bd-on-surface);
	}

	.bd-tier-benefits {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.bd-tier-benefits li {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--bd-on-surface-variant);
	}

	.bd-tier-benefits .material-icons {
		font-size: 0.95rem;
		color: var(--tier-accent);
		margin-top: 2px;
