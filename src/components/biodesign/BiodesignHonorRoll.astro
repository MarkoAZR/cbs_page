			id="honor-panel-tracks"
			role="tabpanel"
			aria-labelledby="honor-tab-tracks"
			class="bd-honor-panel"
			data-honor-panel="tracks"
			hidden
		>
			<div class="bd-track-winners-grid">
				{trackWinners.map((tw) => (
					<article class="bd-glass bd-tw-card" style={`--tw-color: ${tw.color}; --tw-rgb: ${tw.rgb};`}>
						<div class="bd-tw-head">
							<span class="material-icons bd-tw-icon" aria-hidden="true">{tw.icon}</span>
							<span class="bd-tw-track">{tw.trackNum}</span>
							<span class="bd-tw-score">{tw.score}</span>
						</div>
						<p class="bd-tw-category">{tw.category}</p>
						<h3 class="bd-tw-project">
							<span class="bd-tw-code">{tw.code}</span> {tw.team} — <em>{tw.project}</em>
						</h3>
						<p class="bd-tw-school">{tw.school}</p>
					</article>
				))}
			</div>

			<div class="bd-special-awards-grid">
				{specialAwards.map((sa) => (
					<article class="bd-glass bd-special-card" style={`--sa-color: ${sa.color}; --sa-rgb: ${sa.rgb};`}>
						<div class="bd-special-top">
							<span class="material-icons bd-special-icon" aria-hidden="true">{sa.icon}</span>
							<span class="bd-special-badge">{sa.badge}</span>
						</div>
						<h3 class="bd-special-title">{sa.title}</h3>
						<p class="bd-special-school">{sa.school}</p>
						<p class="bd-special-desc">{sa.desc}</p>
						<div class="bd-special-meta">
							<span><strong>{isEs ? 'Integrantes:' : 'Members:'}</strong> {sa.members}</span>
							{sa.advisor && <span> · {sa.advisor}</span>}
						</div>
					</article>
				))}
			</div>
		</div>

		<!-- PANEL 3: EXCELENCIA ACADÉMICA EN EL BOOTCAMP (QUIZIZZ) -->
		<div
			id="honor-panel-quizizz"
			role="tabpanel"
			aria-labelledby="honor-tab-quizizz"
			class="bd-honor-panel"
			data-honor-panel="quizizz"
			hidden
		>
			<div class="bd-quizizz-intro">
				<span class="material-icons" style="color:var(--bd-primary);">emoji_objects</span>
				<p class="bd-body-sm" style="margin:0;">
					{t('biodesign.honor.quizizz.desc')}
				</p>
			</div>

			<div class="bd-quizizz-grid">
				{quizizzWinners.map((q) => (
					<article class={`bd-glass bd-quizizz-card ${q.isTie ? 'bd-quizizz-card--tie' : ''}`}>
						<div class="bd-quizizz-top">
							<span class="bd-chip bd-chip-teal" style="font-size:0.68rem;">{q.session}</span>
							<span class="bd-quizizz-code">{q.code}</span>
						</div>
						<h3 class="bd-quizizz-student">
							<span class="material-icons" aria-hidden="true">stars</span>
							{q.student}
						</h3>
						<p class="bd-quizizz-school">{q.school}</p>
						<p class="bd-quizizz-topic">
							<strong>{isEs ? 'Mérito:' : 'Merit:'}</strong> 1.° {isEs ? 'puesto en' : 'place in'} {q.topic}
						</p>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	function initHonorRollTabs() {
		const section = document.getElementById('ganadores');
		if (!section) return;

		const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-honor-tab]'));
		const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-honor-panel]'));

		function activateTab(targetTab: HTMLButtonElement, focusTab = false) {
			const targetKey = targetTab.dataset.honorTab;
			tabs.forEach((tab) => {
				const active = tab === targetTab;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
			});
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.honorPanel !== targetKey;
			});
			if (focusTab) targetTab.focus();
		}

		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => activateTab(tab));
			tab.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight') {
					e.preventDefault();
					activateTab(tabs[(idx + 1) % tabs.length], true);
				} else if (e.key === 'ArrowLeft') {
					e.preventDefault();
					activateTab(tabs[(idx - 1 + tabs.length) % tabs.length], true);
				}
			});
		});

		// Botones "Ver ficha técnica" desde el podio
		section.querySelectorAll<HTMLButtonElement>('[data-open-project]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const code = btn.dataset.openProject;
				if (!code) return;
				const trigger = document.querySelector<HTMLButtonElement>(`[data-project-trigger="${code}"]`);
				if (trigger) {
					trigger.click();
				} else {
					const projSection = document.getElementById('proyectos');
					projSection?.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});
	}

	initHonorRollTabs();
	document.addEventListener('astro:page-load', initHonorRollTabs);
</script>

<style>
	.bd-honor-section {
		position: relative;
	}

	.bd-honor-tabs-wrap {
		margin-top: 2rem;
	}

	.bd-honor-tablist {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-bottom: 1.75rem;
	}

	.bd-honor-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1.2rem;
		border-radius: 999px;
		background: var(--bd-glass-fill);
		border: 1px solid var(--bd-outline-variant);
		color: var(--bd-on-surface-variant);
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.86rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.bd-honor-tab .material-icons {
		font-size: 1.1rem;
		color: var(--bd-primary);
	}

	.bd-honor-tab:hover {
		border-color: rgba(var(--bd-primary-rgb), 0.5);
		color: var(--bd-text-primary);
	}

	.bd-honor-tab.is-active {
		background: rgba(var(--bd-primary-rgb), 0.14);
		border-color: var(--bd-primary);
		color: var(--bd-text-primary);
		box-shadow: 0 0 20px rgba(var(--bd-primary-rgb), 0.22);
	}

	.bd-tab-badge {
		font-size: 0.7rem;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: rgba(var(--bd-primary-rgb), 0.18);
		color: var(--bd-primary);
	}

	/* ── Podio Grid ── */
	.bd-podium-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		align-items: stretch;
	}

	.bd-podium-card {
		--pod-accent: #fbbf24;
		--pod-rgb: 251, 191, 36;
		position: relative;
		padding: 1.5rem;
		border-radius: 1.35rem;
		border: 1.5px solid rgba(var(--pod-rgb), 0.4);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
	}

	.bd-podium-card--gold {
		background: linear-gradient(160deg, rgba(251, 191, 36, 0.12) 0%, var(--bd-glass-fill) 55%);
		box-shadow: 0 12px 38px -12px rgba(251, 191, 36, 0.35);
	}

	.bd-podium-glow {
		position: absolute;
		top: -60px;
		right: -60px;
		width: 170px;
		height: 170px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(var(--pod-rgb), 0.25), transparent 70%);
		pointer-events: none;
	}

	.bd-podium-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.bd-podium-place {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.85rem;
		font-weight: 800;
		color: var(--pod-accent);
	}

	.bd-podium-medal {
		font-size: 1.35rem;
	}

	.bd-podium-code {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
		font-weight: 700;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: rgba(var(--pod-rgb), 0.15);
		border: 1px solid rgba(var(--pod-rgb), 0.4);
		color: var(--pod-accent);
	}

	.bd-podium-project {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--bd-text-primary);
		margin: 0 0 0.35rem;
	}

	.bd-podium-team,
	.bd-podium-school {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.83rem;
		color: var(--bd-on-surface-variant);
		margin: 0.2rem 0 0;
	}

	.bd-podium-team .material-icons,
	.bd-podium-school .material-icons {
		font-size: 1rem;
		color: var(--pod-accent);
	}

	.bd-podium-score-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 0.95rem;
		border-radius: 0.9rem;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(var(--pod-rgb), 0.28);
		margin-top: auto;
	}

	.bd-podium-score-lbl {
		display: block;
		font-size: 0.7rem;
