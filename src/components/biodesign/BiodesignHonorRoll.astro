---

<section class="bd-section bd-honor-section" id="ganadores" aria-labelledby="honor-title">
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">emoji_events</span>
			{t('biodesign.honor.badge')}
		</span>
		<h2 class="bd-headline-lg" id="honor-title">
			{t('biodesign.honor.title')} <span class="bd-gradient-text">{t('biodesign.honor.title_highlight')}</span>
		</h2>
		<p class="bd-body-md" style="max-width:740px; margin:0 auto;">
			{t('biodesign.honor.subtitle')}
		</p>
	</div>

	<!-- Controles de Pestañas (Tabbed Interface) -->
	<div class="bd-honor-tabs-wrap bd-reveal">
		<div class="bd-honor-tablist" role="tablist" aria-label={t('biodesign.honor.tabs.aria')}>
			<button
				type="button"
				role="tab"
				id="honor-tab-podium"
				aria-selected="true"
				aria-controls="honor-panel-podium"
				tabindex="0"
				class="bd-honor-tab is-active"
				data-honor-tab="podium"
			>
				<span class="material-icons" aria-hidden="true">Workspace_premium</span>
				<span>{t('biodesign.honor.tabs.podium')}</span>
				<span class="bd-tab-badge">Top 3</span>
			</button>

			<button
				type="button"
				role="tab"
				id="honor-tab-tracks"
				aria-selected="false"
				aria-controls="honor-panel-tracks"
				tabindex="-1"
				class="bd-honor-tab"
				data-honor-tab="tracks"
			>
				<span class="material-icons" aria-hidden="true">military_tech</span>
				<span>{t('biodesign.honor.tabs.tracks')}</span>
				<span class="bd-tab-badge">5</span>
			</button>

			<button
				type="button"
				role="tab"
				id="honor-tab-quizizz"
				aria-selected="false"
				aria-controls="honor-panel-quizizz"
				tabindex="-1"
				class="bd-honor-tab"
				data-honor-tab="quizizz"
			>
				<span class="material-icons" aria-hidden="true">psychology</span>
				<span>{t('biodesign.honor.tabs.quizizz')}</span>
				<span class="bd-tab-badge">5</span>
			</button>
		</div>

		<!-- PANEL 1: PODIO NACIONAL -->
		<div
			id="honor-panel-podium"
			role="tabpanel"
			aria-labelledby="honor-tab-podium"
			class="bd-honor-panel"
			data-honor-panel="podium"
		>
			<div class="bd-podium-grid">
				{podium.map((p) => (
					<article
						class={`bd-glass bd-podium-card ${p.tierClass}`}
						style={`--pod-accent: ${p.accent}; --pod-rgb: ${p.rgb};`}
					>
						<div class="bd-podium-glow" aria-hidden="true"></div>
						<div class="bd-podium-top">
							<span class="bd-podium-place">
								<span class="bd-podium-medal" aria-hidden="true">{p.medal}</span>
								{p.placeLabel}
							</span>
							<span class="bd-podium-code">{p.code}</span>
						</div>

						<div class="bd-podium-main">
							<h3 class="bd-podium-project">{p.project}</h3>
							<p class="bd-podium-team">
								<span class="material-icons" aria-hidden="true">groups</span>
								{isEs ? 'Equipo' : 'Team'} <strong>{p.team}</strong>
							</p>
							<p class="bd-podium-school">
								<span class="material-icons" aria-hidden="true">school</span>
								{p.school} · <span>{p.region}</span>
							</p>
						</div>

						<div class="bd-podium-score-box">
							<div>
								<span class="bd-podium-score-lbl">{t('biodesign.honor.score_label')}</span>
								<span class="bd-podium-score-breakdown">{p.breakdown}</span>
							</div>
							<div class="bd-podium-score-val">
								{p.score} <small>pts</small>
							</div>
						</div>

						<div class="bd-podium-footer">
							<span class="bd-podium-track-pill">{p.track}</span>
							<button
								type="button"
								class="bd-podium-detail-btn"
								data-open-project={p.code}
