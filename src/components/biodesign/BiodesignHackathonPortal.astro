<script>
	// ── Lógica Interactiva del Portal del Hackathon y Bio-Terminal ──
	function initHackathonPortal() {
		// 1. Acordeones Desplegables Cósmicos
		const accordions = document.querySelectorAll<HTMLElement>('.bd-hack-accordion');
		const btnExpandAll = document.getElementById('btn-accordion-expand-all');
		const btnCollapseAll = document.getElementById('btn-accordion-collapse-all');

		accordions.forEach((acc) => {
			const trigger = acc.querySelector<HTMLButtonElement>('.bd-accordion-trigger');
			if (trigger) {
				trigger.addEventListener('click', () => {
					const isOpen = acc.classList.contains('is-open');
					if (isOpen) {
						acc.classList.remove('is-open');
						trigger.setAttribute('aria-expanded', 'false');
					} else {
						acc.classList.add('is-open');
						trigger.setAttribute('aria-expanded', 'true');
					}
				});
			}
		});

		if (btnExpandAll) {
			btnExpandAll.addEventListener('click', () => {
				accordions.forEach((acc) => {
					acc.classList.add('is-open');
					const trigger = acc.querySelector<HTMLButtonElement>('.bd-accordion-trigger');
					if (trigger) trigger.setAttribute('aria-expanded', 'true');
				});
			});
		}

		if (btnCollapseAll) {
			btnCollapseAll.addEventListener('click', () => {
				accordions.forEach((acc) => {
					acc.classList.remove('is-open');
					const trigger = acc.querySelector<HTMLButtonElement>('.bd-accordion-trigger');
					if (trigger) trigger.setAttribute('aria-expanded', 'false');
				});
			});
		}

		// 2. Visor de Plantilla de Ficha Resumen
		const btnOpenTemplate = document.getElementById('btn-open-template-modal');
		const modalTemplate = document.getElementById('modal-template-sheet');
		const btnCloseTemplate = document.getElementById('btn-close-template-modal');
		const btnCopyTemplate = document.getElementById('btn-copy-template-text');
		const txtCopyTemplate = document.getElementById('txt-copy-template');
		const templateContentEl = document.getElementById('template-text-content');

		function openTemplateModal() {
			if (modalTemplate) {
				modalTemplate.hidden = false;
				document.body.style.overflow = 'hidden';
			}
		}

		function closeTemplateModal() {
			if (modalTemplate) {
				modalTemplate.hidden = true;
				const modalTerminal = document.getElementById('modal-bio-terminal');
				if (!modalTerminal || modalTerminal.hidden) {
					document.body.style.overflow = '';
				}
			}
		}

		if (btnOpenTemplate) btnOpenTemplate.addEventListener('click', openTemplateModal);
		if (btnCloseTemplate) btnCloseTemplate.addEventListener('click', closeTemplateModal);

		if (btnCopyTemplate && templateContentEl) {
			btnCopyTemplate.addEventListener('click', async () => {
				const text = templateContentEl.innerText;
				try {
					await navigator.clipboard.writeText(text);
					if (txtCopyTemplate) {
						const original = txtCopyTemplate.innerText;
						txtCopyTemplate.innerText = '¡Copiado con éxito!';
						btnCopyTemplate.classList.add('bd-btn--copied');
						setTimeout(() => {
							txtCopyTemplate.innerText = original;
							btnCopyTemplate.classList.remove('bd-btn--copied');
						}, 2500);
					}
				} catch {
					// Fallback
				}
			});
		}

		// 3. Simulador de Ensayo de Traducción en la Tarjeta SBOL
		const btnToggleAssay = document.getElementById('btn-toggle-translation-assay');
		const proteinRow = document.getElementById('assay-protein-row');
		const txtAssayBtn = document.getElementById('txt-assay-btn');
		let assayRunning = false;

		if (btnToggleAssay && proteinRow) {
			btnToggleAssay.addEventListener('click', () => {
				assayRunning = !assayRunning;
				if (assayRunning) {
					proteinRow.classList.add('bd-assay-active');
					if (txtAssayBtn) txtAssayBtn.innerText = 'Traducción Verificada ✓';
					playSynthTone(587.33, 'sine', 0.15); // D5
				} else {
					proteinRow.classList.remove('bd-assay-active');
					if (txtAssayBtn) txtAssayBtn.innerText = 'Simular en Benchling';
				}
			});
		}

		// 4. Sintetizador de Audio Web Audio API (Bio-Synth)
		let audioContext: AudioContext | null = null;
		let audioEnabled = true;

		function getAudioContext() {
			if (!audioContext) {
				const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
				if (AudioCtx) {
					audioContext = new AudioCtx();
				}
			}
			if (audioContext && audioContext.state === 'suspended') {
				audioContext.resume();
			}
			return audioContext;
		}

		function playSynthTone(freq: number, type: OscillatorType = 'sine', duration = 0.12) {
			if (!audioEnabled) return;
			try {
				const ctx = getAudioContext();
				if (!ctx) return;
				const osc = ctx.createOscillator();
				const gain = ctx.createGain();
				osc.type = type;
				osc.frequency.setValueAtTime(freq, ctx.currentTime);
				gain.gain.setValueAtTime(0.06, ctx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
				osc.connect(gain);
				gain.connect(ctx.destination);
				osc.start();
				osc.stop(ctx.currentTime + duration);
			} catch {
				// Silently fail if audio not supported
			}
		}

		function playFanfare() {
			if (!audioEnabled) return;
			const notes = [440, 554.37, 659.25, 739.99, 880]; // A4, C#5, E5, F#5, A5
			notes.forEach((freq, idx) => {
				setTimeout(() => {
					playSynthTone(freq, 'triangle', 0.25);
				}, idx * 100);
			});
		}

		const btnAudioToggle = document.getElementById('btn-terminal-audio');
		const iconAudio = document.getElementById('icon-terminal-audio');
		if (btnAudioToggle && iconAudio) {
			btnAudioToggle.addEventListener('click', () => {
				audioEnabled = !audioEnabled;
				if (audioEnabled) {
					iconAudio.innerText = 'volume_up';
					btnAudioToggle.classList.remove('bd-audio-muted');
					playSynthTone(659.25, 'sine', 0.1);
				} else {
					iconAudio.innerText = 'volume_off';
					btnAudioToggle.classList.add('bd-audio-muted');
				}
			});
		}

		// 5. Bio-Terminal Fluorescente (7 Estaciones)
		const btnOpenTerminal = document.getElementById('btn-open-bio-terminal');
		const modalTerminal = document.getElementById('modal-bio-terminal');
		const btnCloseTerminal = document.getElementById('btn-close-bio-terminal');
		const btnFullscreen = document.getElementById('btn-terminal-fullscreen');
		const iconFullscreen = document.getElementById('icon-terminal-fullscreen');

		const btnPrev = document.getElementById('btn-term-prev') as HTMLButtonElement | null;
		const btnNext = document.getElementById('btn-term-next') as HTMLButtonElement | null;
		const txtNext = document.getElementById('txt-term-next');
		const stepBadge = document.getElementById('terminal-step-badge');

		const colonies = document.querySelectorAll<HTMLButtonElement>('.bd-colony');
		const slides = document.querySelectorAll<HTMLElement>('.bd-terminal-slide');
		const gelBands = document.querySelectorAll<HTMLElement>('.bd-gel-band');
		const stepDots = document.querySelectorAll<HTMLElement>('.bd-step-dot');
		const slideFinish = document.getElementById('slide-finish');

		const TOTAL_STATIONS = 7;
		let currentStation = 1;
		const visitedStations = new Set<number>([1]);

		const stationFrequencies: Record<number, number> = {
			1: 440,    // A4 (Misión)
			2: 493.88, // B4 (Sprint)
			3: 554.37, // C#5 (Entregables)
			4: 587.33, // D5 (Rúbrica)
			5: 659.25, // E5 (Pitch & Premios)
			6: 739.99, // F#5 (Ética & IA)
			7: 880,    // A5 (SBOL)
		};

		function setStation(stationNum: number) {
			if (stationNum < 1) stationNum = 1;
			if (stationNum > TOTAL_STATIONS + 1) stationNum = TOTAL_STATIONS + 1;

			currentStation = stationNum;

			// Si estamos en la pantalla final de celebración
			if (currentStation === TOTAL_STATIONS + 1) {
				showFinishScreen();
				return;
			}

			visitedStations.add(currentStation);

			// Actualizar Badge
			if (stepBadge) {
				stepBadge.innerText = `ESTACIÓN ${currentStation} DE ${TOTAL_STATIONS}`;
			}

			// Actualizar Colonias
			colonies.forEach((colony) => {
				const id = Number(colony.dataset.station);
				colony.classList.remove('bd-colony--active');
				if (id === currentStation) {
					colony.classList.add('bd-colony--active');
				}
				if (visitedStations.has(id)) {
					colony.classList.add('bd-colony--visited');
				}
			});

			// Actualizar Slides
			slides.forEach((slide) => {
				const id = Number(slide.dataset.slide);
				if (id === currentStation) {
					slide.hidden = false;
					slide.classList.add('bd-terminal-slide--active');
				} else {
					slide.hidden = true;
					slide.classList.remove('bd-terminal-slide--active');
				}
			});
			if (slideFinish) slideFinish.hidden = true;

			// Actualizar Bandas de Gel de Electroforesis
			gelBands.forEach((band, idx) => {
				const bandStation = idx + 1;
				if (bandStation <= currentStation) {
					band.classList.add('bd-gel-band--lit');
				} else {
					band.classList.remove('bd-gel-band--lit');
				}
			});

			// Actualizar Dots
			stepDots.forEach((dot, idx) => {
				const dotStation = idx + 1;
				dot.classList.remove('bd-step-dot--active');
				if (dotStation === currentStation) {
					dot.classList.add('bd-step-dot--active');
				}
				if (visitedStations.has(dotStation)) {
					dot.classList.add('bd-step-dot--visited');
				}
			});

			// Actualizar Botones de Navegación
			if (btnPrev) {
				btnPrev.disabled = currentStation === 1;
			}
			if (txtNext) {
				if (currentStation === TOTAL_STATIONS) {
					txtNext.innerText = '¡Completar Inducción! 🚀';
				} else {
					txtNext.innerText = 'Siguiente (→)';
				}
			}

			// Sonido Bio-Synth de la estación
			if (stationFrequencies[currentStation]) {
				playSynthTone(stationFrequencies[currentStation], 'sine', 0.12);
			}
		}

		function showFinishScreen() {
			if (stepBadge) {
				stepBadge.innerText = 'INDUCCIÓN TOTAL • ÉXITO';
			}

			// Ocultar slides normales y mostrar final
			slides.forEach(slide => slide.hidden = true);
			if (slideFinish) slideFinish.hidden = false;

			// Iluminar todas las 7 colonias al unísono
			colonies.forEach(colony => {
				colony.classList.add('bd-colony--active');
				colony.classList.add('bd-colony--visited');
			});

			// Iluminar todas las bandas de gel
			gelBands.forEach(band => band.classList.add('bd-gel-band--lit'));

			if (btnPrev) btnPrev.disabled = false;
			if (txtNext) txtNext.innerText = '¡Sprint Listo!';

			// Fanfarria sonora triunfal
			playFanfare();
		}

		colonies.forEach(colony => {
			colony.addEventListener('click', () => {
				const target = Number(colony.dataset.station);
				if (target) setStation(target);
			});
		});

		if (btnPrev) {
			btnPrev.addEventListener('click', () => {
				if (currentStation > 1) {
					setStation(currentStation - 1);
				}
			});
		}

		if (btnNext) {
			btnNext.addEventListener('click', () => {
				setStation(currentStation + 1);
			});
		}

		const btnFinishExit = document.getElementById('btn-finish-exit');
		if (btnFinishExit) {
			btnFinishExit.addEventListener('click', () => {
				closeTerminalModal();
			});
		}

		function openTerminalModal() {
			if (modalTerminal) {
				modalTerminal.hidden = false;
				document.body.style.overflow = 'hidden';
				setStation(1);
			}
		}

		function closeTerminalModal() {
			if (modalTerminal) {
				modalTerminal.hidden = true;
				document.body.style.overflow = '';
				if (document.fullscreenElement) {
					document.exitFullscreen().catch(() => {});
				}
			}
		}

		if (btnOpenTerminal) btnOpenTerminal.addEventListener('click', openTerminalModal);
		if (btnCloseTerminal) btnCloseTerminal.addEventListener('click', closeTerminalModal);

		if (btnFullscreen && modalTerminal) {
			btnFullscreen.addEventListener('click', async () => {
				try {
					if (!document.fullscreenElement) {
						await modalTerminal.requestFullscreen();
						if (iconFullscreen) iconFullscreen.innerText = 'fullscreen_exit';
					} else {
						await document.exitFullscreen();
						if (iconFullscreen) iconFullscreen.innerText = 'fullscreen';
					}
				} catch {
					// Fallback
				}
			});
		}

		document.addEventListener('fullscreenchange', () => {
			if (!document.fullscreenElement && iconFullscreen) {
				iconFullscreen.innerText = 'fullscreen';
			}
		});

		// Cerrar al hacer clic en el backdrop
		if (modalTemplate) {
			modalTemplate.addEventListener('click', (e) => {
				if (e.target === modalTemplate) closeTemplateModal();
			});
		}
		if (modalTerminal) {
			modalTerminal.addEventListener('click', (e) => {
				if (e.target === modalTerminal) closeTerminalModal();
			});
		}

		// Atajos de Teclado
		window.addEventListener('keydown', (e) => {
			if (modalTerminal && !modalTerminal.hidden) {
				if (e.key === 'Escape') {
					closeTerminalModal();
				} else if (e.key === 'ArrowRight' || e.key === ' ') {
					e.preventDefault();
					setStation(currentStation + 1);
				} else if (e.key === 'ArrowLeft') {
					e.preventDefault();
					if (currentStation > 1) {
						setStation(currentStation - 1);
					}
				} else if (e.key === 'f' || e.key === 'F') {
					if (btnFullscreen) btnFullscreen.click();
				}
			} else if (modalTemplate && !modalTemplate.hidden) {
				if (e.key === 'Escape') {
					closeTemplateModal();
				}
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHackathonPortal);
	} else {
		initHackathonPortal();
	}
	document.addEventListener('astro:page-load', initHackathonPortal);
</script>

