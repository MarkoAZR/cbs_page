		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.bd-dl-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		padding: 0.65rem 1.15rem;
		border-radius: 10px;
	}

	.bd-dl-btn--lime {
		box-shadow: 0 0 15px rgba(187, 243, 95, 0.25);
	}

	/* ── RÚBRICA BARS ── */
	.bd-rubric-bars {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.bd-rubric-bar-item {
		padding: 0.4rem 0;
	}

	.bd-bar-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		color: var(--bd-text-primary);
		margin-bottom: 0.35rem;
	}

	.bd-bar-track {
		height: 6px;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		overflow: hidden;
	}

	.bd-bar-fill {
		height: 100%;
		border-radius: 999px;
	}

	.bd-rubric-bar-item--highlight .bd-bar-labels span {
		color: var(--bd-tertiary);
		font-weight: 600;
	}

	/* ── MÓDULO PITCH & PREMIOS ── */
	.bd-pitch-details-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.bd-pitch-details-grid {
			grid-template-columns: 1fr;
		}
	}

	.bd-pitch-card {
		padding: 1.25rem;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.bd-pitch-card--alert {
		background: rgba(245, 158, 11, 0.08);
		border-color: rgba(245, 158, 11, 0.3);
	}

	.bd-pitch-card-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		color: var(--bd-text-primary);
	}

	.bd-awards-box {
		padding: 1.25rem;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.3);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.bd-awards-list {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin-bottom: 1rem;
	}

	.bd-award-item {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.85rem;
		color: var(--bd-text-primary);
	}

	.bd-awards-kit-pill {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		background: rgba(187, 243, 95, 0.08);
		border: 1px solid rgba(187, 243, 95, 0.25);
	}

	/* ── MÓDULO ÉTICA & IA ── */
	.bd-practices-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.bd-practice-item {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
	}

	.bd-practice-icon {
		font-size: 22px;
		margin-top: 2px;
	}

	/* ── MÓDULO SBOL ── */
	.bd-sbol-circuit-wrap {
		background: rgba(0, 0, 0, 0.35);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		padding: 1.5rem 1rem;
		margin-bottom: 1.5rem;
		overflow-x: auto;
	}

	.bd-sbol-circuit {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		min-width: 520px;
	}

	.bd-sbol-part {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0.85rem 1.15rem;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		cursor: help;
		transition: all 0.2s ease;
	}

	.bd-sbol-part:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
	}

	.bd-sbol-part--promoter {
		background: rgba(56, 189, 248, 0.12);
		border-color: rgba(56, 189, 248, 0.4);
		color: #38bdf8;
	}

	.bd-sbol-part--rbs {
		background: rgba(251, 191, 36, 0.12);
		border-color: rgba(251, 191, 36, 0.4);
		color: #fbbf24;
	}

	.bd-sbol-part--cds {
		background: rgba(121, 248, 208, 0.12);
		border-color: rgba(121, 248, 208, 0.4);
		color: var(--bd-primary);
	}

	.bd-sbol-part--terminator {
		background: rgba(239, 68, 68, 0.12);
		border-color: rgba(239, 68, 68, 0.4);
		color: #ef4444;
	}

	.bd-sbol-symbol {
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1;
	}

	.bd-sbol-name {
		font-size: 0.85rem;
		font-weight: 700;
		margin-top: 0.25rem;
	}

	.bd-sbol-role {
		font-size: 0.7rem;
		opacity: 0.8;
	}

	.bd-sbol-connector {
		height: 3px;
		width: 24px;
		background: rgba(255, 255, 255, 0.25);
		position: relative;
	}

	.bd-translation-assay-box {
		padding: 1.25rem;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.25);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.bd-translation-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.bd-translation-title {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--bd-text-primary);
	}

	.bd-assay-btn {
		font-size: 0.8rem;
		padding: 0.35rem 0.75rem;
		border: 1px solid rgba(121, 248, 208, 0.3);
		color: var(--bd-primary);
	}

	.bd-assay-seq-stream {
		font-family: var(--bd-font-mono, monospace);
		font-size: 0.8rem;
		margin: 0.75rem 0;
	}

	.bd-seq-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0;
	}

	.bd-seq-tag {
		color: var(--bd-on-surface-variant);
		width: 60px;
		flex-shrink: 0;
	}

	.bd-aa-chain {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		color: var(--bd-text-primary);
		transition: color 0.3s ease;
	}

	.bd-assay-active .bd-aa-chain {
		color: var(--bd-tertiary);
		text-shadow: 0 0 10px rgba(187, 243, 95, 0.6);
	}

	.bd-aa {
		padding: 0.1rem 0.3rem;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.06);
	}

	.bd-aa--met {
		background: rgba(121, 248, 208, 0.2);
		color: var(--bd-primary);
		font-weight: 700;
	}

	.bd-aa--stop {
		background: rgba(239, 68, 68, 0.2);
		color: #ef4444;
		font-weight: 700;
	}

	.bd-frame-note-box {
		margin-top: 0.85rem;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		background: rgba(187, 243, 95, 0.06);
		border-left: 3px solid var(--bd-tertiary);
	}

	/* ── MODALES GLOBALES Y LOCALES ── */
	.bd-modal-overlay {
		position: fixed !important;
		inset: 0 !important;
		width: 100vw !important;
		height: 100vh !important;
		background: rgba(0, 0, 0, 0.8) !important;
		backdrop-filter: blur(12px) !important;
		-webkit-backdrop-filter: blur(12px) !important;
		z-index: 99999 !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		padding: 1.5rem !important;
		opacity: 1 !important;
		transition: opacity 0.25s ease !important;
	}

	.bd-modal-overlay[hidden] {
		display: none !important;
		opacity: 0 !important;
		pointer-events: none !important;
	}

	.bd-modal {
		background: #161426 !important;
		border-radius: 1.5rem !important;
		border: 1px solid rgba(121, 248, 208, 0.3) !important;
		max-width: 780px !important;
		width: 100% !important;
		max-height: 90vh !important;
		overflow-y: auto !important;
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 35px rgba(121, 248, 208, 0.15) !important;
		display: flex !important;
		flex-direction: column !important;
		animation: modal-pop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) forwards !important;
	}

	@keyframes modal-pop {
		from { transform: scale(0.92); opacity: 0; }
		to { transform: scale(1); opacity: 1; }
	}

	.bd-modal-header {
		display: flex !important;
		align-items: flex-start !important;
		gap: 1rem !important;
		padding: 1.5rem 1.75rem 1.25rem !important;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
		position: relative !important;
	}

	.bd-modal-icon {
		font-size: 2rem !important;
		flex-shrink: 0 !important;
	}

	.bd-modal-close {
		margin-left: auto !important;
		background: rgba(255, 255, 255, 0.06) !important;
		border: 1px solid rgba(255, 255, 255, 0.12) !important;
		color: var(--bd-text-primary) !important;
		width: 36px !important;
		height: 36px !important;
		border-radius: 50% !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		cursor: pointer !important;
		transition: all 0.2s ease !important;
	}

	.bd-modal-close:hover {
		background: rgba(239, 68, 68, 0.2) !important;
		border-color: rgba(239, 68, 68, 0.4) !important;
		color: #ef4444 !important;
	}

	.bd-modal-body {
		padding: 1.5rem 1.75rem !important;
		overflow-y: auto !important;
		flex: 1 !important;
	}

	.bd-modal-footer {
		padding: 1.25rem 1.75rem !important;
		border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
		display: flex !important;
		gap: 0.75rem !important;
		align-items: center !important;
	}

	.bd-template-modal {
		max-width: 820px !important;
		width: 95% !important;
	}

	.bd-template-code-box {
		max-height: 400px;
		overflow-y: auto;
		background: rgba(0, 0, 0, 0.45);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		padding: 1.25rem;
		font-family: var(--bd-font-mono, monospace);
		font-size: 0.8rem;
		line-height: 1.5;
		color: #e2e8f0;
	}

	/* ── MODAL 2: BIO-TERMINAL FLUORESCENTE (PANTALLA COMPLETA) ── */
	.bd-terminal-overlay {
		padding: 0 !important;
		background: rgba(7, 6, 15, 0.98) !important;
		backdrop-filter: blur(25px) !important;
		-webkit-backdrop-filter: blur(25px) !important;
	}

	.bd-terminal-window {
		--bd-text-primary: #f8fafc;
		--bd-on-surface: #f1f5f9;
		--bd-on-surface-variant: #94a3b8;
		color: #f8fafc;
		width: 100vw;
		height: 100vh;
		display: flex;
		flex-direction: column;
		background: radial-gradient(circle at 30% 20%, rgba(121, 248, 208, 0.05) 0%, rgba(11, 10, 20, 0.98) 70%);
		overflow: hidden;
	}

	.bd-terminal-window strong,
	.bd-terminal-window h2,
	.bd-terminal-window h3,
	.bd-terminal-window h4 {
		color: #f8fafc !important;
	}

	.bd-terminal-window p {
		color: #cbd5e1;
	}

	.bd-terminal-window .bd-caption {
		color: #94a3b8 !important;
	}

	.bd-terminal-window .bd-body-md {
		color: #cbd5e1 !important;
	}

	.bd-terminal-window .bd-slide-lead {
		color: #cbd5e1 !important;
	}

	.bd-terminal-bar {
		height: 56px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(19, 17, 32, 0.85);
		backdrop-filter: blur(10px);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1.5rem;
		flex-shrink: 0;
	}

	.bd-terminal-bar-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.bd-terminal-status-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--bd-primary);
		box-shadow: 0 0 10px var(--bd-primary);
		animation: live-pulse 1.8s infinite ease-in-out;
	}

	.bd-terminal-sys-tag {
		font-family: var(--bd-font-mono, monospace);
		font-size: 0.8rem;
		color: var(--bd-text-primary);
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	.bd-terminal-station-badge {
		padding: 0.2rem 0.65rem;
		border-radius: 6px;
		background: rgba(187, 243, 95, 0.15);
		border: 1px solid rgba(187, 243, 95, 0.35);
		color: var(--bd-tertiary);
		font-family: var(--bd-font-mono, monospace);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.bd-terminal-bar-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.bd-terminal-icon-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.65rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--bd-text-primary);
		cursor: pointer;
		font-size: 0.8rem;
		transition: all 0.2s ease;
	}

	.bd-terminal-icon-btn:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(121, 248, 208, 0.4);
	}

	.bd-terminal-body {
		flex: 1;
		display: grid;
		grid-template-columns: 440px 1fr;
		overflow: hidden;
	}

	@media (max-width: 990px) {
		.bd-terminal-body {
			grid-template-columns: 1fr;
			overflow-y: auto;
		}
	}

	/* Columna de la Placa Petri */
	.bd-petri-col {
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(0, 0, 0, 0.2);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		position: relative;
	}

	.bd-petri-dish {
		width: 320px;
		height: 320px;
		position: relative;
		border-radius: 50%;
		background: rgba(121, 248, 208, 0.03);
		border: 2px solid rgba(121, 248, 208, 0.25);
		box-shadow: 0 0 50px rgba(0, 0, 0, 0.6), inset 0 0 40px rgba(121, 248, 208, 0.08);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bd-petri-rim {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.1);
		pointer-events: none;
	}

	.bd-petri-agar {
		width: 90%;
		height: 90%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(19, 17, 32, 0.8) 0%, rgba(9, 8, 16, 0.95) 100%);
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bd-petri-grid {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
		background-size: 20px 20px;
		opacity: 0.3;
		pointer-events: none;
	}

	/* Colonias Bacterianas en Placa (7 Posiciones Geométricas Equidistantes) */
	.bd-colony {
		position: absolute;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(15, 23, 42, 0.92);
		border: 2px solid rgba(255, 255, 255, 0.2);
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 5;
		padding: 0;
	}

	.bd-colony-pulse {
		position: absolute;
		inset: -6px;
		border-radius: 50%;
		border: 2px solid currentColor;
		opacity: 0;
		pointer-events: none;
	}

	.bd-colony--active .bd-colony-pulse {
		animation: colony-pulse 1.8s infinite ease-out;
		opacity: 0.8;
	}

	.bd-colony-core {
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 1;
	}

	.bd-colony-id {
		font-family: var(--bd-font-mono, monospace);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.bd-colony-fluor {
		font-size: 0.52rem;
		font-weight: 800;
		opacity: 0.85;
	}

	.bd-colony-label {
		position: absolute;
		bottom: -20px;
		font-size: 0.65rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--bd-on-surface-variant);
		pointer-events: none;
	}

	/* Posiciones 7-puntos en circunferencia (Radio ~95px, Centro 144, 144 en agar 288px) */
	/* 1. Misión (Top-Center) */
	.bd-colony--7-1 {
		top: 15px;
		left: 118px;
		color: #38bdf8;
		border-color: rgba(56, 189, 248, 0.5);
	}
	/* 2. Sprint (Top-Right) */
	.bd-colony--7-2 {
		top: 50px;
		right: 30px;
		color: #bbf35f;
		border-color: rgba(187, 243, 95, 0.5);
	}
	/* 3. Entregables (Right-Bottom) */
	.bd-colony--7-3 {
		bottom: 80px;
		right: 15px;
		color: #c8bfff;
		border-color: rgba(200, 191, 255, 0.5);
	}
	/* 4. Rúbrica (Bottom-Right) */
	.bd-colony--7-4 {
		bottom: 15px;
		right: 70px;
		color: #fbbf24;
		border-color: rgba(251, 191, 36, 0.5);
	}
	/* 5. Pitch & Premios (Bottom-Left) */
	.bd-colony--7-5 {
		bottom: 15px;
		left: 70px;
		color: #f43f5e;
		border-color: rgba(244, 63, 94, 0.5);
	}
	/* 6. Ética & IA (Left-Bottom) */
	.bd-colony--7-6 {
		bottom: 80px;
		left: 15px;
		color: #ff6b8b;
		border-color: rgba(255, 107, 139, 0.5);
	}
	/* 7. SBOL (Top-Left) */
	.bd-colony--7-7 {
		top: 50px;
		left: 30px;
		color: #79f8d0;
		border-color: rgba(121, 248, 208, 0.5);
	}

	.bd-colony:hover {
		transform: scale(1.15);
		box-shadow: 0 0 25px currentColor;
	}

	.bd-colony--active {
		transform: scale(1.24);
		box-shadow: 0 0 30px currentColor;
		border-color: #ffffff;
		z-index: 10;
	}

	.bd-colony--visited .bd-colony-label {
		color: var(--bd-text-primary);
	}

	.bd-petri-hint {
		margin-top: 1.5rem;
		font-size: 0.75rem;
		color: var(--bd-on-surface-variant);
		text-align: center;
	}

	/* Columna de la Diapositiva */
	.bd-terminal-slide-col {
		padding: 3rem 4rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	@media (max-width: 990px) {
		.bd-terminal-slide-col {
			padding: 2rem;
		}
	}

	.bd-slide-container {
		max-width: 820px;
		width: 100%;
		margin: 0 auto;
	}

	.bd-terminal-slide {
		animation: slide-in 0.35s ease forwards;
	}

	@keyframes slide-in {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.bd-slide-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		font-family: var(--bd-font-mono, monospace);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
	}

	.bd-slide-chip--cyan {
		background: rgba(56, 189, 248, 0.15);
		border: 1px solid rgba(56, 189, 248, 0.4);
		color: #38bdf8;
	}

	.bd-slide-chip--green {
		background: rgba(121, 248, 208, 0.15);
		border: 1px solid rgba(121, 248, 208, 0.4);
		color: var(--bd-primary);
	}

	.bd-slide-chip--lime {
		background: rgba(187, 243, 95, 0.15);
		border: 1px solid rgba(187, 243, 95, 0.4);
		color: var(--bd-tertiary);
