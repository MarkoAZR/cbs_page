---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// URLs de documentos oficiales en public/Biodesign/docs/
const DOC_BASES = `${base}/Biodesign/docs/Bases_y_Rubrica_BioDesign_2026.pdf`;
const DOC_FICHAS = `${base}/Biodesign/docs/Fichas_Tecnicas_BioDesign_2026.pdf`;
const DOC_HANDBOOK = `${base}/Biodesign/docs/Handbook_BioDesign_2026.pdf`;
const DOC_FICHA1_WORD = `${base}/Biodesign/docs/Biodesign_ficha_informe.docx`;
---

<!-- ═══════════════════════════════════════════
     SECCIÓN OFICIAL: HACKATHON BIODESIGN 2026
     ═══════════════════════════════════════════ -->
<section class="bd-section bd-hackathon-section" id="hackathon">
	<!-- Encabezado de la sección -->
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-lime" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">rocket_launch</span>
			{t('biodesign.hackathon.badge')}
		</span>
		<h2 class="bd-headline-lg">
			{t('biodesign.hackathon.title1')} <span class="bd-gradient-text">{t('biodesign.hackathon.title2')}</span>
		</h2>
		<p class="bd-body-md" style="max-width:760px; margin:0 auto;">
			{t('biodesign.hackathon.subtitle')}
		</p>
	</div>

	<!-- Banner Hero Interactivo: Lanzador del Bio-Terminal Fluorescente -->
	<div class="bd-terminal-launcher-card bd-glass bd-reveal">
		<div class="bd-launcher-glow" aria-hidden="true"></div>
		<div class="bd-launcher-content">
			<div class="bd-launcher-info">
				<div class="bd-launcher-chip">
					<span class="bd-colony-dot bd-colony-dot--live"></span>
					<span>{lang === 'es' ? 'MODO PRESENTACIÓN KICK-OFF • 7 ESTACIONES VIVAS' : 'KICK-OFF PRESENTATION MODE • 7 LIVE STATIONS'}</span>
				</div>
				<h3 class="bd-headline-md" style="margin:0.5rem 0 0.35rem; color:var(--bd-text-primary);">
					{t('biodesign.hackathon.launch_portal')}
				</h3>
				<p class="bd-body-sm" style="color:var(--bd-on-surface-variant); margin:0; max-width:620px;">
					{t('biodesign.hackathon.launch_portal_desc')}
				</p>
			</div>
			<div class="bd-launcher-action">
				<button type="button" class="bd-btn-primary bd-launcher-btn" id="btn-open-bio-terminal">
					<span class="material-icons">biotech</span>
					{t('biodesign.hackathon.launch_portal')}
					<span class="bd-btn-shortcut">Space / Click</span>
				</button>
			</div>
		</div>
	</div>

	<!-- Barra de Controles de los Acordeones Desplegables -->
	<div class="bd-accordion-top-bar bd-reveal">
		<div class="bd-accordion-meta">
			<span class="material-icons" style="font-size:16px; color:var(--bd-primary);">dashboard_customize</span>
			<span class="bd-accordion-count">{lang === 'es' ? '7 Módulos de Información Oficial' : '7 Official Information Modules'}</span>
		</div>
		<div class="bd-accordion-actions">
			<button type="button" class="bd-btn-ghost bd-accordion-ctrl-btn" id="btn-accordion-expand-all">
				<span class="material-icons" style="font-size:15px;">unfold_more</span>
				{t('biodesign.hackathon.accordion.expand_all')}
			</button>
			<button type="button" class="bd-btn-ghost bd-accordion-ctrl-btn" id="btn-accordion-collapse-all">
				<span class="material-icons" style="font-size:15px;">unfold_less</span>
				{t('biodesign.hackathon.accordion.collapse_all')}
			</button>
		</div>
	</div>

	<!-- Lista de Módulos Desplegables Cósmicos (7 Módulos Ordenados) -->
	<div class="bd-hack-accordion-list bd-reveal" id="hackathon-accordion-list">

		<!-- MÓDULO 1: Misión del Evento & CNEB -->
		<article class="bd-hack-accordion bd-glass is-open" data-module="1">
			<button type="button" class="bd-accordion-trigger" aria-expanded="true" aria-controls="mod-content-1" id="mod-trigger-1">
				<div class="bd-acc-header-left">
					<span class="bd-acc-num">01</span>
					<div class="bd-acc-icon-wrap bd-acc-icon-wrap--teal">
						<span class="material-icons">flag</span>
					</div>
					<div class="bd-acc-titles">
						<div class="bd-acc-badge-row">
							<span class="bd-chip bd-chip-teal">{t('biodesign.hackathon.mision.badge')}</span>
						</div>
						<h3 class="bd-headline-sm bd-acc-title">{t('biodesign.hackathon.mision.title')}</h3>
						<p class="bd-caption bd-acc-summary">Competencia 22 CNEB • Democratización de la Biología Sintética Escolar</p>
					</div>
				</div>
				<div class="bd-acc-header-right">
					<span class="material-icons bd-acc-chevron">expand_more</span>
				</div>
			</button>
			<div class="bd-accordion-content" id="mod-content-1" role="region" aria-labelledby="mod-trigger-1">
				<div class="bd-accordion-inner">
					<div class="bd-cneb-callout">
						<div class="bd-cneb-badge">
							<span class="material-icons" style="font-size:16px;">school</span>
							<strong>{t('biodesign.hackathon.mision.cneb_title')}</strong>
						</div>
						<p class="bd-body-sm">{t('biodesign.hackathon.mision.cneb_desc')}</p>
					</div>
					<div class="bd-hack-feature-item" style="margin-top:1.25rem;">
						<span class="material-icons" style="color:var(--bd-primary);">public</span>
						<div>
							<strong>{t('biodesign.hackathon.mision.focus_title')}</strong>
							<p class="bd-caption" style="margin:0.25rem 0 0;">{t('biodesign.hackathon.mision.focus_desc')}</p>
						</div>
					</div>
				</div>
			</div>
		</article>

		<!-- MÓDULO 2: Sprint de 48 Horas & Dinámica de Mentores -->
		<article class="bd-hack-accordion bd-glass" data-module="2">
			<button type="button" class="bd-accordion-trigger" aria-expanded="false" aria-controls="mod-content-2" id="mod-trigger-2">
				<div class="bd-acc-header-left">
					<span class="bd-acc-num">02</span>
					<div class="bd-acc-icon-wrap bd-acc-icon-wrap--lime">
						<span class="material-icons">timer</span>
					</div>
					<div class="bd-acc-titles">
						<div class="bd-acc-badge-row">
							<span class="bd-chip bd-chip-lime">{t('biodesign.hackathon.sprint.badge')}</span>
						</div>
						<h3 class="bd-headline-sm bd-acc-title">{t('biodesign.hackathon.sprint.title')}</h3>
						<p class="bd-caption bd-acc-summary">Viernes 9 a Domingo 11 Oct • Turnos Mañana (10-12m) y Tarde (2-5pm)</p>
					</div>
				</div>
				<div class="bd-acc-header-right">
					<span class="material-icons bd-acc-chevron">expand_more</span>
				</div>
			</button>
			<div class="bd-accordion-content" id="mod-content-2" role="region" aria-labelledby="mod-trigger-2">
				<div class="bd-accordion-inner">
					<div class="bd-sprint-time-chip">
						<span class="material-icons" style="font-size:16px; color:var(--bd-tertiary);">schedule</span>
						<span>{t('biodesign.hackathon.sprint.timeline')}</span>
					</div>

					<div class="bd-mentor-rules-list">
						<div class="bd-mentor-rule-item">
							<span class="material-icons bd-rule-icon" style="color:var(--bd-secondary);">record_voice_over</span>
							<div>
								<strong>{t('biodesign.hackathon.sprint.kickoff_mentor_title')}</strong>
								<p class="bd-caption">{t('biodesign.hackathon.sprint.kickoff_mentor_desc')}</p>
							</div>
						</div>

						<div class="bd-mentor-rule-item">
							<span class="material-icons bd-rule-icon" style="color:#5865f2;">chat</span>
							<div>
								<strong>{t('biodesign.hackathon.sprint.contact_title')}</strong>
								<p class="bd-caption">{t('biodesign.hackathon.sprint.contact_desc')}</p>
							</div>
						</div>

						<!-- Turnos de Sábado y Domingo -->
						<div class="bd-shifts-box">
							<strong class="bd-shifts-title">
								<span class="material-icons" style="font-size:14px; vertical-align:middle; color:var(--bd-secondary);">event_available</span>
								{t('biodesign.hackathon.sprint.shifts_title')}
							</strong>
							<div class="bd-shift-pills">
								<div class="bd-shift-pill">
									<span class="material-icons" style="font-size:14px; color:var(--bd-tertiary);">wb_sunny</span>
									<span>{t('biodesign.hackathon.sprint.shift_morning')}</span>
								</div>
								<div class="bd-shift-pill">
									<span class="material-icons" style="font-size:14px; color:var(--bd-primary);">wb_twilight</span>
									<span>{t('biodesign.hackathon.sprint.shift_afternoon')}</span>
								</div>
							</div>
							<p class="bd-caption" style="margin:0.5rem 0 0; color:var(--bd-on-surface-variant);">
								{t('biodesign.hackathon.sprint.shifts_note')}
							</p>
						</div>
					</div>
				</div>
			</div>
		</article>

		<!-- MÓDULO 3: Kit de Entregables & Descarga de Ficha 1 (.docx) -->
		<article class="bd-hack-accordion bd-glass" data-module="3">
			<button type="button" class="bd-accordion-trigger" aria-expanded="false" aria-controls="mod-content-3" id="mod-trigger-3">
				<div class="bd-acc-header-left">
					<span class="bd-acc-num">03</span>
					<div class="bd-acc-icon-wrap bd-acc-icon-wrap--purple">
						<span class="material-icons">inventory_2</span>
					</div>
					<div class="bd-acc-titles">
						<div class="bd-acc-badge-row">
							<span class="bd-chip bd-chip-purple">{t('biodesign.hackathon.kit.badge')}</span>
						</div>
						<h3 class="bd-headline-sm bd-acc-title">{t('biodesign.hackathon.kit.title')}</h3>
						<p class="bd-caption bd-acc-summary">Ficha 1 (Informe), Enlace Benchling y Pitch Deck 3 min • Cierre Domingo 11 Oct 11:59 p.m.</p>
					</div>
				</div>
				<div class="bd-acc-header-right">
					<span class="material-icons bd-acc-chevron">expand_more</span>
				</div>
			</button>
			<div class="bd-accordion-content" id="mod-content-3" role="region" aria-labelledby="mod-trigger-3">
				<div class="bd-accordion-inner">
					<div class="bd-deadline-notice">
						<span class="material-icons" style="font-size:16px; color:#ef4444;">alarm</span>
						<strong>{t('biodesign.hackathon.kit.deadline')}</strong>
					</div>

					<!-- Destacado: Descarga de Ficha 1 en Word .docx -->
					<div class="bd-doc-download-hero">
						<div class="bd-doc-hero-info">
							<span class="material-icons bd-doc-hero-icon">description</span>
							<div>
								<span class="bd-chip bd-chip-lime" style="font-size:0.65rem;">PLANTILLA OFICIAL DE INFORME</span>
								<h4 class="bd-label-lg" style="margin:0.25rem 0 0.2rem; color:var(--bd-text-primary);">
									{t('biodesign.hackathon.kit.btn_ficha1_word')}
								</h4>
								<p class="bd-caption" style="margin:0; color:var(--bd-on-surface-variant);">
									{t('biodesign.hackathon.kit.ficha1_word_desc')}
								</p>
							</div>
						</div>
						<a href={DOC_FICHA1_WORD} download="Biodesign_ficha_informe.docx" class="bd-btn-primary bd-btn-word-download">
							<span class="material-icons">download</span>
							{lang === 'es' ? 'Descargar Word (.docx)' : 'Download Word (.docx)'}
						</a>
					</div>

					<div class="bd-kit-grid" style="margin-top:1.5rem;">
						<!-- Entregable 1: Ficha Resumen -->
						<div class="bd-kit-item bd-kit-item--doc">
							<div class="bd-kit-item-head">
								<span class="material-icons bd-kit-icon">description</span>
								<div>
									<strong class="bd-kit-name">{t('biodesign.hackathon.kit.doc1_title')}</strong>
									<span class="bd-caption" style="color:var(--bd-on-surface-variant); display:block;">7 componentes obligatorios</span>
								</div>
							</div>
							<ul class="bd-kit-check-list">
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c1')}</li>
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c2')}</li>
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c3')}</li>
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c4')}</li>
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c5')}</li>
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c6')}</li>
								<li><span class="material-icons">check_circle</span> {t('biodesign.hackathon.kit.doc1_c7')}</li>
							</ul>
						</div>

						<!-- Entregable 2 & 3: Benchling + Pitch Deck -->
						<div class="bd-kit-col-sub">
							<div class="bd-kit-item">
								<div class="bd-kit-item-head">
									<span class="material-icons bd-kit-icon" style="color:var(--bd-primary);">link</span>
									<div>
										<strong class="bd-kit-name">{t('biodesign.hackathon.kit.doc2_title')}</strong>
									</div>
								</div>
								<p class="bd-caption" style="margin:0.25rem 0 0;">{t('biodesign.hackathon.kit.doc2_desc')}</p>
							</div>

							<div class="bd-kit-item" style="margin-top:0.75rem;">
								<div class="bd-kit-item-head">
									<span class="material-icons bd-kit-icon" style="color:var(--bd-tertiary);">slideshow</span>
									<div>
										<strong class="bd-kit-name">{t('biodesign.hackathon.kit.doc3_title')}</strong>
									</div>
								</div>
								<p class="bd-caption" style="margin:0.25rem 0 0;">{t('biodesign.hackathon.kit.doc3_desc')}</p>
							</div>
						</div>
					</div>

					<!-- Zona de Descargas Oficiales -->
					<div class="bd-kit-downloads-section">
						<h4 class="bd-label-md" style="color:var(--bd-text-primary); margin:0 0 0.75rem;">
							<span class="material-icons" style="font-size:16px; vertical-align:middle; color:var(--bd-tertiary);">cloud_download</span>
							{t('biodesign.hackathon.kit.downloads_title')}
						</h4>
						<div class="bd-download-buttons-row">
							<a href={DOC_BASES} target="_blank" rel="noopener noreferrer" class="bd-btn-secondary bd-dl-btn">
								<span class="material-icons">gavel</span>
								{t('biodesign.hackathon.kit.btn_bases')}
							</a>
							<a href={DOC_FICHAS} target="_blank" rel="noopener noreferrer" class="bd-btn-secondary bd-dl-btn">
								<span class="material-icons">menu_book</span>
								{t('biodesign.hackathon.kit.btn_fichas')}
							</a>
							<a href={DOC_HANDBOOK} target="_blank" rel="noopener noreferrer" class="bd-btn-secondary bd-dl-btn">
								<span class="material-icons">auto_stories</span>
								{t('biodesign.hackathon.kit.btn_handbook')}
							</a>
							<button type="button" class="bd-btn-primary bd-dl-btn bd-dl-btn--lime" id="btn-open-template-modal">
								<span class="material-icons">content_paste</span>
								{t('biodesign.hackathon.kit.btn_template')}
							</button>
						</div>
					</div>
				</div>
			</div>
		</article>

		<!-- MÓDULO 4: Rúbrica Oficial de Evaluación -->
		<article class="bd-hack-accordion bd-glass" data-module="4">
			<button type="button" class="bd-accordion-trigger" aria-expanded="false" aria-controls="mod-content-4" id="mod-trigger-4">
				<div class="bd-acc-header-left">
					<span class="bd-acc-num">04</span>
					<div class="bd-acc-icon-wrap bd-acc-icon-wrap--amber">
						<span class="material-icons">fact_check</span>
					</div>
					<div class="bd-acc-titles">
						<div class="bd-acc-badge-row">
							<span class="bd-chip bd-chip-teal">{t('biodesign.hackathon.rubrica.badge')}</span>
						</div>
						<h3 class="bd-headline-sm bd-acc-title">{t('biodesign.hackathon.rubrica.title')}</h3>
						<p class="bd-caption bd-acc-summary">5 Criterios Ponderados (100%) • Desempate 1: Coherencia Biológica (25%)</p>
					</div>
				</div>
				<div class="bd-acc-header-right">
					<span class="material-icons bd-acc-chevron">expand_more</span>
				</div>
			</button>
			<div class="bd-accordion-content" id="mod-content-4" role="region" aria-labelledby="mod-trigger-4">
				<div class="bd-accordion-inner">
					<p class="bd-caption" style="margin-bottom:1rem; color:var(--bd-on-surface-variant);">
						{t('biodesign.hackathon.rubrica.desc')}
					</p>

					<div class="bd-rubric-bars">
						<div class="bd-rubric-bar-item">
							<div class="bd-bar-labels">
								<span>C1: Problema & Chasis BSL-1</span>
								<strong>20%</strong>
							</div>
							<div class="bd-bar-track"><div class="bd-bar-fill" style="width:20%; background:var(--bd-primary);"></div></div>
						</div>

						<div class="bd-rubric-bar-item">
							<div class="bd-bar-labels">
								<span>C2: Circuito & SBOL</span>
								<strong>20%</strong>
							</div>
							<div class="bd-bar-track"><div class="bd-bar-fill" style="width:20%; background:var(--bd-primary);"></div></div>
						</div>

						<div class="bd-rubric-bar-item bd-rubric-bar-item--highlight">
							<div class="bd-bar-labels">
								<span>C3: Coherencia Biológica (1er Desempate)</span>
								<strong>25%</strong>
							</div>
							<div class="bd-bar-track"><div class="bd-bar-fill" style="width:25%; background:var(--bd-tertiary);"></div></div>
						</div>

						<div class="bd-rubric-bar-item">
							<div class="bd-bar-labels">
								<span>C4: Impacto Social & Bioseguridad</span>
								<strong>15%</strong>
							</div>
							<div class="bd-bar-track"><div class="bd-bar-fill" style="width:15%; background:var(--bd-secondary);"></div></div>
						</div>

						<div class="bd-rubric-bar-item bd-rubric-bar-item--highlight">
							<div class="bd-bar-labels">
								<span>C5: Pitch, Video 3 min & Calidad (3er Desempate)</span>
								<strong>20%</strong>
							</div>
							<div class="bd-bar-track"><div class="bd-bar-fill" style="width:20%; background:var(--bd-secondary);"></div></div>
						</div>
					</div>
				</div>
			</div>
		</article>

		<!-- MÓDULO 5: Pitch, Gran Final & Premiación (NUEVA SECCIÓN) -->
		<article class="bd-hack-accordion bd-glass" data-module="5">
			<button type="button" class="bd-accordion-trigger" aria-expanded="false" aria-controls="mod-content-5" id="mod-trigger-5">
				<div class="bd-acc-header-left">
					<span class="bd-acc-num">05</span>
					<div class="bd-acc-icon-wrap bd-acc-icon-wrap--pink">
						<span class="material-icons">military_tech</span>
					</div>
					<div class="bd-acc-titles">
						<div class="bd-acc-badge-row">
							<span class="bd-chip bd-chip-lime">{t('biodesign.hackathon.pitch.badge')}</span>
						</div>
						<h3 class="bd-headline-sm bd-acc-title">{t('biodesign.hackathon.pitch.title')}</h3>
						<p class="bd-caption bd-acc-summary">Top 15 Clasificados • Viernes 30 Oct en UNMSM (Acompañados de tutor) • Diplomas, Medallas & Premios Sorpresa</p>
					</div>
				</div>
				<div class="bd-acc-header-right">
					<span class="material-icons bd-acc-chevron">expand_more</span>
				</div>
			</button>
			<div class="bd-accordion-content" id="mod-content-5" role="region" aria-labelledby="mod-trigger-5">
				<div class="bd-accordion-inner">
					<p class="bd-body-sm" style="color:var(--bd-on-surface-variant); margin-bottom:1.25rem;">
						{t('biodesign.hackathon.pitch.desc')}
					</p>

					<div class="bd-pitch-details-grid">
						<!-- Clasificados Top 15 -->
						<div class="bd-pitch-card">
							<div class="bd-pitch-card-head">
								<span class="material-icons" style="color:var(--bd-tertiary);">stars</span>
								<strong>{t('biodesign.hackathon.pitch.top15_title')}</strong>
							</div>
							<p class="bd-caption">{t('biodesign.hackathon.pitch.top15_desc')}</p>
						</div>

						<!-- Lineamientos de Asistencia a UNMSM -->
						<div class="bd-pitch-card bd-pitch-card--alert">
							<div class="bd-pitch-card-head">
								<span class="material-icons" style="color:#f59e0b;">escalator_warning</span>
