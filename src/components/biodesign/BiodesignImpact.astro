								deptPaths
									.filter((dp) => dp.region)
									.map((dp) => {
										const r = dp.region!;
										return (
											<path
												id={dp.svgId}
												d={dp.d}
												data-region-path={r.id}
												class={`bd-dept-path bd-dept-participating ${r.id === "lima" ? "is-active" : ""} ${r.highlight ? "is-highlight" : ""}`}
											>
												<title>{`${r.name}: ${r.schools}`}</title>
											</path>
										);
									})
							}
						</g>

						<!-- Capa 3: Arcos curvos de conexión bio-red hacia Lima (Sede Gran Final) -->
