---
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import peruRawSvg from "../../assets/biodesign/peru.svg?raw";

interface Props {
	lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const isEs = lang === "es";

// ── KPIs de Impacto Oficiales Auditados (Secuencia: Regiones → Inscritos → Equipos → Participantes → Proyectos → Finalistas) ──
const funnelMetrics = [
	{
		value: "9",
		label: t("biodesign.impact.funnel.m6.label"),
		sub: t("biodesign.impact.funnel.m6.sub"),
		icon: "public",
		color: "purple",
		rgb: "var(--bd-secondary-rgb)",
		accent: "var(--bd-secondary)",
	},
	{
		value: "+150",
		label: t("biodesign.impact.funnel.m1.label"),
		sub: t("biodesign.impact.funnel.m1.sub"),
		icon: "groups",
		color: "teal",
		rgb: "var(--bd-primary-rgb)",
		accent: "var(--bd-primary)",
	},
	{
		value: "27",
		label: t("biodesign.impact.funnel.m2.label"),
		sub: t("biodesign.impact.funnel.m2.sub"),
		icon: "hub",
		color: "lime",
		rgb: "var(--bd-tertiary-rgb)",
		accent: "var(--bd-tertiary)",
	},
	{
		value: "65",
		label: t("biodesign.impact.funnel.m3.label"),
		sub: t("biodesign.impact.funnel.m3.sub"),
		icon: "school",
		color: "purple",
		rgb: "var(--bd-secondary-rgb)",
		accent: "var(--bd-secondary)",
	},
	{
		value: "17",
		label: t("biodesign.impact.funnel.m4.label"),
		sub: t("biodesign.impact.funnel.m4.sub"),
		icon: "biotech",
		color: "teal",
		rgb: "var(--bd-primary-rgb)",
		accent: "var(--bd-primary)",
	},
	{
		value: "10",
		label: t("biodesign.impact.funnel.m5.label"),
		sub: t("biodesign.impact.funnel.m5.sub"),
		icon: "emoji_events",
		color: "lime",
		rgb: "var(--bd-tertiary-rgb)",
		accent: "var(--bd-tertiary)",
	},
];

// ── Distribución por Ejes Temáticos (27 equipos) ───────────────
const trackStats = [
	{
		id: "track1",
		num: "01",
		title: t("biodesign.tracks.track1.title"),
		teams: 12,
		pct: 44.4,
		icon: "water_drop",
		color: "var(--bd-primary)",
		rgb: "var(--bd-primary-rgb)",
		chipClass: "bd-chip-teal",
	},
	{
		id: "track2",
		num: "02",
		title: t("biodesign.tracks.track2.title"),
		teams: 10,
		pct: 37.0,
		icon: "health_and_safety",
		color: "var(--bd-secondary)",
		rgb: "var(--bd-secondary-rgb)",
		chipClass: "bd-chip-purple",
	},
	{
		id: "track3",
		num: "03",
		title: t("biodesign.tracks.track3.title"),
		teams: 5,
		pct: 18.5,
		icon: "compost",
		color: "var(--bd-tertiary)",
		rgb: "var(--bd-tertiary-rgb)",
		chipClass: "bd-chip-lime",
	},
];

// ── 9 Regiones del Perú sobre el Mapa Departamental Oficial (viewBox 543x792) ──
interface RegionNode {
	id: string;
	name: string;
	svgIds: string[];
	cx: number;
	cy: number;
	lx: number;
	ly: number;
	anchor: "start" | "end";
	arc?: string;
	schools: string;
	zone: string;
	highlight?: boolean;
}

const regions: RegionNode[] = [
	{
		id: "piura",
		name: "Piura",
		svgIds: ["PE-PIU"],
		cx: 43,
		cy: 217,
		lx: 8,
		ly: 210,
		anchor: "end",
		arc: "M 43,217 Q 95,375 196,504",
		zone: isEs
			? "Costa Norte (Piura, Sullana & Talara)"
			: "Northern Coast (Piura, Sullana & Talara)",
		schools: "I.E. Almirante Miguel Grau, I.E. Santa Teresita (Sullana)",
	},
	{
		id: "lalibertad",
		name: "La Libertad",
		svgIds: ["PE-LAL"],
		cx: 129,
		cy: 335,
		lx: 78,
		ly: 342,
		anchor: "end",
		arc: "M 129,335 Q 145,425 196,504",
		zone: isEs ? "Costa Norte (Chepén)" : "Northern Coast (Chepén)",
		schools: "I.E. 80382 Carlos Gutiérrez Noriega",
	},
	{
		id: "ancash",
		name: "Áncash",
		svgIds: ["PE-ANC"],
		cx: 159,
		cy: 399,
		lx: 112,
		ly: 406,
		anchor: "end",
		arc: "M 159,399 Q 168,455 196,504",
		zone: isEs ? "Sierra Norte (Huaraz)" : "Northern Highlands (Huaraz)",
		schools: "COAR Áncash",
	},
	{
		id: "lima",
		name: "Lima y Callao",
		svgIds: ["PE-LIM", "PE-LMA", "PE-CAL"],
		cx: 196,
		cy: 504,
		lx: 144,
		ly: 509,
		anchor: "end",
		zone: isEs
			? "Lima Metropolitana, Callao y Huarochirí"
			: "Metropolitan Lima, Callao & Huarochirí",
		schools:
			"COAR Lima Metropolitana, Colegio Claretiano, I.E. Alfonso Ugarte, Colegio María Auxiliadora, Trilce Santa Beatriz, I.E. Micaela Bastidas, Saco Oliveros, I.E. 7035 Leoncio Prado, entre otros",
		highlight: true,
	},
	{
		id: "junin",
		name: "Junín",
		svgIds: ["PE-JUN"],
		cx: 277,
		cy: 490,
		lx: 325,
		ly: 486,
		anchor: "start",
		arc: "M 277,490 Q 238,488 196,504",
		zone: isEs
			? "Sierra Central (Huancayo)"
			: "Central Highlands (Huancayo)",
		schools: "I.E. Politécnico Regional del Centro",
	},
	{
		id: "huancavelica",
		name: "Huancavelica",
		svgIds: ["PE-HUV"],
		cx: 271,
		cy: 554,
		lx: 212,
		ly: 572,
		anchor: "end",
		arc: "M 271,554 Q 230,538 196,504",
		zone: isEs ? "Sierra Sur-Central" : "South-Central Highlands",
		schools: "I.E. Nuestra Señora de Lourdes",
	},
	{
		id: "ayacucho",
		name: "Ayacucho",
		svgIds: ["PE-AYA"],
		cx: 310,
		cy: 601,
		lx: 356,
		ly: 626,
		anchor: "start",
		arc: "M 310,601 Q 246,565 196,504",
		zone: isEs ? "Sierra Sur (Huamanga)" : "Southern Highlands (Huamanga)",
		schools: isEs
			? "Delegaciones escolares de Huamanga"
			: "Huamanga School Delegations",
	},
	{
		id: "cusco",
		name: "Cusco",
		svgIds: ["PE-CUS"],
		cx: 393,
		cy: 563,
		lx: 438,
		ly: 558,
		anchor: "start",
		arc: "M 393,563 Q 295,515 196,504",
		zone: isEs ? "Sur Andino (Cusco)" : "Andean South (Cusco)",
		schools:
			"COAR Cusco, I.E. Daniel Estrada Pérez, I.E. Santa María de los Andes, I.E. 51014 Romeritos, Colegio Didascalio Nuestra Señora del Rosario",
	},
	{
		id: "tacna",
		name: "Tacna",
		svgIds: ["PE-TAC"],
		cx: 475,
		cy: 760,
		lx: 430,
		ly: 774,
		anchor: "end",
		arc: "M 475,760 Q 305,675 196,504",
		zone: isEs ? "Frontera Sur (Tacna)" : "Southern Border (Tacna)",
		schools:
			"COAR Tacna, I.E. San José de Nazaret, I.E. Corazón de María, I.E. Jorge Basadre Grohman, I.E. Santísima Niña María",
		highlight: true,
	},
];

// Mapa inverso de código ISO (PE-XXX) → RegionNode
const svgIdToRegion = new Map<string, RegionNode>();
for (const r of regions) {
	for (const code of r.svgIds) {
		svgIdToRegion.set(code, r);
	}
}

interface DeptPath {
	svgId: string;
	title: string;
	d: string;
	region?: RegionNode;
	isLake: boolean;
}

const deptPaths: DeptPath[] = [
	...peruRawSvg.matchAll(/<path\s+id="([^"]+)"\s+title="([^"]+)"\s+d="([^"]+)"/g),
].map((m) => ({
	svgId: m[1],
	title: m[2],
	d: m[3],
	region: svgIdToRegion.get(m[1]),
	isLake: m[1] === "PE-LKT",
}));

// ── Gira Escolar Previa (Sensibilización en Lima) ──────────────
const visitedSchools = [
	{
		name: "I.E. 7035 Leoncio Prado",
		location: "San Juan de Miraflores, Lima",
		icon: "biotech",
	},
	{ name: "I.E. 1263 Puruchuco", location: "Ate,Lima", icon: "science" },
	{
		name: "I.E. 1264 Juan Andres Vivanco",
		location: "Ate, Lima",
		icon: "school",
	},
	{
		name: "Colegios Pamer - Sede San Martin",
		location: "San Martin, Lima",
		icon: "school",
	},
];
---

<!-- Ancla de compatibilidad para enlaces heredados (#que-sigue) -->
<div id="que-sigue" style="position:relative; top:-80px;" aria-hidden="true">
</div>

<section
	class="bd-section bd-impact-section"
	id="impacto"
	aria-labelledby="impact-title"
>
	<div class="bd-section-header bd-reveal" style="text-align:center;">
		<span class="bd-chip bd-chip-teal" style="margin-bottom:1rem;">
			<span class="material-icons" style="font-size:14px;">insights</span>
			{t("biodesign.impact.badge")}
		</span>
		<h2 class="bd-headline-lg" id="impact-title">
			{t("biodesign.impact.title")}
			<span class="bd-gradient-text"
				>{t("biodesign.impact.title_highlight")}</span
			>
		</h2>
		<p class="bd-body-md" style="max-width:760px; margin:0 auto;">
			{t("biodesign.impact.subtitle")}
		</p>
	</div>

	<!-- 1. Grilla de 6 KPIs Auditados (Funnel Nacional) -->
	<div class="bd-impact-kpi-grid bd-reveal">
		{
			funnelMetrics.map((m) => (
				<article
					class="bd-glass bd-impact-kpi-card"
					style={`--kpi-rgb: ${m.rgb}; --kpi-accent: ${m.accent};`}
				>
					<div class="bd-impact-kpi-glow" aria-hidden="true" />
					<div class="bd-impact-kpi-top">
						<div class="bd-impact-kpi-icon">
							<span class="material-icons" aria-hidden="true">
								{m.icon}
							</span>
						</div>
						<span class="bd-impact-kpi-val">{m.value}</span>
					</div>
					<h3 class="bd-impact-kpi-label">{m.label}</h3>
					<p class="bd-impact-kpi-sub">{m.sub}</p>
				</article>
			))
		}
	</div>

	<!-- 2. Bento 2 Columnas: Distribución por Tracks + Mapa SVG de 9 Regiones -->
	<div class="bd-impact-bento bd-reveal">
		<!-- Columna Izquierda: Distribución por Ejes Temáticos + Retención Formativa -->
		<div class="bd-impact-col-left">
			<div class="bd-glass bd-tracks-dist-card">
				<div class="bd-card-head">
					<div>
						<span
							class="bd-chip bd-chip-lime"
							style="font-size:0.68rem;"
						>
							<span class="material-icons" style="font-size:12px;"
								>pie_chart</span
							>
							{t("biodesign.impact.tracks.badge")}
						</span>
						<h3
							class="bd-headline-md"
							style="margin:0.45rem 0 0.25rem;"
						>
							{t("biodesign.impact.tracks.title")}
						</h3>
					</div>
					<span class="bd-tracks-total-pill"
						>27 {isEs ? "equipos" : "teams"}</span
					>
				</div>
				<p
					class="bd-caption"
					style="color:var(--bd-on-surface-variant); margin:0 0 1.15rem;"
				>
					{t("biodesign.impact.tracks.desc")}
				</p>

				<!-- Barra Apilada Multicolor -->
				<div
					class="bd-stacked-bar"
					role="img"
					aria-label={t("biodesign.impact.tracks.title")}
				>
					{
						trackStats.map((tr) => (
							<div
								class="bd-stacked-segment"
								style={`width: ${tr.pct}%; background: ${tr.color};`}
								title={`Track ${tr.num}: ${tr.title} (${tr.teams} - ${tr.pct}%)`}
							/>
						))
					}
				</div>

				<!-- Lista de los 3 Tracks con barras y conteos -->
				<div class="bd-track-stat-list">
					{
						trackStats.map((tr) => (
							<div
								class="bd-track-stat-row"
								style={`--tr-rgb: ${tr.rgb}; --tr-color: ${tr.color};`}
							>
								<div class="bd-track-stat-left">
									<span
										class="material-icons bd-track-stat-icon"
										aria-hidden="true"
									>
										{tr.icon}
									</span>
									<div>
										<div class="bd-track-stat-name">
											<span class="bd-track-stat-num">
												T{tr.num}
											</span>
											<strong>{tr.title}</strong>
										</div>
									</div>
								</div>
								<div class="bd-track-stat-right">
									<span class="bd-track-stat-count">
										{tr.teams} {isEs ? "equipos" : "teams"}
									</span>
									<span class="bd-track-stat-pct">
										{tr.pct}%
									</span>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<!-- Tarjeta de Retención Formativa + Gira Escolar -->
			<div class="bd-glass bd-retention-card">
				<div class="bd-retention-top">
					<span
						class="bd-chip bd-chip-purple"
						style="font-size:0.68rem;"
					>
						<span class="material-icons" style="font-size:12px;"
							>verified</span
						>
						{t("biodesign.impact.bootcamp.badge")}
					</span>
					<h3 class="bd-headline-md" style="margin:0.4rem 0 0.5rem;">
						{t("biodesign.impact.bootcamp.title")}
					</h3>
				</div>
				<div class="bd-retention-pills">
					<div class="bd-ret-pill">
						<strong>29</strong>
						<span>{t("biodesign.impact.bootcamp.p1")}</span>
					</div>
					<div class="bd-ret-pill">
						<strong>10</strong>
						<span>{t("biodesign.impact.bootcamp.p2")}</span>
					</div>
					<div class="bd-ret-pill">
						<strong>+28</strong>
						<span>{t("biodesign.impact.bootcamp.p3")}</span>
					</div>
				</div>

				<div class="bd-tour-strip">
					<div class="bd-tour-strip-head">
						<span
							class="material-icons"
							style="font-size:16px; color:var(--bd-tertiary);"
							>explore</span
						>
						<strong>{t("biodesign.impact.tour.title")}:</strong>
						<span>{t("biodesign.impact.tour.subtitle")}</span>
					</div>
					<div class="bd-tour-schools-row">
						{
							visitedSchools.map((s) => (
								<span class="bd-tour-school-chip">
									<span
										class="material-icons"
										style="font-size:13px;"
									>
										{s.icon}
									</span>
									{s.name}
								</span>
							))
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Columna Derecha: Mapa SVG Interactivo del Perú (9 Regiones) -->
		<div class="bd-glass bd-peru-map-card">
			<div class="bd-map-card-header">
				<div class="bd-map-header-top">
					<div>
						<span
							class="bd-chip bd-chip-teal"
							style="font-size:0.68rem;"
						>
							<span class="material-icons" style="font-size:12px;"
								>place</span
							>
							{t("biodesign.impact.map.badge")}
						</span>
						<h3
							class="bd-headline-md"
							style="margin:0.4rem 0 0.2rem;"
						>
							{t("biodesign.impact.map.title")}
						</h3>
						<p
							class="bd-caption"
							style="color:var(--bd-on-surface-variant); margin:0;"
						>
							{t("biodesign.impact.map.subtitle")}
						</p>
					</div>
					<div class="bd-map-telemetry-pills">
						<span class="bd-map-tele-pill">
							<span class="material-icons" style="font-size:13px;"
								>hub</span
							>
							{isEs ? "9 Departamentos" : "9 Departments"}
						</span>
						<span class="bd-map-tele-pill bd-map-tele-pill--lime">
							<span class="material-icons" style="font-size:13px;"
								>workspace_premium</span
							>
							{isEs ? "Red COAR Activa" : "COAR Network"}
						</span>
					</div>
				</div>
			</div>

			<div class="bd-map-layout">
				<!-- Lienzo SVG del Mapa Departamental Oficial del Perú (MapSVG) -->
				<div class="bd-svg-map-wrap">
					<div class="bd-map-hud-top" aria-hidden="true">
						<span class="bd-map-hud-tag">PERÚ • RED BIODESIGN</span>
						<span class="bd-map-hud-coords"
							>00°–18°S / 81°–68°W</span
						>
					</div>
					<svg
						viewBox="-55 -18 650 830"
						class="bd-peru-svg"
						role="img"
						aria-label={t("biodesign.impact.map.title")}
					>
						<defs>
							<radialGradient
								id="bdNodeGlow"
								cx="50%"
								cy="50%"
								r="50%"
							>
								<stop
									offset="0%"
									stop-color="#79f8d0"
									stop-opacity="0.9"></stop>
								<stop
									offset="60%"
									stop-color="#79f8d0"
									stop-opacity="0.25"></stop>
								<stop
									offset="100%"
									stop-color="#79f8d0"
									stop-opacity="0"></stop>
							</radialGradient>
							<radialGradient
								id="bdHubGlow"
								cx="50%"
								cy="50%"
								r="50%"
							>
								<stop
									offset="0%"
									stop-color="#bbf35f"
									stop-opacity="0.95"></stop>
								<stop
									offset="55%"
									stop-color="#79f8d0"
									stop-opacity="0.35"></stop>
								<stop
									offset="100%"
									stop-color="#79f8d0"
									stop-opacity="0"></stop>
							</radialGradient>
							<linearGradient
								id="bdDeptActiveFill"
								x1="0%"
								y1="0%"
								x2="100%"
								y2="100%"
							>
								<stop
									offset="0%"
									stop-color="rgba(121, 248, 208, 0.42)"
								></stop>
								<stop
									offset="100%"
									stop-color="rgba(16, 185, 129, 0.28)"
								></stop>
							</linearGradient>
							<linearGradient
								id="bdDeptHighlightFill"
								x1="0%"
								y1="0%"
								x2="100%"
								y2="100%"
							>
								<stop
									offset="0%"
									stop-color="rgba(187, 243, 95, 0.55)"
								></stop>
								<stop
									offset="100%"
									stop-color="rgba(121, 248, 208, 0.38)"
								></stop>
							</linearGradient>
							<linearGradient
								id="bdDeptSelectedFill"
								x1="0%"
								y1="0%"
								x2="100%"
								y2="100%"
							>
								<stop
									offset="0%"
									stop-color="rgba(121, 248, 208, 0.78)"
								></stop>
								<stop
									offset="100%"
									stop-color="rgba(187, 243, 95, 0.62)"
								></stop>
							</linearGradient>
						</defs>

						<!-- Retícula cartográfica de fondo -->
						<g
							class="bd-map-grid-lines"
							stroke="currentColor"
							stroke-opacity="0.05"
							stroke-width="1.2"
						>
							<line x1="-45" y1="140" x2="585" y2="140"></line>
							<line x1="-45" y1="300" x2="585" y2="300"></line>
							<line x1="-45" y1="460" x2="585" y2="460"></line>
							<line x1="-45" y1="620" x2="585" y2="620"></line>
							<line x1="110" y1="-10" x2="110" y2="800"></line>
							<line x1="270" y1="-10" x2="270" y2="800"></line>
							<line x1="430" y1="-10" x2="430" y2="800"></line>
						</g>

						<!-- Capa 1: Departamentos no participantes y Lago Titicaca (Contexto territorial completo) -->
						<g class="bd-map-depts-base">
							{
								deptPaths
									.filter((dp) => !dp.region)
									.map((dp) => (
										<path
											id={dp.svgId}
											d={dp.d}
											class={
												dp.isLake
													? "bd-dept-path bd-dept-lake"
													: "bd-dept-path bd-dept-inactive"
											}
										>
											<title>{dp.title}</title>
										</path>
									))
							}
						</g>

						<!-- Capa 2: Los 9 Departamentos / Regiones Participantes Pintados (Choropleth Interactivo) -->
						<g class="bd-map-depts-active">
