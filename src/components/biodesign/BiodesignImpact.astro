					</div>

					<div class="bd-region-chips-head">
						<span
							class="bd-caption"
							style="font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:var(--bd-on-surface-variant);"
						>
							{t("biodesign.impact.map.regions_list")}
