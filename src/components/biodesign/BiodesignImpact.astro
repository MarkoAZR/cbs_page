							{
								regions
									.filter((r) => r.arc)
									.map((r) => (
										<path
											d={r.arc}
											class="bd-map-arc"
											data-region-arc={r.id}
											stroke="rgba(121, 248, 208, 0.38)"
											stroke-width="2"
											stroke-dasharray="5 5"
										/>
									))
							}
						</g>

