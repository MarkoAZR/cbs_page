</section>

<script>
	function initBiodesignImpactMap() {
		const section = document.getElementById("impacto");
		if (!section) return;

		const nodes =
			section.querySelectorAll<SVGGElement>("[data-region-node]");
		const deptPaths =
			section.querySelectorAll<SVGPathElement>("[data-region-path]");
		const arcs =
			section.querySelectorAll<SVGPathElement>("[data-region-arc]");
		const chips =
			section.querySelectorAll<HTMLButtonElement>("[data-region-btn]");
		const nameEl = document.getElementById("bd-region-detail-name");
		const zoneEl = document.getElementById("bd-region-detail-zone");
		const schoolsEl = document.getElementById("bd-region-detail-schools");

		function selectRegion(regionId: string) {
			const chip = section?.querySelector<HTMLButtonElement>(
				`[data-region-btn="${regionId}"]`,
			);
			if (!chip) return;

			nodes.forEach((n) =>
				n.classList.toggle(
					"is-active",
					n.dataset.regionNode === regionId,
				),
			);
			deptPaths.forEach((p) =>
				p.classList.toggle(
					"is-active",
					p.dataset.regionPath === regionId,
				),
			);
			arcs.forEach((a) =>
				a.classList.toggle(
					"is-active",
					a.dataset.regionArc === regionId,
				),
			);
			chips.forEach((c) =>
				c.classList.toggle(
					"is-active",
					c.dataset.regionBtn === regionId,
				),
			);

			if (nameEl) nameEl.textContent = chip.dataset.name || "";
			if (zoneEl) zoneEl.textContent = chip.dataset.zone || "";
			if (schoolsEl) schoolsEl.textContent = chip.dataset.schools || "";
		}

		chips.forEach((chip) => {
			chip.addEventListener("click", () => {
				if (chip.dataset.regionBtn)
					selectRegion(chip.dataset.regionBtn);
			});
		});

		deptPaths.forEach((p) => {
			p.addEventListener("click", () => {
				if (p.dataset.regionPath) selectRegion(p.dataset.regionPath);
			});
		});

		nodes.forEach((node) => {
			node.addEventListener("click", () => {
				if (node.dataset.regionNode)
					selectRegion(node.dataset.regionNode);
			});
			node.addEventListener("keydown", (e) => {
				if (
					(e.key === "Enter" || e.key === " ") &&
					node.dataset.regionNode
				) {
					e.preventDefault();
					selectRegion(node.dataset.regionNode);
				}
			});
		});
	}

	initBiodesignImpactMap();
	document.addEventListener("astro:page-load", initBiodesignImpactMap);
</script>

