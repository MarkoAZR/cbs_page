---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── 3 Instituciones Educativas Oficiales con Fotos Específicas ─────
const schools = [
	{
		id: 'school1',
		name: t('biodesign.memorias.school1.name'),
		district: t('biodesign.memorias.school1.district'),
		badge: t('biodesign.memorias.school1.badge'),
		tagline: t('biodesign.memorias.school1.tagline'),
		desc: t('biodesign.memorias.school1.desc'),
		icon: 'biotech',
		accentColor: 'var(--bd-primary)',
		rgbColor: 'var(--bd-primary-rgb)',
		focus: 'ADN & Modelado de UT',
		photos: [
			{
				id: 'puruchuco-1',
				title: t('biodesign.memorias.school1.p1.title'),
				desc: t('biodesign.memorias.school1.p1.desc'),
				tag: 'Estructura ADN',
				code: 'SEQ: 5\'-ATG-DNA-3\'',
				imageSrc: `${base}/Biodesign/memorias/gira_puruchuco_1.jpg`,
				icon: 'biotech',
				isSpotlight: true,
			},
			{
				id: 'puruchuco-2',
				title: t('biodesign.memorias.school1.p2.title'),
				desc: t('biodesign.memorias.school1.p2.desc'),
				tag: 'Ensamblaje UT',
				code: 'UT: P+RBS+CDS+T',
				imageSrc: `${base}/Biodesign/memorias/gira_puruchuco_2.jpg`,
				icon: 'schema',
				isSpotlight: false,
			},
			{
				id: 'puruchuco-3',
				title: t('biodesign.memorias.school1.p3.title'),
				desc: t('biodesign.memorias.school1.p3.desc'),
				tag: 'Comunidad Docente',
				code: 'DOCENTES: CIENCIA-PERU',
				imageSrc: `${base}/Biodesign/memorias/gira_puruchuco_3.jpg`,
				icon: 'groups',
				isSpotlight: false,
			},
		],
	},
	{
		id: 'school2',
		name: t('biodesign.memorias.school2.name'),
		district: t('biodesign.memorias.school2.district'),
		badge: t('biodesign.memorias.school2.badge'),
		tagline: t('biodesign.memorias.school2.tagline'),
		desc: t('biodesign.memorias.school2.desc'),
		icon: 'science',
		accentColor: 'var(--bd-secondary)',
		rgbColor: 'var(--bd-secondary-rgb)',
		focus: 'Expresión Génica & BioBricks',
		photos: [
			{
				id: 'vivanco-1',
				title: t('biodesign.memorias.school2.p1.title'),
				desc: t('biodesign.memorias.school2.p1.desc'),
				tag: 'Regulación ON/OFF',
				code: 'REG: TF-PROMOTER-SWITCH',
				imageSrc: `${base}/Biodesign/memorias/gira_vivanco_1.jpg`,
				icon: 'toggle_on',
				isSpotlight: true,
			},
			{
				id: 'vivanco-2',
				title: t('biodesign.memorias.school2.p2.title'),
				desc: t('biodesign.memorias.school2.p2.desc'),
				tag: 'Diseño en Equipo',
				code: 'TEAMS: CIRCUIT-DESIGN',
				imageSrc: `${base}/Biodesign/memorias/gira_vivanco_2.jpg`,
				icon: 'psychology',
				isSpotlight: false,
			},
			{
				id: 'vivanco-3',
				title: t('biodesign.memorias.school2.p3.title'),
				desc: t('biodesign.memorias.school2.p3.desc'),
				tag: 'Vocación STEM',
				code: 'MENTOR: UNMSM-RESEARCH',
				imageSrc: `${base}/Biodesign/memorias/gira_vivanco_3.jpg`,
				icon: 'school',
				isSpotlight: false,
			},
		],
	},
	{
		id: 'school3',
		name: t('biodesign.memorias.school3.name'),
		district: t('biodesign.memorias.school3.district'),
		badge: t('biodesign.memorias.school3.badge'),
		tagline: t('biodesign.memorias.school3.tagline'),
		desc: t('biodesign.memorias.school3.desc'),
		icon: 'school',
		accentColor: 'var(--bd-tertiary)',
		rgbColor: 'var(--bd-tertiary-rgb)',
		focus: 'Biosensores & Vocación STEM',
		photos: [
			{
				id: 'leoncio-1',
				title: t('biodesign.memorias.school3.p1.title'),
				desc: t('biodesign.memorias.school3.p1.desc'),
				tag: 'Biosensores Vivos',
				code: 'SENSOR: HEAVY-METALS',
				imageSrc: `${base}/Biodesign/memorias/gira_leoncio_prado_1.jpg`,
				icon: 'sensors',
				isSpotlight: true,
			},
			{
				id: 'leoncio-2',
				title: t('biodesign.memorias.school3.p2.title'),
				desc: t('biodesign.memorias.school3.p2.desc'),
				tag: 'Laboratorio de Partes',
				code: 'BIOBRICK: BIO-PARTS',
				imageSrc: `${base}/Biodesign/memorias/gira_leoncio_prado_2.jpg`,
				icon: 'scatter_plot',
				isSpotlight: false,
			},
			{
				id: 'leoncio-3',
				title: t('biodesign.memorias.school3.p3.title'),
				desc: t('biodesign.memorias.school3.p3.desc'),
				tag: 'Pases al Bootcamp',
				code: 'PASS: BIODESIGN-2026',
				imageSrc: `${base}/Biodesign/memorias/gira_leoncio_prado_3.jpg`,
				icon: 'rocket_launch',
				isSpotlight: false,
			},
		],
	},
];

// ── Hitos Hackathon BioDesign 2026 (Octubre 2026) ──────────────────
const hackathonMilestones = [
	{
		id: 'hack-1',
		icon: 'terminal',
		tag: 'SPRINT 48H',
		code: 'CAD: BENCHLING-SILICO',
		title: t('biodesign.memorias.hackathon.m1.title'),
		desc: t('biodesign.memorias.hackathon.m1.desc'),
		accent: 'var(--bd-primary)',
		rgb: 'var(--bd-primary-rgb)',
	},
	{
		id: 'hack-2',
		icon: 'psychology',
		tag: 'MENTORÍA EXPERTA',
		code: 'RESEARCH: CBS-NEA-INS',
		title: t('biodesign.memorias.hackathon.m2.title'),
		desc: t('biodesign.memorias.hackathon.m2.desc'),
		accent: 'var(--bd-secondary)',
		rgb: 'var(--bd-secondary-rgb)',
	},
	{
		id: 'hack-3',
		icon: 'emoji_events',
		tag: 'PITCH & PODIO',
		code: 'AWARDS: TOP-3-WINNERS',
		title: t('biodesign.memorias.hackathon.m3.title'),
		desc: t('biodesign.memorias.hackathon.m3.desc'),
		accent: 'var(--bd-tertiary)',
		rgb: 'var(--bd-tertiary-rgb)',
	},
];
---

<section class="bd-section bd-memorias-section" id="memorias">
	<!-- Ambient glow orbs -->
	<div class="bd-memorias-ambient" aria-hidden="true">
		<div class="bd-memorias-orb bd-memorias-orb--1"></div>
		<div class="bd-memorias-orb bd-memorias-orb--2"></div>
		<div class="bd-memorias-grid-pattern"></div>
	</div>

	<div class="bd-memorias-container">
		<!-- Header Principal -->
		<div class="bd-memorias-header">
			<div class="bd-chip bd-chip-lime bd-memorias-badge">
				<span class="material-icons" style="font-size: 15px;">history_edu</span>
				{t('biodesign.memorias.badge')}
			</div>
			<h2 class="bd-headline-lg bd-memorias-title">
				{t('biodesign.memorias.title')}
			</h2>
			<p class="bd-body-lg bd-memorias-subtitle">
				{t('biodesign.memorias.subtitle')}
			</p>
		</div>

		<!-- ══════════════════════════════════════════════════════
		     SELECTOR DE HITOS (MILESTONE SEGMENTED CONTROL)
		     ══════════════════════════════════════════════════════ -->
		<div class="bd-milestones-nav-wrap">
			<div class="bd-milestones-nav" role="tablist" aria-label={t('biodesign.memorias.milestones.tag')}>
				<button 
					type="button" 
					class="bd-milestone-tab is-active" 
					id="tab-btn-gira"
					role="tab" 
					aria-selected="true" 
					aria-controls="milestone-panel-gira"
					data-milestone-target="gira"
				>
					<span class="material-icons bd-tab-icon">domain</span>
					<div class="bd-tab-text">
						<span class="bd-tab-label">{t('biodesign.memorias.milestones.gira')}</span>
						<span class="bd-tab-status">
							<span class="bd-status-dot bd-status-dot--green"></span>
							{t('biodesign.memorias.milestones.gira_status')}
						</span>
					</div>
				</button>

				<button 
					type="button" 
					class="bd-milestone-tab" 
					id="tab-btn-hackathon"
					role="tab" 
					aria-selected="false" 
					aria-controls="milestone-panel-hackathon"
					data-milestone-target="hackathon"
				>
					<span class="material-icons bd-tab-icon">emoji_events</span>
					<div class="bd-tab-text">
						<span class="bd-tab-label">{t('biodesign.memorias.milestones.hackathon')}</span>
						<span class="bd-tab-status">
							<span class="bd-status-dot bd-status-dot--amber"></span>
							{t('biodesign.memorias.milestones.hackathon_status')}
						</span>
					</div>
				</button>
			</div>
		</div>

		<!-- ══════════════════════════════════════════════════════
		     PANEL 1: GIRA ESCOLAR (MASTER-DETAIL BENTO HUB)
		     ══════════════════════════════════════════════════════ -->
		<div 
			id="milestone-panel-gira" 
			class="bd-milestone-panel is-active" 
			role="tabpanel" 
			aria-labelledby="tab-btn-gira"
		>
			<!-- Cinta Molecular Compacta: Unidad de Transcripción (UT) -->
			<div class="bd-ut-strip" aria-label="Estructura de la Unidad de Transcripción">
				<div class="bd-ut-strip-header">
					<span class="material-icons bd-ut-dna-icon">schema</span>
					<div class="bd-ut-strip-titles">
						<span class="bd-ut-strip-tag">{t('biodesign.memorias.ut.badge')}</span>
						<span class="bd-ut-strip-title">{t('biodesign.memorias.ut.title')}</span>
					</div>
				</div>

				<div class="bd-ut-strip-pipeline">
					<div class="bd-ut-chip-node bd-ut-chip-node--promoter" tabindex="0" title={t('biodesign.memorias.ut.part1.desc')}>
						<span class="bd-ut-node-num">01</span>
						<span class="bd-ut-node-name">{t('biodesign.memorias.ut.part1.name')}</span>
						<span class="bd-ut-node-role">{t('biodesign.memorias.ut.part1.role')}</span>
					</div>
					<span class="bd-ut-strip-arrow" aria-hidden="true">➔</span>

					<div class="bd-ut-chip-node bd-ut-chip-node--rbs" tabindex="0" title={t('biodesign.memorias.ut.part2.desc')}>
						<span class="bd-ut-node-num">02</span>
						<span class="bd-ut-node-name">{t('biodesign.memorias.ut.part2.name')}</span>
						<span class="bd-ut-node-role">{t('biodesign.memorias.ut.part2.role')}</span>
					</div>
					<span class="bd-ut-strip-arrow" aria-hidden="true">➔</span>

					<div class="bd-ut-chip-node bd-ut-chip-node--cds" tabindex="0" title={t('biodesign.memorias.ut.part3.desc')}>
						<span class="bd-ut-node-num">03</span>
						<span class="bd-ut-node-name">{t('biodesign.memorias.ut.part3.name')}</span>
						<span class="bd-ut-node-role">{t('biodesign.memorias.ut.part3.role')}</span>
					</div>
					<span class="bd-ut-strip-arrow" aria-hidden="true">➔</span>

					<div class="bd-ut-chip-node bd-ut-chip-node--term" tabindex="0" title={t('biodesign.memorias.ut.part4.desc')}>
						<span class="bd-ut-node-num">04</span>
						<span class="bd-ut-node-name">{t('biodesign.memorias.ut.part4.name')}</span>
						<span class="bd-ut-node-role">{t('biodesign.memorias.ut.part4.role')}</span>
					</div>
				</div>
			</div>

			<!-- Master-Detail Stage: Selector de Colegios ➔ Collage Dinámico -->
			<div class="bd-showcase-layout">
				<!-- MASTER: Columna de Selección de Colegios -->
				<div class="bd-master-column" role="tablist" aria-label={t('biodesign.memorias.schools_tag')}>
					<div class="bd-column-header">
						<span class="material-icons" style="font-size:16px;">domain</span>
						<span>{t('biodesign.memorias.schools_tag')}</span>
					</div>

					<div class="bd-school-triggers">
						{schools.map((school, index) => (
							<button
								type="button"
								class={`bd-school-trigger-card ${index === 0 ? 'is-selected' : ''}`}
								id={`school-tab-${school.id}`}
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								aria-controls={`school-panel-${school.id}`}
								data-school-id={school.id}
								style={`--school-accent: ${school.accentColor}; --school-rgb: ${school.rgbColor};`}
							>
								<div class="bd-st-glow" aria-hidden="true"></div>
								<div class="bd-st-header">
									<div class="bd-st-icon-box">
										<span class="material-icons">{school.icon}</span>
									</div>
									<div class="bd-st-badges">
										<span class="bd-st-chip">{school.badge}</span>
										<span class="bd-st-count">
											<span class="material-icons" style="font-size: 12px;">photo_camera</span>
											{t('biodesign.memorias.photos_count')}
										</span>
									</div>
								</div>

								<div class="bd-st-info">
									<h3 class="bd-st-name">{school.name}</h3>
									<span class="bd-st-district">
										<span class="material-icons">place</span>
										{school.district}
									</span>
									<p class="bd-st-focus">{school.focus}</p>
								</div>

								<div class="bd-st-indicator" aria-hidden="true">
									<span class="material-icons">arrow_forward</span>
								</div>
							</button>
						))}
					</div>
				</div>

				<!-- DETAIL: Canvas Reactivo de Fotografías del Colegio Seleccionado -->
				<div class="bd-detail-column">
					{schools.map((school, index) => (
						<div
							class={`bd-school-panel ${index === 0 ? 'is-active' : ''}`}
							id={`school-panel-${school.id}`}
							role="tabpanel"
							aria-labelledby={`school-tab-${school.id}`}
							data-school-content={school.id}
						>
							<!-- Encabezado del Colegio Activo -->
							<div class="bd-panel-header">
								<div class="bd-panel-meta">
									<span class="bd-chip bd-chip-sm" style={`color: ${school.accentColor}; border-color: rgba(${school.rgbColor}, 0.35); background: rgba(${school.rgbColor}, 0.08);`}>
										<span class="material-icons" style="font-size: 13px;">verified</span>
										{t('biodesign.memorias.active_school_badge')}
									</span>
									<span class="bd-panel-district">
										<span class="material-icons">place</span>
										{school.district}
									</span>
								</div>
								<h3 class="bd-panel-title">{school.name}</h3>
								<p class="bd-panel-desc">{school.desc}</p>
							</div>

							<!-- Mini-Bento Collage de 3 Fotos -->
							<div class="bd-school-bento">
								<!-- Foto 1: Spotlight (Grande, izq/top) -->
								<div
									class="bd-bento-card bd-bento-card--spotlight"
									data-lightbox-trigger
									data-item-title={school.photos[0].title}
									data-item-desc={school.photos[0].desc}
									data-item-tag={school.photos[0].tag}
									data-item-code={school.photos[0].code}
									data-item-src={school.photos[0].imageSrc}
									tabindex="0"
									role="button"
									aria-label={`Ver foto: ${school.photos[0].title}`}
								>
									<div class="bd-bento-media">
										<img
											src={school.photos[0].imageSrc}
											alt={school.photos[0].title}
											class="bd-bento-img"
											loading="lazy"
											onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
										/>
										<div class="bd-bento-ph" style="display: none;">
											<div class="bd-ph-circuit"></div>
											<div class="bd-ph-glow" style={`background: radial-gradient(circle, rgba(${school.rgbColor}, 0.3), transparent 70%);`}></div>
											<div class="bd-ph-box">
												<span class="material-icons bd-ph-icon" style={`color: ${school.accentColor};`}>{school.photos[0].icon}</span>
												<span class="bd-ph-code">{school.photos[0].code}</span>
												<span class="bd-ph-tag">{school.photos[0].tag}</span>
												<span class="bd-ph-note">
													<span class="material-icons" style="font-size:12px;">zoom_in</span>
													{lang === 'es' ? 'Fotografía oficial en proceso' : 'Official photo slot'}
												</span>
											</div>
										</div>
									</div>

									<div class="bd-bento-overlay">
										<div class="bd-overlay-top">
											<span class="bd-badge-pill">{school.photos[0].tag}</span>
											<span class="bd-zoom-btn" aria-hidden="true">
												<span class="material-icons">fullscreen</span>
											</span>
										</div>
										<div class="bd-overlay-bottom">
											<span class="bd-code-crumb">{school.photos[0].code}</span>
											<h4 class="bd-photo-title">{school.photos[0].title}</h4>
											<p class="bd-photo-desc">{school.photos[0].desc}</p>
										</div>
									</div>
								</div>

								<!-- Fotos 2 y 3: Companion Tiles (Columna derecha) -->
								<div class="bd-bento-companions">
									{school.photos.slice(1).map((photo) => (
										<div
											class="bd-bento-card bd-bento-card--companion"
											data-lightbox-trigger
											data-item-title={photo.title}
											data-item-desc={photo.desc}
											data-item-tag={photo.tag}
											data-item-code={photo.code}
											data-item-src={photo.imageSrc}
											tabindex="0"
											role="button"
											aria-label={`Ver foto: ${photo.title}`}
										>
											<div class="bd-bento-media">
												<img
													src={photo.imageSrc}
													alt={photo.title}
													class="bd-bento-img"
													loading="lazy"
													onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
												/>
												<div class="bd-bento-ph" style="display: none;">
													<div class="bd-ph-circuit"></div>
													<div class="bd-ph-box">
														<span class="material-icons bd-ph-icon" style={`color: ${school.accentColor}; font-size:1.8rem;`}>{photo.icon}</span>
														<span class="bd-ph-code" style="font-size:0.6rem;">{photo.code}</span>
														<span class="bd-ph-tag" style="font-size:0.68rem;">{photo.tag}</span>
													</div>
												</div>
											</div>

											<div class="bd-bento-overlay bd-bento-overlay--compact">
												<div class="bd-overlay-top">
													<span class="bd-badge-pill bd-badge-pill--sm">{photo.tag}</span>
													<span class="bd-zoom-btn bd-zoom-btn--sm" aria-hidden="true">
														<span class="material-icons" style="font-size:16px;">fullscreen</span>
													</span>
												</div>
												<div class="bd-overlay-bottom">
													<h4 class="bd-photo-title bd-photo-title--sm">{photo.title}</h4>
													<p class="bd-photo-desc bd-photo-desc--sm">{photo.desc}</p>
												</div>
											</div>
										</div>
									))}
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>

		<!-- ══════════════════════════════════════════════════════
		     PANEL 2: HACKATHON BIODESIGN 2026 (FASE FINAL)
		     ══════════════════════════════════════════════════════ -->
		<div 
			id="milestone-panel-hackathon" 
			class="bd-milestone-panel" 
			role="tabpanel" 
			aria-labelledby="tab-btn-hackathon"
			hidden
		>
			<div class="bd-hackathon-stage">
				<!-- Banner Principal de Telemetría -->
				<div class="bd-hack-hero-card">
					<div class="bd-hack-hero-ambient" aria-hidden="true"></div>
					<div class="bd-hack-hero-content">
						<div class="bd-hack-status-row">
							<span class="bd-chip bd-chip-lime">
								<span class="bd-status-dot bd-status-dot--amber"></span>
								{t('biodesign.memorias.hackathon.status_pill')}
							</span>
							<span class="bd-hack-code-pill">REG: FA-HACK-2026-OCT</span>
						</div>
						<h3 class="bd-hack-title">{t('biodesign.memorias.hackathon.title')}</h3>
						<p class="bd-hack-desc">{t('biodesign.memorias.hackathon.desc')}</p>
					</div>
				</div>

				<!-- Banner Cibernético: ¡Se desbloquea el 29 de Octubre! -->
				<div class="bd-hack-unlock-banner">
					<div class="bd-unlock-glow" aria-hidden="true"></div>
					<div class="bd-unlock-icon-wrap">
