<script>
	// ── Controlador Interactivo Vanilla (Hub de Memorias) ───────────
	function initMemoriesHub() {
		// 1. Selector de Hitos (Gira Escolar ⇄ Hackathon)
		const milestoneTabs = document.querySelectorAll<HTMLButtonElement>('.bd-milestone-tab');
		const milestonePanels = document.querySelectorAll<HTMLElement>('.bd-milestone-panel');

		milestoneTabs.forEach(tab => {
			tab.addEventListener('click', () => {
				const target = tab.getAttribute('data-milestone-target');
				if (!target) return;

				milestoneTabs.forEach(t => {
					const isActive = t === tab;
					t.classList.toggle('is-active', isActive);
					t.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});

				milestonePanels.forEach(panel => {
					const isTarget = panel.id === `milestone-panel-${target}`;
					panel.classList.toggle('is-active', isTarget);
					panel.hidden = !isTarget;
				});
			});
		});

		// 2. Master-Detail Selector de Colegios
		const schoolTriggers = document.querySelectorAll<HTMLButtonElement>('.bd-school-trigger-card');
		const schoolPanels = document.querySelectorAll<HTMLElement>('.bd-school-panel');

		schoolTriggers.forEach(btn => {
			btn.addEventListener('click', () => {
				const schoolId = btn.getAttribute('data-school-id');
				if (!schoolId) return;

				schoolTriggers.forEach(b => {
					const isSelected = b === btn;
					b.classList.toggle('is-selected', isSelected);
					b.setAttribute('aria-selected', isSelected ? 'true' : 'false');
				});

				schoolPanels.forEach(panel => {
					const isPanelActive = panel.getAttribute('data-school-content') === schoolId;
					panel.classList.toggle('is-active', isPanelActive);
				});
			});
		});

		// 3. Lightbox Accesible
		const lightboxTriggers = document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]');
		const dialog = document.getElementById('bd-memorias-lightbox') as HTMLDialogElement | null;
		if (!dialog) return;

		const closeBtns = dialog.querySelectorAll('[data-close-lightbox]');
		const lbImg = document.getElementById('bd-lightbox-img') as HTMLImageElement | null;
		const lbPlaceholder = document.getElementById('bd-lightbox-placeholder');
		const lbTitle = document.getElementById('bd-lightbox-title');
		const lbDesc = document.getElementById('bd-lightbox-desc');
		const lbTag = document.getElementById('bd-lb-tag');
		const lbCode = document.getElementById('bd-lb-code');

		function openLightbox(trigger: HTMLElement) {
			const title = trigger.getAttribute('data-item-title') || '';
			const desc = trigger.getAttribute('data-item-desc') || '';
			const tag = trigger.getAttribute('data-item-tag') || '';
			const code = trigger.getAttribute('data-item-code') || '';
			const src = trigger.getAttribute('data-item-src') || '';

			if (lbTitle) lbTitle.textContent = title;
			if (lbDesc) lbDesc.textContent = desc;
			if (lbTag) lbTag.textContent = tag;
			if (lbCode) lbCode.textContent = code;

			if (lbImg && lbPlaceholder) {
				lbImg.src = src;
				lbImg.alt = title;
				lbImg.style.display = 'block';
				lbPlaceholder.style.display = 'none';

				lbImg.onerror = () => {
					lbImg.style.display = 'none';
					lbPlaceholder.style.display = 'flex';
				};
			}

			if (typeof dialog?.showModal === 'function') {
				dialog.showModal();
			} else {
				dialog?.setAttribute('open', 'true');
			}
			document.body.style.overflow = 'hidden';
		}

		function closeLightbox() {
			if (typeof dialog?.close === 'function') {
				dialog.close();
			} else {
				dialog?.removeAttribute('open');
			}
			document.body.style.overflow = '';
		}

		lightboxTriggers.forEach(trigger => {
			trigger.addEventListener('click', () => openLightbox(trigger));
			trigger.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					openLightbox(trigger);
				}
			});
		});

		closeBtns.forEach(btn => {
			btn.addEventListener('click', closeLightbox);
		});

		dialog.addEventListener('cancel', () => {
			document.body.style.overflow = '';
		});
	}

	initMemoriesHub();
	document.addEventListener('astro:after-swap', initMemoriesHub);
</script>

