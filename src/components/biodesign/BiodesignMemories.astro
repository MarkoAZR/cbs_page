		background: rgba(var(--school-rgb), 0.1);
		border: 1px solid rgba(var(--school-rgb), 0.25);
	}

	.bd-st-count {
		font-size: 0.62rem;
		color: var(--bd-text-secondary);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.bd-st-name {
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--bd-text-primary);
		margin-bottom: 0.25rem;
	}

	.bd-st-district {
		font-size: 0.78rem;
		color: var(--bd-text-secondary);
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-bottom: 0.35rem;
	}

	.bd-st-district .material-icons {
		font-size: 0.9rem;
		color: var(--school-accent);
	}

	.bd-st-focus {
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--bd-on-surface-variant);
	}

	.bd-st-indicator {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.06);
		color: var(--bd-text-secondary);
		opacity: 0.5;
		transition: all 0.2s ease;
	}

	.bd-school-trigger-card.is-selected .bd-st-indicator {
		background: var(--school-accent);
		color: #0b0914;
		opacity: 1;
		transform: translateX(2px);
	}

	/* DETAIL: Paneles de Colegios */
	.bd-school-panel {
		display: none;
		animation: bd-panel-in 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.bd-school-panel.is-active {
		display: block;
	}

	.bd-panel-header {
		margin-bottom: 1.25rem;
		background: rgba(22, 20, 35, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 18px;
		padding: 1.25rem 1.5rem;
	}

	:root:not(.dark) .bd-panel-header {
		background: #ffffff;
		border-color: rgba(0, 0, 0, 0.08);
	}

	.bd-panel-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.4rem;
	}

	.bd-panel-district {
		font-size: 0.75rem;
		color: var(--bd-text-secondary);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.bd-panel-district .material-icons {
		font-size: 0.85rem;
	}

	.bd-panel-title {
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--bd-text-primary);
		margin-bottom: 0.3rem;
	}

	.bd-panel-desc {
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--bd-text-secondary);
	}

	/* Bento de 3 Fotos */
	.bd-school-bento {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 1rem;
		align-items: stretch;
	}

	@media (max-width: 768px) {
		.bd-school-bento {
			grid-template-columns: 1fr;
		}
	}

	.bd-bento-companions {
		display: grid;
		grid-template-rows: 1fr 1fr;
		gap: 1rem;
	}

	.bd-bento-card {
		position: relative;
		border-radius: 18px;
		overflow: hidden;
		cursor: pointer;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(22, 20, 35, 0.8);
		transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.25s ease, box-shadow 0.25s ease;
	}

	:root:not(.dark) .bd-bento-card {
		background: #ffffff;
		border-color: rgba(0, 0, 0, 0.08);
	}

	.bd-bento-card--spotlight {
		min-height: 380px;
	}

	.bd-bento-card--companion {
		min-height: 180px;
	}

	.bd-bento-card:hover,
	.bd-bento-card:focus-visible {
		transform: translateY(-3px);
		border-color: rgba(var(--bd-tertiary-rgb), 0.45);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(var(--bd-tertiary-rgb), 0.15);
		outline: none;
	}

	.bd-bento-media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	.bd-bento-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.bd-bento-card:hover .bd-bento-img {
		transform: scale(1.05);
	}

	/* Fallback Placeholders */
	.bd-bento-ph {
		width: 100%;
		height: 100%;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(circle at 50% 40%, rgba(32, 28, 50, 0.98), rgba(15, 13, 26, 1));
		padding: 1.5rem;
		text-align: center;
	}

	:root:not(.dark) .bd-bento-ph {
		background: radial-gradient(circle at 50% 40%, #f8fafc, #e2e8f0);
	}

	.bd-ph-circuit {
		position: absolute;
		inset: 0;
		background-image: 
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 20px 20px;
	}

	.bd-ph-glow {
		position: absolute;
		width: 140px;
		height: 140px;
		border-radius: 50%;
		filter: blur(24px);
		pointer-events: none;
	}

	.bd-ph-box {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
	}

	.bd-ph-icon {
		font-size: 2.2rem;
		margin-bottom: 0.2rem;
	}

	.bd-ph-code {
		font-family: 'Space Grotesk', monospace;
		font-size: 0.65rem;
		color: var(--bd-primary);
		background: rgba(var(--bd-primary-rgb), 0.1);
		padding: 0.12rem 0.45rem;
		border-radius: 4px;
	}

	.bd-ph-tag {
		font-size: 0.72rem;
		font-weight: 800;
		color: var(--bd-text-primary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.bd-ph-note {
		font-size: 0.68rem;
		color: var(--bd-text-secondary);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	/* Card Overlays */
	.bd-bento-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		background: linear-gradient(180deg, rgba(14, 12, 27, 0.2) 0%, rgba(14, 12, 27, 0.88) 70%, rgba(14, 12, 27, 0.98) 100%);
	}

	:root:not(.dark) .bd-bento-overlay {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(240, 243, 248, 0.9) 65%, rgba(240, 243, 248, 0.98) 100%);
	}

	.bd-bento-overlay--compact {
		padding: 0.85rem 1rem;
	}

	.bd-overlay-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.bd-badge-pill {
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.22rem 0.55rem;
		border-radius: 100px;
		background: rgba(19, 17, 32, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: var(--bd-text-primary);
	}

	.bd-badge-pill--sm {
		font-size: 0.6rem;
		padding: 0.15rem 0.45rem;
	}

	.bd-zoom-btn {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(19, 17, 32, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: var(--bd-text-primary);
		transition: all 0.2s ease;
	}

	.bd-bento-card:hover .bd-zoom-btn {
		color: var(--bd-tertiary);
		border-color: var(--bd-tertiary);
		transform: scale(1.1);
	}

	.bd-zoom-btn--sm {
		width: 26px;
		height: 26px;
	}

	.bd-overlay-bottom {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.bd-code-crumb {
		font-family: 'Space Grotesk', monospace;
		font-size: 0.62rem;
		color: var(--bd-tertiary);
	}

	.bd-photo-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		line-height: 1.25;
	}

	.bd-photo-title--sm {
		font-size: 0.88rem;
	}

	.bd-photo-desc {
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--bd-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.bd-photo-desc--sm {
		font-size: 0.72rem;
		-webkit-line-clamp: 1;
	}

	/* ── PANEL 2: HACKATHON BIODESIGN STAGE ── */
	.bd-hackathon-stage {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.bd-hack-hero-card {
		position: relative;
		border-radius: 20px;
		padding: 2.25rem 2rem;
		background: linear-gradient(135deg, rgba(35, 30, 56, 0.85), rgba(18, 16, 32, 0.95));
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.3);
		overflow: hidden;
		box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
	}

	:root:not(.dark) .bd-hack-hero-card {
		background: linear-gradient(135deg, #ffffff, #f8fafc);
		border-color: rgba(77, 124, 15, 0.3);
	}

	.bd-hack-hero-ambient {
		position: absolute;
		top: -40%;
		right: -10%;
		width: 320px;
		height: 320px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(var(--bd-tertiary-rgb), 0.22), transparent 70%);
		filter: blur(40px);
		pointer-events: none;
	}

	.bd-hack-hero-content {
		position: relative;
		z-index: 1;
		max-width: 780px;
	}

	.bd-hack-status-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
	}

	.bd-hack-code-pill {
		font-family: 'Space Grotesk', monospace;
		font-size: 0.68rem;
		color: var(--bd-tertiary);
		background: rgba(var(--bd-tertiary-rgb), 0.1);
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.2);
	}

	.bd-hack-title {
		font-size: clamp(1.4rem, 2.6vw, 1.85rem);
		font-weight: 800;
		color: var(--bd-text-primary);
		line-height: 1.25;
		margin-bottom: 0.65rem;
	}

	.bd-hack-desc {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--bd-text-secondary);
	}

	/* Banner Cibernético: ¡Se desbloquea el 29 de Octubre! */
	.bd-hack-unlock-banner {
		position: relative;
		border-radius: 18px;
		padding: 1.5rem 1.75rem;
		background: linear-gradient(135deg, rgba(42, 30, 68, 0.9), rgba(20, 16, 36, 0.95));
		border: 1px solid rgba(var(--bd-secondary-rgb), 0.4);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), inset 0 0 25px rgba(var(--bd-secondary-rgb), 0.1);
		display: flex;
		align-items: center;
		gap: 1.5rem;
		overflow: hidden;
	}

	:root:not(.dark) .bd-hack-unlock-banner {
		background: linear-gradient(135deg, #ffffff, #f5f3ff);
		border-color: rgba(147, 51, 234, 0.3);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	.bd-unlock-glow {
		position: absolute;
		top: -40%;
		left: -20px;
		width: 180px;
		height: 180px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(var(--bd-secondary-rgb), 0.35), transparent 70%);
		filter: blur(30px);
		pointer-events: none;
	}

	.bd-unlock-icon-wrap {
		width: 54px;
		height: 54px;
		border-radius: 16px;
		background: rgba(var(--bd-secondary-rgb), 0.18);
		border: 1px solid rgba(var(--bd-secondary-rgb), 0.35);
		color: var(--bd-secondary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 0 20px rgba(var(--bd-secondary-rgb), 0.25);
	}

	.bd-unlock-icon {
		font-size: 1.85rem;
	}

	.bd-unlock-info {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.bd-unlock-badge-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.bd-unlock-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.15);
		border: 1px solid rgba(245, 158, 11, 0.35);
		padding: 0.25rem 0.65rem;
		border-radius: 100px;
		box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
	}

	.bd-unlock-tag {
		font-family: 'Space Grotesk', monospace;
		font-size: 0.65rem;
		color: var(--bd-secondary);
		letter-spacing: 0.08em;
	}

	.bd-unlock-title {
		font-size: 1.15rem;
		font-weight: 800;
		color: var(--bd-text-primary);
		margin: 0;
	}

	.bd-unlock-desc {
		font-size: 0.84rem;
		line-height: 1.5;
		color: var(--bd-text-secondary);
		margin: 0;
	}

	@media (max-width: 680px) {
		.bd-hack-unlock-banner {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}

	.bd-hack-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 860px) {
		.bd-hack-grid {
			grid-template-columns: 1fr;
		}
	}

	.bd-hack-card {
		background: rgba(26, 23, 40, 0.75);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		transition: all 0.25s ease;
	}

	:root:not(.dark) .bd-hack-card {
		background: #ffffff;
		border-color: rgba(0, 0, 0, 0.08);
	}

	.bd-hack-card:hover {
		transform: translateY(-3px);
		border-color: rgba(var(--hack-rgb), 0.45);
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35), 0 0 20px rgba(var(--hack-rgb), 0.15);
	}

	.bd-hack-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.bd-hack-icon-box {
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: rgba(var(--hack-rgb), 0.14);
		color: var(--hack-accent);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bd-hack-tags {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.2rem;
	}

	.bd-hack-tag {
		font-size: 0.65rem;
		font-weight: 800;
		color: var(--hack-accent);
	}

	.bd-hack-code {
		font-family: 'Space Grotesk', monospace;
		font-size: 0.6rem;
		color: var(--bd-text-secondary);
		opacity: 0.75;
	}

	.bd-hack-card-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--bd-text-primary);
		margin-bottom: 0.4rem;
	}

	.bd-hack-card-desc {
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--bd-text-secondary);
		margin-bottom: 1.25rem;
	}

	.bd-hack-card-footer {
		margin-top: auto;
	}

	.bd-hack-state-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.68rem;
		font-weight: 700;
		color: var(--bd-text-secondary);
		background: rgba(255, 255, 255, 0.04);
		padding: 0.25rem 0.6rem;
		border-radius: 6px;
	}

	.bd-hack-notice-strip {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background: rgba(var(--bd-tertiary-rgb), 0.08);
		border: 1px dashed rgba(var(--bd-tertiary-rgb), 0.3);
		border-radius: 14px;
		padding: 0.85rem 1.25rem;
	}

	.bd-notice-icon {
		color: var(--bd-tertiary);
		font-size: 1.25rem;
		flex-shrink: 0;
	}

	.bd-notice-text {
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--bd-text-primary);
		margin: 0;
	}

	/* ── CTA Puente Compacto ── */
	.bd-memorias-cta-compact {
		position: relative;
		border-radius: 20px;
		padding: 1.75rem 2rem;
		background: linear-gradient(135deg, rgba(32, 28, 52, 0.8), rgba(18, 16, 32, 0.95));
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.25);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
	}

	:root:not(.dark) .bd-memorias-cta-compact {
		background: linear-gradient(135deg, #ffffff, #f1f5f9);
		border-color: rgba(77, 124, 15, 0.3);
	}

	.bd-cta-compact-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	@media (max-width: 860px) {
		.bd-cta-compact-inner {
			flex-direction: column;
			text-align: center;
			gap: 1.25rem;
		}
	}

	.bd-cta-compact-info {
		max-width: 720px;
	}

	.bd-cta-compact-chip {
		margin-bottom: 0.5rem;
		font-size: 0.65rem;
	}

	.bd-cta-compact-title {
		font-size: clamp(1.2rem, 2.2vw, 1.45rem);
		font-weight: 800;
		color: var(--bd-text-primary);
		margin-bottom: 0.35rem;
	}

	.bd-cta-compact-desc {
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--bd-text-secondary);
		margin: 0;
	}

	.bd-cta-compact-action {
		flex-shrink: 0;
	}

	.bd-cta-btn {
		font-size: 0.88rem;
		padding: 0.75rem 1.6rem;
		gap: 0.5rem;
		display: inline-flex;
		align-items: center;
	}

	/* ── Lightbox Modal ── */
	.bd-lightbox-dialog {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		padding: 0;
		margin: 0;
		background: transparent;
		border: none;
		display: none;
		align-items: center;
		justify-content: center;
		z-index: 2000;
	}

	.bd-lightbox-dialog[open] {
		display: flex;
	}

	.bd-lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(10, 8, 18, 0.88);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.bd-lightbox-content {
		position: relative;
		z-index: 1;
		width: 90%;
		max-width: 840px;
		max-height: 90vh;
		background: rgba(28, 25, 42, 0.96);
		border: 1px solid rgba(var(--bd-tertiary-rgb), 0.35);
		border-radius: 22px;
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		animation: bd-panel-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	:root:not(.dark) .bd-lightbox-content {
		background: #ffffff;
		border-color: rgba(0, 0, 0, 0.15);
	}

	.bd-lightbox-close {
		position: absolute;
		top: 1rem;
