---
import { Image } from 'astro:assets';
import logo from '../../assets/cbs_logo.png';
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
	{ name: t('nav.events'), icon: 'event', href: getLocalePath(lang, 'events') },
	{ name: t('nav.team'), icon: 'people', href: getLocalePath(lang, 'team') },
	{ name: t('nav.partners'), icon: 'handshake', href: getLocalePath(lang, 'partners') },
];
---

<nav class="bottom-nav">
	<div class="dock-container glass">
		<!-- Branding Anchor (Home) -->
		<a href={getLocalePath(lang)} class="dock-branding">
			<div class="logo-wrapper">
				<Image src={logo} alt="CBS Logo" width={32} height={32} class="logo-img" />
			</div>
			<div class="branding-text">
				<span class="brand-name">CBS-<span class="highlight">UNMSM</span></span>
				<span class="brand-tag">{t('nav.brand.tag')}</span>
			</div>
		</a>

		<div class="divider"></div>

		<!-- Nav Items -->
		{navLinks.map(link => {
			const isExternal = link.href.startsWith('http');
			const isEvents = link.icon === 'event';
			return (
				<a 
					href={link.href} 
					class={`dock-item ${isEvents ? 'has-badge' : ''}`}
					target={isExternal ? "_blank" : undefined}
					rel={isExternal ? "noopener noreferrer" : undefined}
				>
					{isEvents && (
						<span 
							class="biodesign-nav-badge" 
							title="BioDesign Bootcamp"
							role="button"
							tabindex="0"
							onclick={`event.stopPropagation(); window.location.href='${getLocalePath(lang, 'events/biodesign')}';`}
						>
							<img src={`${base}/Biodesign/logo_biodesign_mm.png`} alt="BioDesign" width="16" height="16" class="badge-logo" />
							<span class="badge-pulse-ring"></span>
						</span>
					)}
					<span class="material-icons">{link.icon}</span>
					<span class="label">{link.name}</span>
					<div class="active-indicator"></div>
					{isExternal && <span class="external-indicator material-icons">north_east</span>}
				</a>
			);
		})}
	</div>
</nav>

<style>
	.bottom-nav {
		position: fixed;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1000;
		width: auto;
		max-width: 95%;
		padding: 0 1rem;
	}

	.dock-container {
		display: flex;
		align-items: center;
		padding: 0.6rem 1rem;
		border-radius: 24px;
		gap: 1rem;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.dock-branding {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1rem 0.5rem 0.5rem;
		border-radius: 16px;
		background: linear-gradient(135deg, rgba(21, 79, 155, 0.1), rgba(23, 158, 117, 0.1));
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.dock-branding:hover {
		background: rgba(255, 255, 255, 0.08);
		transform: translateY(-2px);
	}

	.logo-wrapper {
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		filter: drop-shadow(0 0 8px var(--accent-glow));
	}

	.branding-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.brand-name {
		font-weight: 900;
		font-size: 0.9rem;
		letter-spacing: -0.02em;
	}

	.brand-name .highlight {
		color: var(--accent-cyan);
	}

	.brand-tag {
		font-size: 0.55rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		opacity: 0.5;
		margin-top: 2px;
	}

	.divider {
		width: 1px;
		height: 30px;
		background: rgba(255, 255, 255, 0.1);
		margin: 0 0.5rem;
	}

	.dock-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-width: 65px;
		height: 55px;
		border-radius: 12px;
		position: relative;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		opacity: 0.6;
	}

	.dock-item:hover {
		opacity: 1;
		transform: translateY(-5px);
		background: rgba(255, 255, 255, 0.05);
	}

	.dock-item .material-icons {
		font-size: 1.3rem;
		margin-bottom: 2px;
	}

	.dock-item:hover .material-icons {
		color: var(--accent-cyan);
	}

	.label {
		font-size: 0.6rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.active-indicator {
		position: absolute;
		bottom: 0px;
		left: 20%;
		width: 60%;
		height: 2px;
		background: var(--accent-cyan);
		transform: scaleX(0);
		transition: transform 0.3s;
		box-shadow: 0 0 10px var(--accent-glow);
	}

	.external-indicator {
		position: absolute;
		top: 5px;
		right: 5px;
		font-size: 0.6rem !important;
		opacity: 0.4;
	}

	.dock-item:hover .active-indicator {
		transform: scaleX(1);
	}

	.dock-item:hover .external-indicator {
		opacity: 1;
		color: var(--accent-cyan);
	}

	/* BioDesign Floating Nav Badge */
	.biodesign-nav-badge {
		position: absolute;
		top: -14px;
		right: -2px;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: #131120;
		border: 2px solid #79f8d0;
		box-shadow: 0 0 12px rgba(121, 248, 208, 0.7);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 10;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		animation: bd-badge-float 3s ease-in-out infinite;
	}

	.biodesign-nav-badge:hover {
		transform: scale(1.25) translateY(-3px);
		box-shadow: 0 0 20px rgba(121, 248, 208, 0.9), 0 0 35px rgba(187, 243, 95, 0.5);
		border-color: #bbf35f;
	}

	.badge-logo {
		width: 22px;
		height: 22px;
		object-fit: contain;
		border-radius: 50%;
	}

	.badge-pulse-ring {
		position: absolute;
		inset: -3px;
		border-radius: 50%;
		border: 1px solid #79f8d0;
		opacity: 0.8;
		animation: bd-badge-pulse 2.5s cubic-bezier(0, 0, 0.2, 1) infinite;
		pointer-events: none;
	}

	@keyframes bd-badge-pulse {
		0% {
			transform: scale(0.9);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	@keyframes bd-badge-float {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-3px);
		}
	}

	@media (max-width: 768px) {
		.branding-text, .divider {
			display: none;
		}
		.dock-branding {
			padding: 0.5rem;
		}
		.dock-container {
			gap: 0.25rem;
			padding: 0.4rem 0.6rem;
		}
		.label {
			display: none;
		}
		.dock-item {
			min-width: 45px;
			height: 48px;
		}
		.dock-item .material-icons {
			font-size: 1.2rem;
		}
		.biodesign-nav-badge {
			top: -12px;
			right: -2px;
			width: 26px;
			height: 26px;
		}
		.badge-logo {
			width: 18px;
			height: 18px;
		}
	}
</style>
