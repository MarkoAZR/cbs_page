<button id="theme-toggle" class="theme-toggle FAB glass" aria-label="Cambiar tema">
    <span class="material-icons sun-icon">light_mode</span>
    <span class="material-icons moon-icon">dark_mode</span>
</button>

<script is:inline>
    function setupThemeToggle() {
        const handleToggleClick = () => {
            const element = document.documentElement;
            element.classList.toggle("dark");

            const isDark = element.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        }

        const button = document.getElementById("theme-toggle");
        if (button) {
            button.removeEventListener("click", handleToggleClick);
            button.addEventListener("click", handleToggleClick);
        }
    }

    // Inicializar en carga y tras transiciones de ViewTransitions
    setupThemeToggle();
    document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

<style>
    .theme-toggle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .theme-toggle:hover {
        transform: scale(1.1) rotate(15deg);
        box-shadow: 0 0 20px var(--accent-glow);
        background: var(--cbs-blue-corp);
        color: white;
    }

    .sun-icon { display: none; }
    .moon-icon { display: block; }

    :global(.dark) .sun-icon { display: block; }
    :global(.dark) .moon-icon { display: none; }

    @media (max-width: 600px) {
        .theme-toggle {
            width: 45px;
            height: 45px;
        }
    }
</style>
