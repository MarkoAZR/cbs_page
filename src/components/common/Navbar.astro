---
import { Image } from 'astro:assets';
import logo from '../../assets/cbs_logo.png';

const base = import.meta.env.BASE_URL;

const navLinks = [
	{ name: 'Inicio', href: `${base}/` },
	{ name: 'Artículos', href: `${base}/articles` },
	{ name: 'Eventos', href: `${base}/events` },
	{ name: 'Equipo', href: `${base}/team` },
	{ name: 'Proyectos', href: 'https://github.com/cbs-unmsm', external: true },
];
---

<nav class="glass nav-header animate-in">
	<div class="container nav-content">
		<a href={`${base}/`} class="logo-link">
			<Image 
				src={logo} 
				alt="Logo CBS-UNMSM" 
				width={60} 
				height={60} 
				format="webp"
				quality="mid"
				class="logo-img" 
			/>
			<div class="logo-text">
				CBS<span>-UNMSM</span>
			</div>
		</a>
		<ul class="nav-links">
			{navLinks.map(link => (
				<li>
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : ""}
					>
						{link.name}
						{link.external && <span class="external-icon">↗</span>}
					</a>
				</li>
			))}
		</ul>
	</div>
</nav>

<style>
	.nav-header {
		position: sticky;
		top: 1rem;
		margin: 1rem auto;
		width: calc(100% - 2rem);
		z-index: 100;
		padding: 0.6rem 0;
	}
	.nav-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
	}
	.logo-img {
		width: 45px;
		height: 45px;
		object-fit: contain;
		filter: drop-shadow(0 0 8px var(--accent-glow));
	}
	.logo-text {
		font-weight: 800;
		font-size: 1.4rem;
		color: var(--text-color);
		letter-spacing: -0.01em;
	}
	.logo-text span {
		color: var(--accent-purple);
	}
	.nav-links {
		display: flex;
		list-style: none;
		gap: 2.5rem;
	}
	.nav-links a {
		color: var(--text-color);
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s;
		opacity: 0.8;
	}
	.nav-links a:hover {
		color: var(--accent-cyan);
		opacity: 1;
		text-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
	}
	.external-icon {
		font-size: 0.7rem;
		margin-left: 0.3rem;
		vertical-align: super;
		opacity: 0.6;
	}

	@media (max-width: 600px) {
		.logo-text { font-size: 1.1rem; }
		.logo-img { width: 35px; height: 35px; }
		.nav-links { gap: 1rem; }
	}
</style>
