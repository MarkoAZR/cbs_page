---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const events = await getCollection('events');
events.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
---

<Layout title="Próximos Eventos" description="Participa en nuestras charlas, talleres y conferencias sobre Biología Sintética.">
	<div class="container page-content">
		<header class="page-header animate-in">
			<span class="pinyon decorative-text">Scientific Agenda</span>
			<h1>Próximos <span class="gradient-text">Eventos</span></h1>
			<p>Únete a la conversación científica. Talleres, charlas y más.</p>
		</header>

		<div class="events-grid animate-in" style="animation-delay: 0.2s">
			{events.map((event, index) => (
				<a href={`${base}/events/${event.slug}`} class={`event-card glass ${index === 0 ? 'large' : ''}`}>
					<div class="card-header">
						<span class="date">{event.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
						<span class="type-pill">{event.data.type}</span>
					</div>
					
					<div class="card-body">
						<h3>{event.data.title}</h3>
						<p>{event.data.description}</p>
					</div>

					<div class="card-footer">
						<div class="location">
							<span class="material-icons">place</span>
							<span>{event.data.location}</span>
						</div>
						<div class="arrow">
							<span class="material-icons">east</span>
						</div>
					</div>
				</a>
			))}
		</div>
	</div>
</Layout>

<style>
	.page-content {
		padding-bottom: 8rem;
	}

	.page-header {
		padding: 8rem 0 4rem;
		text-align: center;
	}

	.decorative-text {
		display: block;
		font-size: 2.2rem;
		color: var(--accent-yellow);
		margin-bottom: -0.5rem;
		opacity: 0.8;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		line-height: 1;
		margin-bottom: 1.5rem;
		font-weight: 800;
	}

	.page-header p {
		font-size: 1.25rem;
		opacity: 0.7;
		max-width: 600px;
		margin: 0 auto;
	}

	.events-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		grid-auto-rows: minmax(350px, auto);
		gap: 1.5rem;
	}

	.event-card {
		padding: 2.5rem;
		border-radius: 28px;
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		border: 1px solid var(--border-color);
	}

	.event-card:hover {
		transform: translateY(-8px) scale(1.02);
		border-color: var(--accent-purple);
		background: rgba(var(--accent-purple-rgb), 0.05);
	}

	.event-card.large {
		grid-column: span 2;
		grid-row: span 1;
		background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.1), transparent);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
	}

	.date {
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--accent-cyan);
		font-variant-numeric: tabular-nums;
	}

	.type-pill {
		font-size: 0.65rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.3rem 0.8rem;
		border-radius: 100px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		opacity: 0.8;
	}

	.card-body h3 {
		font-size: 1.8rem;
		line-height: 1.2;
		margin-bottom: 1rem;
		color: var(--text-color);
		font-weight: 800;
	}

	.event-card.large h3 {
		font-size: 2.5rem;
	}

	.card-body p {
		font-size: 1rem;
		line-height: 1.6;
		opacity: 0.7;
		margin-bottom: 2rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-footer {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.location {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.6;
	}

	.location .material-icons {
		font-size: 1.1rem;
		color: var(--accent-cyan);
	}

	.arrow {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: rgba(var(--accent-cyan-rgb), 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent-cyan);
		transition: all 0.3s;
	}

	.event-card:hover .arrow {
		background: var(--accent-cyan);
		color: #fff;
		transform: translateX(5px);
	}

	@media (max-width: 900px) {
		.event-card.large {
			grid-column: span 1;
		}
		.event-card.large h3 {
			font-size: 1.8rem;
		}
	}

	@media (max-width: 600px) {
		.events-grid {
			grid-template-columns: 1fr;
		}
		.event-card {
			padding: 1.5rem;
		}
	}
</style>
