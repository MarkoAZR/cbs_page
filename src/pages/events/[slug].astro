---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('events');
	return entries.map(entry => ({
		params: { slug: entry.slug }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
	<article class="event-detail animate-in">
		<a href={`${import.meta.env.BASE_URL}/events`} class="back-link">← Volver a eventos</a>
		
		<header class="detail-header">
			<div class="meta-top">
				<span class="type-badge">{entry.data.type}</span>
				<time>{entry.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
			</div>
			<h1>{entry.data.title}</h1>
			<p class="location-info">📍 {entry.data.location}</p>
		</header>

		<div class="content glass">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.event-detail {
		padding: 4rem 0;
		max-width: 800px;
		margin: 0 auto;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 0.9rem;
		opacity: 0.6;
	}
	.back-link:hover {
		opacity: 1;
		color: var(--accent-cyan);
	}
	.detail-header {
		margin-bottom: 3rem;
	}
	.meta-top {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1rem;
	}
	.type-badge {
		background: var(--accent-purple);
		color: #fff;
		padding: 0.2rem 0.8rem;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	time {
		font-size: 0.9rem;
		opacity: 0.8;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.1;
		margin-bottom: 0.5rem;
	}
	.location-info {
		font-size: 1.1rem;
		opacity: 0.7;
	}
	.content {
		padding: 3rem;
		line-height: 1.8;
	}
	.content :global(h2) {
		margin: 2rem 0 1rem;
		color: var(--accent-purple);
	}
	.content :global(ul) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}
	.content :global(li) {
		margin-bottom: 0.5rem;
	}
	.content :global(strong) {
		color: var(--accent-cyan);
	}
</style>
