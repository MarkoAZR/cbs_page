---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const articles = await getCollection('articles', ({ data }) => {
	return data.isDraft === false;
});
articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Artículos de Divulgación">
	<header class="page-header animate-in">
		<h1>Archivo <span class="gradient-text">Científico</span></h1>
		<p>Explora nuestras publicaciones y análisis académicos de vanguardia.</p>
	</header>

	<section class="articles-grid animate-in" style="animation-delay: 0.2s">
		{articles.map(article => (
			<article class="article-card glass">
				<div class="content">
					<div class="meta">
						<span class="date">{article.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
						<span class="author">Por {article.data.author}</span>
					</div>
					<h3>{article.data.title}</h3>
					<p>{article.data.description}</p>
					<div class="tags">
						{article.data.tags.map(tag => <span class="tag">#{tag}</span>)}
					</div>
					<a href={`${import.meta.env.BASE_URL}/articles/${article.slug}`} class="read-more">Leer artículo completo →</a>
				</div>
			</article>
		))}
	</section>
</Layout>

<style>
	.page-header {
		padding: 6rem 0 3rem;
		text-align: center;
	}
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2.5rem;
		margin-bottom: 4rem;
	}
	.article-card {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		height: 100%;
		transition: all 0.3s ease;
	}
	.article-card:hover {
		transform: translateY(-5px) scale(1.01);
		border-color: var(--accent-purple);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		opacity: 0.7;
		margin-bottom: 1rem;
		color: var(--accent-cyan);
	}
	h3 {
		font-size: 1.6rem;
		color: var(--accent-yellow);
		margin-bottom: 1rem;
		line-height: 1.3;
	}
	p {
		font-size: 0.95rem;
		opacity: 0.8;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.tag {
		font-size: 0.75rem;
		background: rgba(123, 47, 247, 0.1);
		color: var(--accent-purple);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-weight: 600;
	}
	.read-more {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--accent-cyan);
		text-decoration: none;
		transition: opacity 0.2s;
	}
	.read-more:hover {
		text-decoration: underline;
		opacity: 0.8;
	}
</style>
